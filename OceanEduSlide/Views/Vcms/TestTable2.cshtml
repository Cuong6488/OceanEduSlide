@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>

    #groupWrapper {
        display: flex;
        gap: 0; /* loại bỏ khoảng giữa */
        border: 1px solid #ccc;
        border-radius: 6px;
        overflow: hidden;
    }

    .columnGroup {
        flex-grow: 1;
        margin-right: -1px; /* để border không bị dày lên */
    }

        .columnGroup table {
            width: 100%;
            border-collapse: collapse;
            border-spacing: 0;
            font-family: "Segoe UI", sans-serif;
            border: none;
        }

        .columnGroup th,
        .columnGroup td {
            border: 1px solid #ccc;
            padding: 6px;
            text-align: center;
        }

        .columnGroup thead th {
            background-color: #f0f4ff;
            font-weight: bold;
        }

        .columnGroup:hover {
            box-shadow: inset 0 0 4px rgba(0,0,0,0.1);
        }
</style>
<h2>Báo cáo theo nhóm cột – Giao diện như một bảng</h2>

