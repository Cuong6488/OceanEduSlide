@model OceanEduSlide.ViewModels.UpdateUserViewModel
@{
    ViewBag.Title = "Update User";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    //int id = ViewBag.id;
}
<link href="~/Content/select2.min.css" rel="stylesheet" />
<div class="box_content px-300 mt-4">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)
        <table class="form_table">
            <tbody>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Users.FirstOrDefault().Username)</td>
                    <td class="form_text">
                        @*<input autocomplete="off" type="type" name="name" value="" />*@
                        @Html.TextBoxFor(model => model.Users.FirstOrDefault().Username, new { @class = "form_control w300", @readonly = "readonly" })
                        @Html.ValidationMessageFor(model => model.Username)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Password)</td>
                    <td class="form_text">
                        @Html.PasswordFor(model => model.Password, new { @class = "form_control w300", autocomplete = "new-password" })
                        @Html.ValidationMessageFor(model => model.Password)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.ConfirmPassword)</td>
                    <td class="form_text">
                        @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form_control w300" })
                        @Html.ValidationMessageFor(model => model.ConfirmPassword)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.MaNhanVien)</td>
                    <td class="form_text">
                        @*<input autocomplete="off" type="type" name="name" value="" />*@
                        @Html.TextBoxFor(model => model.Users.FirstOrDefault().MaNhanVien, new { @class = "form_control w300", @readonly = "readonly" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Users.FirstOrDefault().Fullname)</td>
                    <td class="form_text">
                        @*<input autocomplete="off" type="type" name="name" value="" />*@
                        @Html.TextBoxFor(model => model.Users.FirstOrDefault().Fullname, new { @class = "form_control w300" })
                        @Html.ValidationMessageFor(model => model.Fullname)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.ZoneId)</td>
                    <td class="form_text">
                        @Html.DropDownListFor(model => model.ZoneId, Model.SelectZones, "Chọn vùng", new { @class = "mb-2", data_item = "zone" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.ZoneIds)</td>
                    <td class="form_text">
                        <select name="CatIDs2" id="categorySelect2" class="form_control" multiple style="height: 200px;">
                            @foreach (var item in Model.Zones)
                            {
                                <option value="@item.ShortCode" @(Model.ZoneIds != null && Model.ZoneIds.Split(',').Contains(item.ShortCode) ? "selected" : "")>
                                    @item.Name
                                </option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.OfficeId)</td>
                    <td class="form_text">
                        @Html.DropDownListFor(model => model.Users.FirstOrDefault().OfficeId, Model.SelectOffices, "Chọn chi nhánh", new { @class = "mb-2", data_item = "office" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.OfficeIds)</td>
                    <td class="form_text">
                        <select name="CatIDs" id="categorySelect" class="form_control" multiple style="height: 200px;">
                            @foreach (var item in Model.Offices)
                            {
                                <option value="@item.Id" @(Model.OfficeIds != null && Model.OfficeIds.Split(',').Contains(item.Id.ToString()) ? "selected" : "")>
                                    @item.Name
                                </option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.TypeUser)</td>
                    <td class="form_text">
                        @Html.EnumDropDownListFor(model => model.TypeUser, "Chọn phân quyền")
                        @Html.ValidationMessageFor(model => model.TypeUser)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.CDCM)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.CDCM, "Nhập CDCM")
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Users.FirstOrDefault().SaleKit)</td>
                    <td class="form_text">
                        @Html.CheckBoxFor(model => model.Users.FirstOrDefault().SaleKit)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Users.FirstOrDefault().Active)</td>
                    <td class="form_text">
                        @Html.CheckBoxFor(model => model.Users.FirstOrDefault().Active)
                    </td>
                </tr>
                <tr>
                    <td class="form_name"></td>
                    <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Cập nhật"></td>
                </tr>
            </tbody>
        </table>
    }
</div>
@section Scripts {
    <script src="~/Scripts/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#categorySelect').select2({
                placeholder: 'Chọn các chi nhánh',
                allowClear: true,
                multiple: true
            });
            $('#categorySelect2').select2({
                placeholder: 'Chọn các vùng quản lý',
                allowClear: true,
                multiple: true
            });


        });
    </script>
}