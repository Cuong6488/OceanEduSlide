@model OceanEduSlide.Models.MapTypeUser
@{
    ViewBag.Title = "Sửa CDCM";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link href="~/Content/select2.min.css" rel="stylesheet" />
<h2 class="mb-5 mt-0">@ViewBag.Title</h2>
<a class="btn quick-link" href="@Url.Action("ListMapTypeUser","Vcms")"><i class="far fa-list me-1"></i> Danh sách CDCM</a>
<div class="box_content px-300">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)
        @Html.HiddenFor(a => a.Id)
        <table class="form_table">
            <tbody>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.CDCM)</td>
                    <td class="form_text">
                        @Html.TextBoxFor(model => model.CDCM, new { @class = "form_control w300", required = "required" })
                        @Html.ValidationMessageFor(model => model.CDCM)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.TypeUser)</td>
                    <td class="form_text">
                        @Html.EnumDropDownListFor(model => model.TypeUser, "Chọn phân quyền")
                        @Html.ValidationMessageFor(model => model.TypeUser)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Sort)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.Sort)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Active)</td>
                    <td class="form_text">
                        @Html.CheckBoxFor(model => model.Active)
                    </td>
                </tr>
                <tr>
                    <td class="form_name"></td>
                    <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Update CDCM"></td>
                </tr>
            </tbody>
        </table>
    }
</div>
