@model OceanEduSlide.ViewModels.CreateZoneViewModel
@{
    ViewBag.Title = "Update Zone";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link href="~/Content/select2.min.css" rel="stylesheet" />
<h2 class="mb-5 mt-0">Cập nhật Zone</h2>
@*<a class="btn quick-link" href="@Url.Action("CreateZone","Vcms")"><i class="far fa-list me-1"></i> Danh sách quản trị viên</a>*@
<div class="box_content px-300 mb-5">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)
        @Html.HiddenFor(a => a.Zone.Id)
        <table class="form_table">
            <tbody>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Zone.Name)</td>
                    <td class="form_text">
                        @*<input autocomplete="off" type="type" name="name" value="" />*@
                        @Html.EditorFor(model => model.Zone.Name, new { @class = "form_control w300" })
                        @Html.ValidationMessageFor(model => model.Zone.Name)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Zone.OfficeIds)</td>
                    <td class="form_text">
                        @*<select name="CatIDs" id="categorySelect" class="form_control" multiple="" style=" height: 200px;">
                                @foreach (var item in Model.Offices)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }

                            </select>*@
                        <select name="CatIDs" id="categorySelect" class="form_control" multiple style="height: 200px;">
                            @foreach (var item in Model.Offices)
                            {
                                <option value="@item.Id" @(Model.Zone.OfficeIds != null && Model.Zone.OfficeIds.Split(',').Contains(item.Id.ToString()) ? "selected" : "")>
                                    @item.Name
                                </option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Zone.Sort)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.Zone.Sort)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Zone.Active)</td>
                    <td class="form_text">
                        @Html.CheckBoxFor(model => model.Zone.Active, new { @checked = "checked" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name"></td>
                    <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Cập nhật Zone"></td>
                </tr>
            </tbody>
        </table>
    }
</div>
<h2 class="mb-5">Danh sách Zone</h2>
@Html.Action("ListZone", "Vcms")
@section Scripts {
    <script src="~/Scripts/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#categorySelect').select2({
                placeholder: 'Chọn các chi nhánh',
                allowClear: true,
                multiple: true
            });


        });
        function deleteZone(id) {
            if (confirm("Bạn có chắc chắn xóa vùng này không?")) {
                $.post("/Vcms/DeleteZone",
                    { zoneId: id },
                    function (data) {
                        if (data === "True") {
                            $.toast({
                                text: 'Xóa thành công',
                                position: 'bottom-right',
                                icon: 'success',
                            })
                            $("tr[data-id='" + id + "']").fadeOut();
                        } else {
                            $.toast({
                                text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                                icon: 'error',
                            })
                        }
                    });
            }
        }
    </script>
}