@model IEnumerable<OceanEduSlide.Models.MemberCredential>
@using PagedList.Mvc
@{
    ViewBag.Title = "Danh sách FaceId";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">Danh sách khóa bảo mật</h2>
@if (ViewBag.Result == "success")
{
    <div id="AlertBox" class="alert alert-success"><strong>Thêm mới tài khoản thành công</strong></div>
}
@if (ViewBag.Result == "update")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật tài khoản thành công</strong></div>
}
<a class="btn quick-link" href="@Url.Action("CreateFaceId")"><i class="fal fa-plus-circle me-1"></i>Thêm khóa bảo mật</a>
<div class="box_content">
    <p>Có tổng số <strong>@Model.Count()</strong> khóa bảo mật</p>
    <table class="list_table tablecenter table-striped">
        <tbody>
            <tr>
                <th style="width: 60px;">Ngày tạo</th>
                <th>Thiết bị</th>
                <th>Nền tảng</th>
                <th style="width: 130px"></th>
            </tr>
            @foreach (var credential in Model)
            {
                <tr>
                    <td>@credential.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@credential.DeviceName</td>
                    <td>@credential.Platform</td>
                    @*<td>@credential.SignatureCounter</td>*@
                    <td><button type="button" onclick="removeFaceId('@credential.CredentialId')" class="btn btn-sm btn-danger"><i class="fal fa-times"></i></button></td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section scripts
{
    <script type="text/javascript">
        function deleteFaceId(id) {
            if (confirm("Bạn có chắc chắn xóa tài khoản này không?")) {
                $.post("/Vcms/DeleteFaceId",
                    { faceIdId: id },
                    function (data) {
                        if (data.status === "True") {
                            $.toast({
                                text: 'Xóa tài khoản thành công',
                                position: 'bottom-right',
                                icon: 'success',
                            })
                            $("tr[data-id='" + id + "']").fadeOut();
                        } else {
                            $.toast({
                                text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                                icon: 'error',
                            })
                        }
                    });
            }
        }

        function updateInfo(id) {
            const elm = $('tr[data-id="' + id + '"]');
            const sort = elm.find("#faceId_Sort").val();
            const active = elm.find("input#faceId_Active").prop("checked");
            $.post("/Vcms/QuickUpdateFaceId",
                { faceIdId: id, sort, active },
                function (data) {
                    if (data) {
                        $.toast({
                            text: 'Cập nhật thành công',
                            position: 'bottom-right',
                            icon: 'success'
                        });
                    } else {
                        $.toast({
                            text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                            position: 'bottom-right',
                            icon: 'error'
                        });
                        window.location.reload();
                    };
                });
        }
        async function checkBeforeRegister(faceIdId, faceIdname) {
            const supported = await isPlatformAuthenticatorAvailable();

            if (!supported) {
                alert("Thiết bị của bạn không hỗ trợ FaceID / TouchID / Passkey. Vui lòng sử dụng mật khẩu đăng nhập.");
                return;
            }

            // Nếu có hỗ trợ ➔ tiến hành đăng ký FaceID
            registerFaceId(faceIdId, faceIdname);
        }

        async function registerFaceId(faceIdId, faceIdname) {
            const resp = await fetch(`/FaceId/BeginRegistration?faceIdId=${faceIdId}&faceIdname=${faceIdname}`);
            const data = await resp.json();
            const publicKey = preformatMakeCredReq(data);
            //debugPublicKeyOptions(publicKey);
            const cred = await navigator.credentials.create({ publicKey });
            const response = formatMakeCredResp(cred);
            const rs = await fetch(`/FaceId/CompleteRegistration?faceIdId=${faceIdId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(response)
            });
            const rsData = await rs.json();
            if (rsData.status === "ok") {
                alert("Đăng ký FaceID thành công!");
                window.location.reload();
            } else {
                alert("Đăng ký FaceID thất bại!");
            }
        }

        function removeFaceId(credentialId) {
            if (confirm("Bạn có chắc chắn xóa FaceId này?")) {
                $.post("/FaceId/RemoveFaceId", { credentialId: credentialId }, function (data) {
                    if (data.status === "ok") {
                        alert("Xóa FaceId thành công!");
                        window.location.reload();
                    } else {
                        alert("Xóa FaceId thất bại!");
                    }
                });
            }
        }
    </script>
}