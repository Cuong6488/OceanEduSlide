@model OceanEduSlide.ViewModels.ListUserViewModel
@using PagedList.Mvc
@{
    ViewBag.Title = "Danh sách tài khoản";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">Danh sách tài khoản</h2>
@if (ViewBag.Result == "success")
{
    <div id="AlertBox" class="alert alert-success"><strong>Thêm mới tài khoản thành công</strong></div>
}
@if (ViewBag.Result == "update")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật tài khoản thành công</strong></div>
}
<a class="btn quick-link" href="@Url.Action("CreateUser")"><i class="fal fa-plus-circle me-1"></i>Thêm tài khoản</a>
<div class="box_content">
    <form action="@Url.Action("ListUser")" method="get">
        <div class="row">
            @*<div class="col-lg-4">
                    <label>Tỉnh thành</label> @Html.DropDownListFor(model => model.cityId, Model.SelectCities, "Tất cả tài khoản", new { @class = "mt-2" })
                </div>*@
            <div class="col-lg-4">
                <label>Từ khóa</label> @Html.TextBoxFor(a => a.Username, new { @class = "w300 mt-2" })
            </div>
            <div class="col-lg-4 align-self-center">
                <button type="submit" class="btn-search mt-2">Tìm kiếm</button>
            </div>
        </div>
    </form>
    <p>Có tổng số <strong>@Model.Users.TotalItemCount</strong> tài khoản</p>
    <table class="list_table tablecenter table-striped">
        <tbody>
            <tr>
                @*<th style="width: 80px">Thứ tự</th>*@
                <th>Tên đăng nhập</th>
                <th>Chi nhánh</th>
                @*<th style="width:150px">Tỉnh thành</th>*@

                <th style="width:100px">Hoạt động</th>
                <th style="width: 130px"></th>
            </tr>
            @foreach (var user in Model.Users)
            {
                <tr data-id="@user.Id">
                    @*<td>@Html.EditorFor(model => user.Sort)</td>*@
                    <td class="left">
                        <a href="@Url.Action("UpdateUser", new { userId = user.Id })">@user.Username</a>
                    </td>
                    @*<td>@user.City.Name</td>*@
                    <td>@user.Office.Name</td>
                    <td>@Html.CheckBoxFor(model => user.Active)</td>
                    <td>
                        <a href="javascript:;" onclick="updateInfo('@user.Id')">Cập nhật</a> -
                        @Html.ActionLink("Sửa", "UpdateUser", new { id = user.Id }) -
                        <a href="javascript:;" onclick="deleteUser('@user.Id')" style="color: red;">Xóa</a>
                    </td>
                </tr>
            }
            @if (Model.Users.PageCount > 1)
            {
                <tr>
                    <td colspan="5">@Html.PagedListPager(Model.Users, page => Url.Action("ListUser", new { page, officeId = Model.officeId, username = Model.Users }))</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section scripts
{
    <script type="text/javascript">
        function deleteUser(id) {
            if (confirm("Bạn có chắc chắn xóa tài khoản này không?")) {
                $.post("/Vcms/DeleteUser",
                    { userId: id },
                    function (data) {
                        if (data.status === "True") {
                            $.toast({
                                text: 'Xóa tài khoản thành công',
                                position: 'bottom-right',
                                icon: 'success',
                            })
                            $("tr[data-id='" + id + "']").fadeOut();
                        } else {
                            $.toast({
                                text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                                icon: 'error',
                            })
                        }
                    });
            }
        }

        function updateInfo(id) {
            const elm = $('tr[data-id="' + id + '"]');
            const sort = elm.find("#user_Sort").val();
            const active = elm.find("input#user_Active").prop("checked");
            $.post("/Vcms/QuickUpdateUser",
                { userId: id, sort, active },
                function (data) {
                    if (data) {
                        $.toast({
                            text: 'Cập nhật thành công',
                            position: 'bottom-right',
                            icon: 'success'
                        });
                    } else {
                        $.toast({
                            text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                            position: 'bottom-right',
                            icon: 'error'
                        });
                        window.location.reload();
                    };
                });
        }
    </script>
}