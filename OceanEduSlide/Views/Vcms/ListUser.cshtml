@model OceanEduSlide.ViewModels.ListUserViewModel
@using PagedList.Mvc
@{
    ViewBag.Title = "Danh sách tài khoản";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">Danh sách tài khoản</h2>
@if (ViewBag.Result == "success")
{
    <div id="AlertBox" class="alert alert-success"><strong>Thêm mới tài khoản thành công</strong></div>
}
@if (ViewBag.Result == "update")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật tài khoản thành công</strong></div>
}
<a class="btn quick-link" href="@Url.Action("CreateUser")"><i class="fal fa-plus-circle me-1"></i>Thêm tài khoản</a>
<div class="box_content">
    <form action="@Url.Action("ListUser")" method="get">
        <div class="row">
            @*<div class="col-lg-4">
                    <label>Tỉnh thành</label> @Html.DropDownListFor(model => model.cityId, Model.SelectCities, "Tất cả tài khoản", new { @class = "mt-2" })
                </div>*@
            <div class="col-lg-4">
                <label>Từ khóa</label> @Html.TextBoxFor(a => a.Username, new { @class = "w300 mt-2" })
            </div>
            <div class="col-lg-4 align-self-center">
                <button type="submit" class="btn-search mt-2">Tìm kiếm</button>
            </div>
        </div>
    </form>
    <p>Có tổng số <strong>@Model.Users.TotalItemCount</strong> tài khoản</p>
    <table class="list_table tablecenter table-striped">
        <tbody>
            <tr>
                @*<th style="width: 80px">Thứ tự</th>*@
                <th>Tên đăng nhập</th>
                <th>Chi nhánh</th>
                <th>Phân quyền</th>
                @*<th style="width:150px">Tỉnh thành</th>*@
                @*<th>Face-Id</th>*@
                <th style="width:100px">Hoạt động</th>
                <th style="width: 130px"></th>
            </tr>
            @foreach (var user in Model.Users)
            {
                <tr data-id="@user.Id">
                    @*<td>@Html.EditorFor(model => user.Sort)</td>*@
                    <td class="left">
                        <a href="@Url.Action("UpdateUser", new { userId = user.Id })">@user.Username</a>
                    </td>
                    @*<td>@user.City.Name</td>*@
                    <td>@user.Office.Name</td>
                    @*<td>
                                <button type="button" class="btn btn-success" style="font-size:13px" onclick="checkBeforeRegister('@user.Id.ToString()', '@user.Username')">Đăng ký Face-Id</button>

                        </td>*@
                    <td>@Html.DisplayFor(model => user.TypeUser)</td>
                    <td>@Html.CheckBoxFor(model => user.Active)</td>
                    <td>
                        <a href="javascript:;" onclick="updateInfo('@user.Id')">Cập nhật</a> -
                        @Html.ActionLink("Sửa", "UpdateUser", new { id = user.Id }) -
                        <a href="javascript:;" onclick="deleteUser('@user.Id')" style="color: red;">Xóa</a>
                        @*<a href="@Url.Action("ListFaceId", new {userId = user.Id})">Danh sách Face-Id</a>*@
                    </td>
                </tr>
            }
            @if (Model.Users.PageCount > 1)
            {
                <tr>
                    <td colspan="5">@Html.PagedListPager(Model.Users, page => Url.Action("ListUser", new { page, officeId = Model.officeId, username = Model.Username }))</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section scripts
{
    <script type="text/javascript">
        function deleteUser(id) {
            if (confirm("Bạn có chắc chắn xóa tài khoản này không?")) {
                $.post("/Vcms/DeleteUser",
                    { userId: id },
                    function (data) {
                        if (data.status === "True") {
                            $.toast({
                                text: 'Xóa tài khoản thành công',
                                position: 'bottom-right',
                                icon: 'success',
                            })
                            $("tr[data-id='" + id + "']").fadeOut();
                        } else {
                            $.toast({
                                text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                                icon: 'error',
                            })
                        }
                    });
            }
        }

        function updateInfo(id) {
            const elm = $('tr[data-id="' + id + '"]');
            const sort = elm.find("#user_Sort").val();
            const active = elm.find("input#user_Active").prop("checked");
            $.post("/Vcms/QuickUpdateUser",
                { userId: id, sort, active },
                function (data) {
                    if (data) {
                        $.toast({
                            text: 'Cập nhật thành công',
                            position: 'bottom-right',
                            icon: 'success'
                        });
                    } else {
                        $.toast({
                            text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                            position: 'bottom-right',
                            icon: 'error'
                        });
                        window.location.reload();
                    };
                });
        }

        async function checkBeforeRegister(userId, username) {
            const supported = await isPlatformAuthenticatorAvailable();

            if (!supported) {
                alert("Thiết bị của bạn không hỗ trợ FaceID / TouchID / Passkey. Vui lòng sử dụng mật khẩu đăng nhập.");
                return;
            }

            // Nếu có hỗ trợ ➔ tiến hành đăng ký FaceID
            registerFaceId(userId, username);
        }

        async function registerFaceId(userId, username) {
            const resp = await fetch(`/FaceId/BeginRegistration?userId=${userId}&username=${username}`);
            const data = await resp.json();
            const publicKey = preformatMakeCredReq(data);
            //debugPublicKeyOptions(publicKey);
            const cred = await navigator.credentials.create({ publicKey });
            const response = formatMakeCredResp(cred);
            //console.log(JSON.stringify(response));
            const rs = await fetch(`/FaceId/CompleteRegistration?userId=${userId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(response)
            });
            const rsData = await rs.json();
            if (rsData.status === "ok") {
                alert("Đăng ký FaceID thành công!");
                window.location.reload();
            } else {
                alert("Đăng ký FaceID thất bại!");
            }
        }

        function removeFaceId(credentialId) {
            if (confirm("Bạn có chắc chắn xóa FaceId này?")) {
                $.post("/FaceId/RemoveFaceId", { credentialId: credentialId }, function (data) {
                    if (data.status === "ok") {
                        alert("Xóa FaceId thành công!");
                        window.location.reload();
                    } else {
                        alert("Xóa FaceId thất bại!");
                    }
                });
            }
        }
    </script>
}