@model OceanEduSlide.ViewModels.ListDiscountViewModel
@using PagedList.Mvc
@{
    ViewBag.Title = "Danh sách ưu đãi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">Danh sách ưu đãi</h2>
@if (ViewBag.Result == "add")
{
    <div id="AlertBox" class="alert alert-success"><strong>Thêm mới ưu đãi thành công</strong></div>
}
@if (ViewBag.Result == "update")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật ưu đãi thành công</strong></div>
}
@if (ViewBag.CountDelete > 0)
{
    <div id="AlertBox" class="alert alert-success"><strong>Đã xóa @ViewBag.CountDelete QĐ ưu đãi</strong></div>
}
<a class="btn quick-link" href="@Url.Action("CreateDiscount")"><i class="fal fa-plus-circle me-1"></i>Thêm ưu đãi</a>
<a class="btn quick-link" href="@Url.Action("InsertDiscountExcel")"><i class="fal fa-plus-circle me-1"></i>Thêm ưu đãi Excel</a>
@*<a class="btn quick-link" href="@Url.Action("ExportDiscount")"><i class="fa-regular fa-table me-1"></i>Xuất Excel</a>*@
<div class="box_content">
    <form action="@Url.Action("ListDiscount")" method="get">
        <div class="row">
            <div class="col-lg">
                <label>Tên ưu đãi</label> @Html.TextBoxFor(a => a.Name, new { @class = "w300 mt-2" })
            </div>
            <div class="col-lg">
                <label class="mb-2">Chương trình học</label>
                <select name="Cth">
                    <option value="">Tất cả</option>
                    <option value="Anh văn nhi đồng" @(Model.Cth == "Anh văn nhi đồng" ? "selected" : "")>Anh văn nhi đồng</option>
                    <option value="Anh văn thiếu nhi" @(Model.Cth == "Anh văn thiếu nhi" ? "selected" : "")>Anh văn thiếu nhi</option>
                    <option value="T.A học thuật Trung học" @(Model.Cth == "T.A học thuật Trung học" ? "selected" : "")>T.A học thuật Trung học</option>
                    <option value="Luyện thi IELTS" @(Model.Cth == "Luyện thi IELTS" ? "selected" : "")>Luyện thi IELTS</option>
                    <option value="T.A giao tiếp quốc tế TOEIC" @(Model.Cth == "T.A giao tiếp quốc tế TOEIC" ? "selected" : "")>T.A giao tiếp quốc tế TOEIC</option>
                </select>
            </div>
            <div class="col-lg">
                <label>Ngày tạo</label> @Html.TextBoxFor(a => a.CreateDate, new { @class = "datepicker mt-2", autocomplete = "off" })
            </div>
            <div class="col-lg">
                <label>Ngày đang có hiệu lực (từ)</label> @Html.TextBoxFor(a => a.StartDate, new { @class = "datepicker mt-2", autocomplete = "off" })
            </div>
            <div class="col-lg">
                <label>Ngày đang có hiệu lực (đến) </label> @Html.TextBoxFor(a => a.EndDate, new { @class = "datepicker mt-2", autocomplete = "off" })
            </div>
            <div class="col-lg">
                <label class="mb-2">Chi nhánh</label>
                @Html.DropDownListFor(model => model.officeId, Model.SelectOffices, "Tất cả", new { @class = "mt-2", data_item = "office" })
            </div>
            <div class="col-lg align-self-center">
                <button type="submit" class="btn-search mt-2">Tìm kiếm</button>
            </div>
        </div>
    </form>
    <p>Có tổng số <strong>@Model.Discounts.TotalItemCount</strong> QĐ ưu đãi</p>
    <a onclick="clearDiscount()" href="javascript:;" class="btn btn-danger mb-3" style="font-size:13px;">Xóa @Model.Discounts.TotalItemCount QĐ này (theo bộ lọc)</a>
    <table class="list_table tablecenter table-striped">
        <tbody>
            <tr>
                <th>Tên ưu đãi</th>
                <th>Phần trăm ưu đãi</th>
                <th>Ưu đãi tiền mặt</th>
                <th>Quà tặng</th>
                <th>Số tháng từ</th>
                <th>Số tháng đến</th>
                <th>Ngày tạo</th>
                <th>Ngày hiệu lực</th>
                <th>Ngày hết hạn</th>
                <th>Chi nhánh</th>
                <th>Chương trình học</th>
                <th style="width:100px">Hoạt động</th>
                <th style="width: 130px"></th>
            </tr>
            @foreach (var discount in Model.Discounts)
            {
                <tr data-id="@discount.Id">
                    <td class="left">
                        <a href="@Url.Action("UpdateDiscount", new { dcId = discount.Id })">@discount.Username</a>
                    </td>
                    <td>@discount.PercentDiscount</td>
                    <td>@(discount.MoneyDiscount.HasValue ? discount.MoneyDiscount.Value.ToString("N0") + "đ" : "")</td>
                    <td>@discount.Gift</td>
                    <td>@discount.Pathway</td>
                    <td>@discount.PathwayTo</td>
                    <td>@(discount.CreateDate?.ToString("dd/MM/yyyy"))</td>
                    <td>@(discount.StartDate?.ToString("dd/MM/yyyy"))</td>
                    <td>@(discount.EndDate?.ToString("dd/MM/yyyy"))</td>
                    <td style="max-width:300px;word-break:break-word;text-align:start">@discount.Offices</td>
                    <td>@discount.Cth</td>
                    <td>@Html.DisplayFor(model => discount.Active)</td>
                    <td>
                        @Html.ActionLink("Sửa", "UpdateDiscount", new { dcId = discount.Id }) -
                        <a href="javascript:;" onclick="deleteDiscount('@discount.Id')" style="color: red;">Xóa</a>
                    </td>
                </tr>
            }
            @if (Model.Discounts.PageCount > 1)
            {
                <tr>
                    <td colspan="13">@Html.PagedListPager(Model.Discounts, page => Url.Action("ListDiscount", new { page, name = Model.Name, Cth = Model.Cth, startDate = Model.StartDate, endDate = Model.EndDate, createDate = Model.CreateDate, officeId = Model.officeId }))</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section scripts
{
    <script type="text/javascript">
        function deleteDiscount(id) {
            if (confirm("Bạn có chắc chắn xóa ưu đãi này không?")) {
                $.post("/Vcms/DeleteDiscount",
                    { discountId: id },
                    function (data) {
                        if (data === "True") {
                            $.toast({
                                text: 'Xóa ưu đãi thành công',
                                position: 'bottom-right',
                                icon: 'success',
                            })
                            $("tr[data-id='" + id + "']").fadeOut();
                        } else {
                            $.toast({
                                text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                                icon: 'error',
                            })
                        }
                    });
            }
        }
       function clearDiscount() {
    if (confirm("Hành động này sẽ xóa @Model.Discounts.TotalItemCount QĐ ưu đãi (theo bộ lọc)!")) {
        if (confirm("Bạn có chắc chắn xóa các QĐ ưu đãi này không?")) {

            window.location.href = "/Vcms/ClearDiscount?"
                + "name=" + encodeURIComponent('@(Model.Name ?? "")')
                + "&Cth=" + encodeURIComponent('@(Model.Cth ?? "")')
                + "&startDate=" + encodeURIComponent('@(Model.StartDate ?? "")')
                + "&endDate=" + encodeURIComponent('@(Model.EndDate ?? "")')
                + "&createDate=" + encodeURIComponent('@(Model.CreateDate ?? "")')
                + "&officeId=" + encodeURIComponent('@(Model.officeId ?? "")');
        }
    }
}
        $(function () {
            $(".datepicker").datepicker({
                dateFormat: "dd/mm/yy",
                yearRange: "1900:2100",
            });
        });
    </script>
}