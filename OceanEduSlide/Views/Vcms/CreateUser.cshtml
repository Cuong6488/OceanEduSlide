@model OceanEduSlide.ViewModels.CreateUserViewModel
@{
    ViewBag.Title = "CreateUser";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link href="~/Content/select2.min.css" rel="stylesheet" />
@if (ViewBag.Result == "add")
{
    <div id="AlertBox" class="alert alert-success"><strong>Thêm mới user thành công</strong></div>}
@if (ViewBag.Result == "update")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật user thành công</strong></div>}
<h2 class="mb-5 mt-0">Thêm mới User</h2>
<a class="btn quick-link" href="@Url.Action("ListUser","Vcms")"><i class="far fa-list me-1"></i> Danh sách tài khoản chi nhánh</a>
<div class="box_content px-300 mb-5">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)
        <table class="form_table">
            <tbody>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Username)</td>
                    <td class="form_text">
                        @*<input autocomplete="off" type="type" name="name" value="" />*@
                        @Html.EditorFor(model => model.Username, new { @class = "form_control w300" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Password)</td>
                    <td class="form_text">
                        @Html.PasswordFor(model => model.Password, new { @class = "form_control w300" })
                        @Html.ValidationMessageFor(model => model.Password)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.ConfirmPassword)</td>
                    <td class="form_text">
                        @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form_control w300" })
                        @Html.ValidationMessageFor(model => model.ConfirmPassword)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.MaNhanVien)</td>
                    <td class="form_text">
                        @*<input autocomplete="off" type="type" name="name" value="" />*@
                        @Html.EditorFor(model => model.MaNhanVien, new { @class = "form_control w300" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Fullname)</td>
                    <td class="form_text">
                        @*<input autocomplete="off" type="type" name="name" value="" />*@
                        @Html.EditorFor(model => model.Fullname, new { @class = "form_control w300" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.ZoneId)</td>
                    <td class="form_text">
                        @Html.DropDownListFor(model => model.ZoneId, Model.SelectZones, "Chọn vùng", new { @class = "mb-2", data_item = "zone" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.OfficeId)</td>
                    <td class="form_text">
                        @Html.DropDownListFor(model => model.OfficeId, Model.SelectOffices, "Chọn chi nhánh", new { @class = "mb-2", data_item = "office" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.OfficeIds)</td>
                    <td class="form_text">
                        <select name="CatIDs" id="categorySelect" class="form_control" multiple="" style=" height: 200px;">
                            @foreach (var item in Model.Offices)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.TypeUser)</td>
                    <td class="form_text">
                        @Html.EnumDropDownListFor(model => model.TypeUser, "Chọn phân quyền")
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.SaleKit)</td>
                    <td class="form_text">
                        @Html.CheckBoxFor(model => model.SaleKit)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Active)</td>
                    <td class="form_text">
                        @Html.CheckBoxFor(model => model.Active, new { @checked = "checked" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name"></td>
                    <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Thêm mới User"></td>
                </tr>
            </tbody>
        </table>
    }
</div>
@*<h2 class="mb-5">Danh sách User</h2>
    @Html.Action("ListUser", "Vcms")*@
@section Scripts {
    <script src="~/Scripts/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#categorySelect').select2({
                placeholder: 'Chọn các chi nhánh',
                allowClear: true,
                multiple: true
            }).val(null).trigger('change');

        });
    </script>
}
