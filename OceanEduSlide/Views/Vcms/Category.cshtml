
@{
    ViewBag.Title = "Cập nhật danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">Cập nhật danh mục</h2>
<a class="btn quick-link" href="@Url.Action("ListCategory")"><i class="far fa-list me-1"></i> Danh sách danh mục</a>
<div class="box_content">
    @using (Html.BeginForm("Category", "Vcms", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.ValidationSummary(true)
        <input type="hidden" name="Type" value="@ViewBag.Type" />
        <table class="form_table">
            <tr>
                <td class="form_name">Đính kèm File</td>
                <td class="form_text"><input type="file" name="CategoryFile" value="" /></td>
            </tr>
            <tr>
                <td class="form_name"></td>
                <td class="form_text">
                    <input type="submit" class="btn quick-link" value="Xác nhận" />
                </td>
            </tr>
        </table>
    }
</div>