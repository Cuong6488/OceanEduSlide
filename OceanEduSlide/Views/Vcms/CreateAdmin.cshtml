@model OceanEduSlide.ViewModels.CreateAdminViewModel
@{
    ViewBag.Title = "CreateAdmin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@if (ViewBag.Result == "add")
{
    <div id="AlertBox" class="alert alert-success"><strong>Thêm mới admin thành công</strong></div>}
@if (ViewBag.Result == "update")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật admin thành công</strong></div>}
<h2 class="mb-5 mt-0">Thêm mới Admin</h2>
@*<a class="btn quick-link" href="@Url.Action("CreateAdmin","Vcms")"><i class="far fa-list me-1"></i> Danh sách quản trị viên</a>*@
<div class="box_content px-300 mb-5">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)
        <table class="form_table">
            <tbody>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Username)</td>
                    <td class="form_text">
                        @*<input autocomplete="off" type="type" name="name" value="" />*@
                        @Html.EditorFor(model => model.Username, new { @class = "form_control w300" })
                        @Html.ValidationMessageFor(model => model.Username)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Password)</td>
                    <td class="form_text">
                        @Html.PasswordFor(model => model.Password, new { @class = "form_control w300" })
                        @Html.ValidationMessageFor(model => model.Password)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.ConfirmPassword)</td>
                    <td class="form_text">
                        @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form_control w300" })
                        @Html.ValidationMessageFor(model => model.ConfirmPassword)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Active)</td>
                    <td class="form_text">
                        @Html.CheckBoxFor(model => model.Active, new { @checked = "checked" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name"></td>
                    <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Thêm mới Admin"></td>
                </tr>
            </tbody>
        </table>
    }
</div>
<h2 class="mb-5">Danh sách Admin</h2>
@Html.Action("ListAdmin", "Vcms")
