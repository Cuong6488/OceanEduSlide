
@{
    ViewBag.Title = "Thêm mới ưu đãi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">Thêm mới ưu đãi</h2>
<a class="btn quick-link" href="@Url.Action("ListDiscount")"><i class="far fa-list me-1"></i> Danh sách ưu đãi</a>
<div class="box_content">
    @using (Html.BeginForm("InsertDiscountExcel", "Vcms", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.ValidationSummary(true)
        <table class="form_table">
            <tr>
                <td class="form_name">Đính kèm File</td>
                <td class="form_text"><input type="file" name="DiscountFile" value="" /></td>
            </tr>
            <tr>
                <td class="form_name"></td>
                <td class="form_text">
                    <input type="submit" class="btn quick-link" value="Xác nhận" />
                </td>
            </tr>
        </table>
    }
</div>