@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    body {
        font-family: "Segoe UI", sans-serif;
        background-color: #f6f8fa;
        padding: 20px;
    }

    h2 {
        margin-bottom: 20px;
        color: #333;
    }

    #groupWrapper {
        display: flex;
        gap: 12px;
    }

    .columnGroup {
        background-color: #fff;
        border: 1px solid #ccc;
        padding: 8px;
        min-width: 220px;
        cursor: move;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

        .columnGroup table {
            width: 100%;
            border-collapse: collapse;
        }

        .columnGroup th {
            background-color: #e2ecf5;
            font-weight: bold;
            border-bottom: 1px solid #bbb;
            text-align: center;
            padding: 6px;
        }

        .columnGroup td {
            border: 1px solid #ccc;
            padding: 6px;
            text-align: center;
        }
</style>

<h2>Báo cáo theo nhóm cột - Kéo thả tùy ý vị trí</h2>

<div id="groupWrapper">
    <!-- Nhóm 1: Định biên sale -->
    <div class="columnGroup" data-group-id="group-1" style="background-color:#e6f7ff">
        <table>
            <thead>
                <tr><th colspan="3">Định biên sale</th></tr>
                <tr>
                    <th>Định biên</th>
                    <th>Thực tế</th>
                    <th>% HT</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>6</td>
                    <td>6</td>
                    <td>100.0%</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Nhóm 2: Cuộc gọi -->
    <div class="columnGroup" data-group-id="group-2" style="background-color:#fff0f6">
        <table>
            <thead>
                <tr><th colspan="3">Cuộc gọi</th></tr>
                <tr>
                    <th>Chỉ tiêu</th>
                    <th>Thực hiện</th>
                    <th>% HT</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1.476</td>
                    <td>1.454</td>
                    <td>98.5%</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Nhóm 3: Học viên -->
    <div class="columnGroup" data-group-id="group-3" style="background-color:#f9ffe6">
        <table>
            <thead>
                <tr><th colspan="3">Học viên</th></tr>
                <tr>
                    <th>Chỉ tiêu</th>
                    <th>Thực hiện</th>
                    <th>% HT</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>25</td>
                    <td>6</td>
                    <td>23.9%</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Nhóm 4: Doanh số -->
    <div class="columnGroup" data-group-id="group-4" style="background-color:#e6ffee">
        <table>
            <thead>
                <tr><th colspan="3">Doanh số</th></tr>
                <tr>
                    <th>Chỉ tiêu</th>
                    <th>Thực hiện</th>
                    <th>% HT</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>750.000.000</td>
                    <td>235.526.500</td>
                    <td>31.4%</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Nhóm 5: Dự thu -->
    <div class="columnGroup" data-group-id="group-5" style="background-color:#ffe6e6">
        <table>
            <thead>
                <tr><th colspan="2">Dự thu thêm</th></tr>
                <tr>
                    <th>Kết quả</th>
                    <th>% HT dự kiến</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>473.062.500</td>
                    <td>94.5%</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


@section scripts
{
    <script>
        $(function () {
            $("#groupWrapper").sortable({
                axis: "x",
                items: ".columnGroup"
            });
        });
        $(function () {
            const wrapper = $("#groupWrapper");

            // Khởi tạo kéo thả
            wrapper.sortable({
                axis: "x",
                items: ".columnGroup",
                update: function () {
                    const order = wrapper.children().map(function () {
                        return $(this).attr("data-group-id");
                    }).get();
                    localStorage.setItem("groupOrder", JSON.stringify(order));
                }
            });

            // Khôi phục thứ tự nếu có trong localStorage
            const savedOrder = JSON.parse(localStorage.getItem("groupOrder") || "[]");
            if (savedOrder.length) {
                savedOrder.forEach(id => {
                    const group = wrapper.find(`[data-group-id="${id}"]`);
                    wrapper.append(group);
                });
            }
        });
    </script>
}