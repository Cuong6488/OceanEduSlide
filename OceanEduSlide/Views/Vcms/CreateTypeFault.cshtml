@model OceanEduSlide.Models.TypeFault
@{
    ViewBag.Title = "Thêm tổng hợp lỗi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@if (ViewBag.Result == "add")
{
    <div id="AlertBox" class="alert alert-success"><strong>Thêm mới tổng hợp lỗi thành công</strong></div>}
@if (ViewBag.Result == "update")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật tổng hợp lỗi thành công</strong></div>}
<h2 class="mb-5 mt-0">Thêm mới tổng hợp lỗi</h2>
@*<a class="btn quick-link" href="@Url.Action("CreateTypeFault","Vcms")"><i class="far fa-list me-1"></i> Danh sách quản trị viên</a>*@
<div class="box_content px-300 mb-5">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)
        <table class="form_table">
            <tbody>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Content)</td>
                    <td class="form_text">
                        @*<input autocomplete="off" type="type" name="name" value="" />*@
                        @Html.EditorFor(model => model.Content, new { @class = "form_control w300" })
                        @Html.ValidationMessageFor(model => model.Content)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Sort)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.Sort)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Active)</td>
                    <td class="form_text">
                        @Html.CheckBoxFor(model => model.Active, new { @checked = "checked" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name"></td>
                    <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Thêm mới"></td>
                </tr>
            </tbody>
        </table>
    }
</div>
<h2 class="mb-5">Danh sách tổng hợp lỗi</h2>
@Html.Action("ListTypeFault", "Vcms")
@section Scripts {
    <script>
        function deleteTypeFault(id) {
            if (confirm("Bạn có chắc chắn xóa tổng hợp lỗi này không?")) {
                $.post("/Vcms/DeleteTypeFault",
                    { typeFaultId: id },
                    function (data) {
                        if (data === "True") {
                            $.toast({
                                text: 'Xóa thành công',
                                position: 'bottom-right',
                                icon: 'success',
                            })
                            $("tr[data-id='" + id + "']").fadeOut();
                        } else {
                            $.toast({
                                text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                                icon: 'error',
                            })
                        }
                    });
            }
        }
    </script>
}