@model OceanEduSlide.ViewModels.CreateTargetViewModel
@{
    ViewBag.Title = "CreateUser";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@if (ViewBag.Result == "add")
{
    <div id="AlertBox" class="alert alert-success"><strong>Thêm mới thành công</strong></div>}
@if (ViewBag.Result == "update")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>}
<h2 class="mb-5 mt-0">Thêm mới User</h2>
<a class="btn quick-link" href="@Url.Action("ListUser","Vcms")"><i class="far fa-list me-1"></i> Danh sách tài khoản chi nhánh</a>
<div class="box_content px-300 mb-5">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)
        @Html.HiddenFor(a => a.Revenue.Month)
        @Html.HiddenFor(a => a.Revenue.Year)
        <table class="form_table">
            <tbody>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Revenue.Target)</td>
                    <td class="form_text">
                        @*<input autocomplete="off" type="type" name="name" value="" />*@
                        @Html.EditorFor(model => model.Revenue.Target, new { @class = "form_control w300" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Revenue.UserId)</td>
                    <td class="form_text">
                        @Html.DropDownListFor(model => model.Revenue.UserId, Model.SelectUsers, "Chọn nhân sự", new { @class = "form_control w300" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name"></td>
                    <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Thêm mới"></td>
                </tr>
            </tbody>
        </table>
    }
</div>
@*<h2 class="mb-5">Danh sách User</h2>
    @Html.Action("ListUser", "Vcms")*@