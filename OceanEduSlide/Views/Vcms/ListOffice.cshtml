@model OceanEduSlide.ViewModels.ListOfficeViewModel
@using PagedList.Mvc
@{
    ViewBag.Title = "Danh sách chi nhánh";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">Danh sách chi nhánh</h2>
@if (ViewBag.Result == "success")
{
    <div id="AlertBox" class="alert alert-success"><strong>Thêm mới chi nhánh thành công</strong></div>
}
@if (ViewBag.Result == "update")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật chi nhánh thành công</strong></div>
}
<a class="btn quick-link" href="@Url.Action("Office")"><i class="fal fa-plus-circle me-1"></i>Thêm chi nhánh</a>
<div class="box_content">
    <form action="@Url.Action("ListOffice")" method="get">
        <div class="row">
            <div class="col-lg-4">
                <label>Tỉnh thành</label> @Html.DropDownListFor(model => model.cityId, Model.SelectCities, "Tất cả chi nhánh", new { @class = "mt-2" })
            </div>
            <div class="col-lg-4">
                <label>Từ khóa</label> @Html.TextBoxFor(a => a.Name, new { @class = "w300 mt-2" })
            </div>
            <div class="col-lg-4 align-self-center">
                <button type="submit" class="btn-search mt-2">Tìm kiếm</button>
            </div>
        </div>
    </form>
    <p>Có tổng số <strong>@Model.Agencies.TotalItemCount</strong> chi nhánh</p>
    <table class="list_table tablecenter table-striped">
        <tbody>
            <tr>
                <th style="width: 80px">Thứ tự</th>
                <th>Tên chi nhánh</th>
                <th style="width:150px">Tỉnh thành</th>
                <th style="width:100px">Hoạt động</th>
                <th style="width: 130px"></th>
            </tr>
            @foreach (var agency in Model.Agencies)
            {
                <tr data-id="@agency.Id">
                    <td>@Html.EditorFor(model => agency.Sort)</td>
                    <td class="left">
                        <a href="@Url.Action("UpdateOffice", new { agencyId = agency.Id })">@agency.Name</a>
                    </td>
                    <td>@agency.City.Name</td>
                    <td>@Html.CheckBoxFor(model => agency.Active)</td>
                    <td>
                        <a href="javascript:;" onclick="updateInfo('@agency.Id')">Cập nhật</a> -
                        @Html.ActionLink("Sửa", "UpdateOffice", new { agencyId = agency.Id }) -
                        <a href="javascript:;" onclick="deleteOffice('@agency.Id')" style="color: red;">Xóa</a>
                    </td>
                </tr>
            }
            @if (Model.Agencies.PageCount > 1)
            {
                <tr>
                    <td colspan="5">@Html.PagedListPager(Model.Agencies, page => Url.Action("ListOffice", new { page, catId = Model.cityId, name = Model.Name }))</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section scripts
{
    <script type="text/javascript">
        function deleteOffice(id) {
            if (confirm("Bạn có chắc chắn xóa chi nhánh này không?")) {
                $.post("/Vcms/DeleteOffice",
                    { agencyId: id },
                    function (data) {
                        if (data === "True") {
                            $.toast({
                                text: 'Xóa chi nhánh thành công',
                                position: 'bottom-right',
                                icon: 'success',
                            })
                            $("tr[data-id='" + id + "']").fadeOut();
                        } else {
                            $.toast({
                                text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                                icon: 'error',
                            })
                        }
                    });
            }
        }

        function updateInfo(id) {
            const elm = $('tr[data-id="' + id + '"]');
            const sort = elm.find("#agency_Sort").val();
            const active = elm.find("input#agency_Active").prop("checked");
            $.post("/Vcms/QuickUpdateOffice",
                { agencyId: id, sort, active },
                function (data) {
                    if (data) {
                        $.toast({
                            text: 'Cập nhật thành công',
                            position: 'bottom-right',
                            icon: 'success'
                        });
                    } else {
                        $.toast({
                            text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                            position: 'bottom-right',
                            icon: 'error'
                        });
                        window.location.reload();
                    };
                });
        }
    </script>
}