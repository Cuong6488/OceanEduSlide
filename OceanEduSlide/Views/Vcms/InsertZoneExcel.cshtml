
@{
    ViewBag.Title = "Thêm mới vùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">Thêm mới vùng</h2>
<a class="btn quick-link" data-fancybox data-type="iframe" data-src="@Url.Action("ListFile","Revenue", new {type = 2})" href="javascript:;">
    <i class="far fa-list me-1"></i> Lịch sử cập nhật
</a>
<div class="box_content">
    @using (Html.BeginForm("InsertZoneExcel", "Vcms", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.ValidationSummary(true)
        <table class="form_table">
            <tr>
                <td class="form_name">Đính kèm File</td>
                <td class="form_text"><input type="file" name="ZoneFile" value="" /></td>
            </tr>
            <tr>
                <td class="form_name"></td>
                <td class="form_text">
                    <input type="submit" class="btn quick-link" value="Xác nhận" />
                </td>
            </tr>
        </table>
    }
</div>

<h2 class="mb-5">Danh sách Vùng</h2>
@Html.Action("ListZone", "Vcms")