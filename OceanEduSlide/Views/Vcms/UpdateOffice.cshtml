@model OceanEduSlide.ViewModels.InsertOfficeViewModel
@{
    ViewBag.Title = "Cập nhật chi nhánh";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">Cập nhật chi nhánh</h2>
<a class="btn quick-link" href="@Url.Action("ListOffice")"><i class="far fa-list me-1"></i> Danh sách chi nhánh</a>
<div class="box_content">
    @using (Html.BeginForm("UpdateOffice", "Vcms", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.ValidationSummary(true)
        @Html.HiddenFor(model => model.Office.Id)
    <table class="form_table">
        <tr>
            <td class="form_name">@Html.LabelFor(model => model.Office.CityId)</td>
            <td class="form_text">
                @Html.DropDownListFor(model => model.Office.CityId, Model.SelectCities, "Chọn tỉnh thành", new { @class = "mt-2", data_item = "city" })
            </td>
        </tr>
        <tr>
            <td class="form_name">@Html.LabelFor(model => model.Office.DistrictId)</td>
            <td class="form_text">
                @Html.DropDownListFor(model => model.Office.DistrictId, Model.DistrictSelectList, "Quận huyện", new { @class = "mt-2", data_item = "district" })
            </td>
        </tr>
        <tr>
            <td class="form_name">@Html.LabelFor(model => model.Office.Name)</td>
            <td class="form_text">@Html.EditorFor(model => model.Office.Name)</td>
        </tr>
        <tr>
            <td class="form_name">@Html.LabelFor(model => model.Office.Infor)</td>
            <td class="form_text">@Html.EditorFor(model => model.Office.Infor)</td>
        </tr>
        <tr>
            <td class="form_name">@Html.LabelFor(model => model.Office.GoogleMap)</td>
            <td class="form_text">@Html.EditorFor(model => model.Office.GoogleMap)</td>
        </tr>
        <tr>
            <td class="form_name">@Html.LabelFor(model => model.Office.Active)</td>
            <td class="form_text">@Html.CheckBoxFor(model => model.Office.Active, new { @checked = "checked" })</td>
        </tr>
        <tr>
            <td class="form_name">@Html.LabelFor(model => model.Office.Sort)</td>
            <td class="form_text">@Html.EditorFor(model => model.Office.Sort, new { @checked = "checked" })</td>
        </tr>
        <tr>
            <td class="form_name"></td>
            <td class="form_text">
                <input type="submit" class="btn quick-link" value="Cập nhật" />
            </td>
        </tr>
    </table>
    }
</div>