@model OceanEduSlide.ViewModels.CreateDiscountViewModel
@{
    ViewBag.Title = "UpdateDiscount";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mb-5 mt-0">Thêm mới QĐ ưu đãi</h2>
<a class="btn quick-link" href="@Url.Action("ListDiscount","Vcms")"><i class="far fa-list me-1"></i> Danh sách QĐ ưu đãi</a>
<div class="box_content px-300 mb-5">
    @using (Html.BeginForm())
    {
        @Html.HiddenFor(a => a.Discount.Id)
        @Html.ValidationSummary(true)
        <table class="form_table">
            <tbody>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Discount.Username)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.Discount.Username, new { @class = "form_control w300" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Discount.PercentDiscount)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.Discount.PercentDiscount)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.MoneyDiscount)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.MoneyDiscount)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Discount.Gift)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.Discount.Gift)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Discount.Pathway)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.Discount.Pathway)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Discount.PathwayTo)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.Discount.PathwayTo)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.StartDate)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.StartDate)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.EndDate)</td>
                    <td class="form_text">
                        @Html.EditorFor(model => model.EndDate)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Discount.Offices)</td>
                    <td class="form_text">
                        @Html.TextBoxFor(model => model.Discount.Offices, new { @placeholder = "Tên các Mã CN ngăn cách nhau bởi dấu phẩy, không có khoảng trắng" })
                        @Html.ValidationMessageFor(model => model.Discount.Offices)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Cth)</td>
                    <td class="form_text">
                        @Html.DropDownListFor(model => model.Cth, Model.SelectCth, "Chọn Chương trình học", new { @class = "form_control w300" })
                        @Html.ValidationMessageFor(model => model.Cth)
                    </td>
                </tr>
                <tr>
                    <td class="form_name">@Html.LabelFor(model => model.Discount.Active)</td>
                    <td class="form_text">
                        @Html.CheckBoxFor(model => model.Discount.Active, new { @checked = "checked" })
                    </td>
                </tr>
                <tr>
                    <td class="form_name"></td>
                    <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Cập nhật QĐ"></td>
                </tr>
            </tbody>
        </table>
    }
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
    <script>
        $(function () {
            $(".input-number").maskMoney({
                precision: 0,
                thousands: ','
            });
            $(".datepicker").datepicker({
                dateFormat: "dd/mm/yy",
                yearRange: "1900:2100",
            });
        });
    </script>
}