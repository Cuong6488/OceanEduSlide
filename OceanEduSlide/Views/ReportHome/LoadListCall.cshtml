@model OceanEduSlide.ViewModels.LoadListCallViewModel
<div class="box_content" style="max-height:90vh">
    <h2>Danh sách cuộc gọi @ViewBag.Type từ @Model.StartDay - @Model.EndDay - nhân sự @(Model.User.User.Fullname)</h2>
    <table class="list_table tablecenter table-striped">
        <tbody>
            <tr>
                <th style="text-align:center">Thời gian</th>
                <th style="text-align: center">Thời lượng</th>
                <th style="text-align:center">Mã cuộc gọi</th>
                <th style="text-align: center">Nghe lại cuộc gọi</th>
            </tr>
            @foreach (var item in Model.CallLogs)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(a => item.CallDate)
                    </td>
                    <td>
                        @Html.DisplayFor(a => item.BillSec)s
                    </td>
                    <td>
                        @item.UniqueId
                    </td>
                    <td>
                        <audio controls>
                            <source src="@item.RecordingFile" type="audio/wav">
                            Trình duyệt của bạn không hỗ trợ audio.
                        </audio>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
