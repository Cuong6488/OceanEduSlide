
@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@model ListCallViewModel
@{
    ViewBag.Title = "Thống kê cuộc gọi";
    Office office = null;
    if (Model.OfficeId != null)
    {
        office = Model.Offices.FirstOrDefault(a => a.Id == Model.OfficeId);
    }
}
<style>
    #OfficeId-error, #Month-error, #OfficeId-error, #ZoneId-error {
        display: none !important;
    }
</style>
<form action="@Url.Action("ReportCall")" method="get" class="d-flex form-filter form-inyear mb-5" id="form-reportcall">
    <div class="row g-2 w-100">
        <div class="col-md-3 col-6">
            <div class="d-flex align-items-center">
                <p class="m-0 me-2" style="width:60px"><strong>Từ ngày:</strong></p>
                <input class="form-control" style="flex:1" type="text" id="StartDay" name="StartDay" value="@Model.StartDay" autocomplete="off" />
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="d-flex align-items-center">
                <p class="m-0 me-2" style="width:60px"><strong>Đến ngày:</strong></p>
                <input class="form-control" style="flex:1" type="text" id="EndDay" name="EndDay" value="@Model.EndDay" autocomplete="off" />
            </div>
        </div>
        @if (Model.Zones?.Count() > 1)
        {
            <div class="col-md-3 col-6">
                <select name="ZoneId" class="form-select">
                    <option value="">Chọn vùng</option>
                    @foreach (var item in Model.Zones)
                    {
                        <option value="@item.Id" @(Model.ZoneId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
            </div>
        }
        @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.CV || ((Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.EC || Model.User.TypeUser == TypeUser.AEC) && !string.IsNullOrEmpty(Model.User.OfficeIds)))
        {
            if (Model.Offices.Count() > 1)
            {
                <div class="col-md-3 col-6">
                    <select name="OfficeId" class="form-select">
                        <option value="">Chọn chi nhánh</option>
                        @foreach (var item in Model.Offices)
                        {
                            <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.ShortName</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" value="@Model.OfficeId" name="OfficeId" />
            }
        }
        else if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.EC || Model.User.TypeUser == TypeUser.SAB || Model.User.TypeUser == TypeUser.ALT)
        {
            <input type="hidden" value="@Model.OfficeId" name="OfficeId" />
        }
    </div>
    @*@if (Model.HistoryUser.TypeUser == TypeUser.HO || Model.HistoryUser.TypeUser == TypeUser.CV)*@

    @*@if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.CV)*@
</form>
@if (Model.OfficeId == null)
{
    <p class="text-danger">* Vui lòng chọn chi nhánh</p>
}
<h2>@ViewBag.Title</h2>
@if (Model.UserItems != null)
{
    <div class="box_content mt-0">
        <table class="list_table tablecenter table-striped listrevenue-user">
            <tbody>
                <tr class="text-center">
                    <th rowspan="2" class="col-w100 text-start px-2">Chi nhánh</th>
                    <th rowspan="2" class="text-start px-2">Mã nhân sự</th>
                    <th rowspan="2" class="col-w100 text-start px-2">Họ tên nhân sự</th>
                    <th rowspan="2" class="col-w65 text-start px-2">CDCM</th>
                    <th rowspan="2" class="col-w65 text-start px-2">Tháng làm việc</th>
                    <th rowspan="2" class="col-w100 text-start px-2">Trạng thái</th>
                    <th rowspan="2" class="col-w65 text-start px-2">Ngày <br /> vào làm</th>
                    <th rowspan="2" class="col-w90 text-start px-2">Ngày nghỉ/ <br /> điều chuyển</th>
                    <th>Trên 2 phút</th>
                    <th>Trên 1,5 phút</th>
                    <th>Từ 1 phút trở lên</th>
                    <th>Dưới 1 phút</th>
                    <th>Dưới 30s</th>
                    @for (var i = 1; i <= ViewBag.WorkingWeeks; i++)
                    {
                        <th colspan="4">Tuần @i</th>
                    }
                    <th colspan="3">Trạng thái khác</th>
                    <th rowspan="2">Cuộc gọi <br /> trên 60s</th>
                    <th rowspan="2">Cuộc gọi <br /> trên 30s</th>
                    <th rowspan="2">Tổng <br /> cuộc gọi</th>
                    <th rowspan="2">Thống kê <br /> theo ngày</th>
                </tr>
                <tr class="text-center">
                    <th>@Model.TotalOver120s</th>
                    <th>@Model.TotalOver90s</th>
                    <th>@Model.TotalOver60s</th>
                    <th>@Model.TotalUnder60s</th>
                    <th>@Model.TotalUnder30s</th>
                    <th>No Answer</th>
                    <th>Busy</th>
                    <th>Failed</th>
                </tr>
                @foreach (var item in Model.UserItems)
                {
                    <tr>
                        @*<td class="text-start px-2">@(item.HistoryUser.Office?.ShortName)</td>*@
                        <td class="text-start px-2">@(office == null? item.HistoryUser.Office?.ShortName:office.ShortName)</td>
                        <td class="text-start px-2">@item.HistoryUser.User.MaNhanVien</td>
                        <td class="text-start px-2">@item.HistoryUser.User.Fullname</td>
                        <td class="text-start px-2">@item.HistoryUser.CDCM</td>
                        <td class="text-start px-2">@item.HistoryUser.Month</td>
                        <td class="text-start px-2">@Html.DisplayFor(a => item.HistoryUser.Status)</td>
                        <td class="text-start px-2">@Html.DisplayFor(a => item.HistoryUser.DayStart)</td>
                        <td class="text-start px-2">@Html.DisplayFor(a => item.HistoryUser.DayEnd)</td>
                        <td>
                            @if (item.Over120s > 0)
                            {
                                <a class="text-danger" title="Xem danh sách" href="" data-src="@Url.Action("LoadListCall", new {userId = item.HistoryUser.Id,type = 120,startDay = Model.StartDay,endDay = Model.EndDay})"
                                   data-fancybox data-type="ajax" data-touch="false">@item.Over120s</a>
                            }
                            else
                            {
                                @: 0
                            }
                        </td>
                        <td>
                            @if (item.Over90s > 0)
                            {
                                <a class="text-danger" title="Xem danh sách" href="" data-src="@Url.Action("LoadListCall", new {userId = item.HistoryUser.Id,type = 90,startDay = Model.StartDay,endDay = Model.EndDay})"
                                   data-fancybox data-type="ajax" data-touch="false">@item.Over90s</a>
                            }
                            else
                            {
                                @: 0
                            }
                        </td>
                        <td>
                            @if (item.Over60s > 0)
                            {
                                <a class="text-danger" title="Xem danh sách" href="" data-src="@Url.Action("LoadListCall", new {userId = item.HistoryUser.Id,type = 60,startDay = Model.StartDay,endDay = Model.EndDay})"
                                   data-fancybox data-type="ajax" data-touch="false">@item.Over60s</a>
                            }
                            else
                            {
                                @: 0
                            }
                        </td>
                        <td>
                            @if (item.Under60s > 0)
                            {
                                <a class="text-danger" title="Xem danh sách" href="" data-src="@Url.Action("LoadListCall", new {userId = item.HistoryUser.Id,type = 59,startDay = Model.StartDay,endDay = Model.EndDay})"
                                   data-fancybox data-type="ajax" data-touch="false">@item.Under60s</a>
                            }
                            else
                            {
                                @: 0
                            }
                        </td>
                        <td>
                            @if (item.Under30s > 0)
                            {
                                <a class="text-danger" title="Xem danh sách" href="" data-src="@Url.Action("LoadListCall", new {userId = item.HistoryUser.Id,type = 30,startDay = Model.StartDay,endDay = Model.EndDay})"
                                   data-fancybox data-type="ajax" data-touch="false">@item.Under30s</a>
                            }
                            else
                            {
                                @: 0
                            }
                        </td>
                        <td>@item.NoAns</td>
                        <td>@item.Busy</td>
                        <td>@item.Failed</td>
                        <td>@item.TotalOver60s</td>
                        <td>@item.TotalOver30s</td>
                        <td>@item.Total</td>
                        <td>
                            <a href="" data-src="@Url.Action("LoadListCallDay", new {userId = item.HistoryUser.Id,startDay = Model.StartDay,endDay = Model.EndDay})"
                               data-fancybox data-type="ajax" data-touch="false">Xem</a>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
}
@section scripts
{
    @*<link rel="stylesheet" href="//code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
        <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"></script>*@

    <script>
        var today = new Date();
        $("#StartDay").datepicker({
            dateFormat: 'dd/mm/yy',
            maxDate: today,
        }).attr('readonly', 'readonly');
        $("#EndDay").datepicker({
            dateFormat: 'dd/mm/yy',
            maxDate: today,
        }).attr('readonly', 'readonly');
    </script>
}