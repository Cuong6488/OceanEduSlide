
@{
    ViewBag.Title = "Báo cáo KDCN";

    var reportDataDict = Model.ReportDatas
        .GroupBy(d => new { d.OfficeId, CategoryId = d.ReportCategory.ReportCategoryId ?? 0 })
        .ToDictionary(
            g => g.Key,
            g => g.OrderBy(d => d.Sort).ToList()
        );
}

@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@using PagedList.Mvc

@model ListReportHomeViewModel

<style>
    td, th {
        height: 45px !important;
    }

    .h-90 {
        height: 90px !important;
    }

    #OfficeId-error, #Month-error, #OfficeId-error, #ZoneId-error {
        display: none !important;
    }
</style>

<div class="container py-3">
    <form action="@Url.Action("ReportKDCN")" method="get" class="form-filter mb-5">
        <div class="row g-2">
            <div class="col-lg-2 col-md-3 col-6">
                <select name="Year" class="form-select" required>
                    <option value="">Chọn năm</option>
                    @for (int i = 2024; i <= DateTime.Now.Year; i++)
                    {
                        <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <select name="Month" class="form-select" required>
                    <option value="">Chọn tháng</option>
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
                    }
                </select>
            </div>
            @if (Model.Zones?.Count() > 1)
            {
                <div class="col-lg-2 col-md-3 col-6">
                    <select name="ZoneId" class="form-select">
                        <option value="">Chọn vùng</option>
                        @foreach (var item in Model.Zones)
                        {
                            <option value="@item.Id" @(Model.ZoneId == item.Id ? "selected" : "")>@item.Name</option>
                        }
                    </select>
                </div>
            }
            @if (Model.ListOffice?.Count() > 1)
            {
                <div class="col-lg-2 col-md-3 col-6">
                    <select name="OfficeId" class="form-select">
                        <option>Chọn chi nhánh</option>
                        @foreach (var item in Model.ListOffice)
                        {
                            <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.ShortName</option>
                        }
                    </select>
                </div>
            }
        </div>
        <input type="hidden" name="categoryid" value="@Model.categoryId" />
        <input type="hidden" name="sort" value="@Model.sort" />
    </form>

    <h2>BÁO CÁO KDCN tháng @Model.Month - @Model.Year</h2>
    <a class="btn quick-link" href="@Url.Action("ExportKDCN", new {Month = Model.Month,Year = Model.Year,ZoneId = Model.ZoneId})"><i class="fa-regular fa-table me-1"></i>Xuất Excel</a>
    <div class="box_content d-flex">
        <div class="columnGroup" data-group-id="group-0">
            <table>
                <tbody>
                    <tr>
                        <th class="h-90" rowspan="2">Tháng</th>
                        <th rowspan="2" class="col-w90 h-90">Vùng</th>
                        <th rowspan="2" class="col-w150 h-90">Chi nhánh</th>
                    </tr>
                    <tr></tr>

                    @foreach (var office in Model.Offices)
                    {
                        <tr class="tr1">
                            <td>@Model.Month</td>
                            <td class="text-start">@(office.Zone?.Name)</td>
                            <td class="text-start">@office.ShortName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="groupWrapper">
            @foreach (var group in Model.ReportCategories.Where(c => c.ReportCategoryId == null).GroupBy(c => c.Group))
            {
                var groupId = group.Key;
                int total = group.Count();
                int i = 1;

                <div class="columnGroup columnGroupCN d-flex columnGroup-@groupId" data-group-id="groupCN-@groupId" style="margin-right:-1px;">
                    @foreach (var category in group)
                    {
                        var tableClass = (total > 1 && i < total) ? "no-right-border" : "";
                        var subCategories = Model.ReportCategories.Where(a => a.ReportCategoryId == category.Id).ToList();

                        <table class="@tableClass">
                            <thead>
                                <tr>
                                    <th class="col-w100" colspan="@category.Count">@category.Name</th>
                                </tr>
                                <tr>
                                    @foreach (var child in subCategories)
                                    {
                                        <th data-categoryid="@child.Id" class="col-w65 th-filter">
                                            @child.Name
                                            <div class="btn-filter">
                                                <div class="icon-default @(Model.categoryId == child.Id?"active":"")">
                                                    <i class="fa-solid fa-sort-down"></i>
                                                </div>
                                                <div class="icon-order orderdesc @(Model.categoryId == child.Id && Model.sort == 0?"active":"")">
                                                    <i class="fa-solid fa-sort-down"></i>
                                                    <i class="fa-solid fa-arrow-up-long"></i>
                                                </div>
                                                <div class="icon-order order @(Model.categoryId == child.Id && Model.sort == 1?"active":"")">
                                                    <i class="fa-solid fa-sort-down"></i>
                                                    <i class="fa-solid fa-arrow-down-long"></i>
                                                </div>
                                                <ul class="ul-reset">
                                                    <li data-sort="1">Cao <i class="fa-solid fa-right"></i> thấp</li>
                                                    <li data-sort="0">Thấp <i class="fa-solid fa-right"></i> cao</li>
                                                </ul>
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var office in Model.Offices)
                                {
                                    <tr class="tr1">
                                        @{
                                            var key = new { OfficeId = office?.Id, CategoryId = category.Id };
                                            var dataList = reportDataDict.ContainsKey(key) ? reportDataDict[key] : new List<ReportData>();
                                        }

                                        @foreach (var data in dataList.Take(category.Count ?? 1))
                                        {
                                            <td>@data.Data</td>
                                        }

                                        @for (var k = dataList.Count; k < (category.Count ?? 1); k++)
                                        {
                                            <td></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                        i++;
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.Offices.PageCount > 1)
    {
        <div class="text-center">
            @if (Model.OfficeId != null)
            {
                @Html.PagedListPager(Model.Offices, page => Url.Action("ReportKDCN", new { page, zoneId = Model.ZoneId, OfficeId = Model.OfficeId, month = Model.Month, year = Model.Year, categoryid = Model.categoryId, sort = Model.sort }))
            }
            else
            {
                @Html.PagedListPager(Model.Offices, page => Url.Action("ReportKDCN", new { page, zoneId = Model.ZoneId, month = Model.Month, year = Model.Year, categoryid = Model.categoryId, sort = Model.sort }))
            }
        </div>
    }
    <input type="hidden" name="page" value="@ViewBag.Page" />
</div>

@section scripts
{
    <script>
        $(function () {
            const wrapper = $("#groupWrapper");

            wrapper.sortable({
                axis: "x",
                items: ".columnGroupCN",
                update: function () {
                    const order = wrapper.children().map(function () {
                        return $(this).attr("data-group-id");
                    }).get();
                    localStorage.setItem("groupOrderCN", JSON.stringify(order));
                }
            });

            const savedOrder = JSON.parse(localStorage.getItem("groupOrderCN") || "[]");
            if (savedOrder.length) {
                savedOrder.forEach(id => {
                    const group = wrapper.find(`[data-group-id="${id}"]`);
                    wrapper.append(group);
                });
            }
        });


        $(".btn-filter li").on("click", function (data) {
            //$(this).siblings("ul").removeClass("active");
            var categoryid = $(this).closest('th').data("categoryid");
            var sort = $(this).data("sort");
            var zoneId = $('select[name="ZoneId"]').val();
            var officeId = $('select[name="OfficeId"]').val();
            var month = $('select[name="Month"]').val();
            var year = $('select[name="Year"]').val();
            var page = $('input[name="page"]').val();
            window.location.href = `/ReportHome/ReportKDCN?page=${page}&Year=${year}&Month=${month}&ZoneId=${zoneId}&OfficeId=${officeId}&categoryid=${categoryid}&sort=${sort}`;

        });

    </script>
}
