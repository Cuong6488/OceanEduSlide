@{
    ViewBag.Title = "Trang chủ";
}
@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@model ListReportHomeViewModel

<style>
    td{
        height:45px !important;
    }
    #OfficeId-error, #Month-error, #OfficeId-error, #ZoneId-error {
        display: none !important;
    }

    #groupWrapper {
        display: flex !important;
        gap: 0;
        border: 1px solid #ccc;
        border-radius: 6px;
        overflow:auto;
    }

    .columnGroup {
        flex-grow: 1;
        margin-right: -1px; /* để border không bị dày lên */
    }

        .columnGroup table {
            width: 100%;
            border-collapse: collapse;
            border-spacing: 0;
            font-family: "Segoe UI", sans-serif;
            border: none;
        }

        .columnGroup th,
        .columnGroup td {
            border: 1px solid #ccc;
            padding: 6px;
            text-align: center;
        }

        .columnGroup thead th {
            background-color: #f0f4ff;
            font-weight: bold;
        }

        .columnGroup:hover {
            box-shadow: inset 0 0 4px rgba(0,0,0,0.1);
        }
        
</style>
<div class="container py-3">
    <form action="@Url.Action("ReportKDCN")" method="get" class="d-flex form-filter mb-5">
        <select name="Year" class="form-select me-3 w-25" required">
            <option value="">Chọn năm</option>
            @for (int i = 2024; i <= DateTime.Now.Year; i++)
            {
                <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
            }
        </select>
        <select name="Month" class="form-select me-3 w-25" required>
            <option value="">Chọn tháng</option>
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
            }
        </select>
        @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.CV)
        {
            <select name="ZoneId" class="form-select me-3 w-25">
                <option value="">Chọn vùng</option>
                @foreach (var item in Model.Zones)
                {
                    <option value="@item.Id" @(Model.ZoneId == item.Id ? "selected" : "")>@item.Name</option>
                }
            </select>
        }
    </form>
    <h2>BÁO CÁO KDCN tháng @Model.Month - @Model.Year</h2>
    <a class="btn quick-link" href="@Url.Action("Report", "Report", new {type = 1})">Cập nhật báo cáo KDCN</a>
    <div class="box_content">
        <div id="groupWrapper">
            <div class="columnGroup" data-group-id="group-0">
                <table>
                    <tbody>
                        <tr>
                            <th>Tháng</th>
                            <th class="col-w90">Vùng</th>
                            <th class="col-w200">Chi nhánh</th>
                        </tr>
                        @foreach (var office in Model.Offices)
                        {
                            <tr>
                                <td>@Model.Month</td>
                                <td class="text-start">@(office.Zone?.Name)</td>
                                <td class="text-start">@office.Name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @foreach (var category in Model.ReportCategories.Where(a => a.ReportCategoryId == null))
            {
                <div class="columnGroup" data-group-id="group-@category.Id">
                    <table>
                        @*<thead>
                            <tr><th colspan="@category.Count">Định biên sale</th></tr>
                            <tr>
                                <th>Định biên</th>
                                <th>Thực tế</th>
                                <th>% HT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>6</td>
                                <td>6</td>
                                <td>100.0%</td>
                            </tr>
                        </tbody>*@
                    </table>
                </div>
            }
        </div>
    </div>

</div>
@section scripts
{
    <script>
        $(function () {
            const wrapper = $("#groupWrapper");

            wrapper.sortable({
                axis: "x",
                items: ".columnGroup",
                update: function () {
                    const order = wrapper.children().map(function () {
                        return $(this).attr("data-group-id");
                    }).get();
                    localStorage.setItem("groupOrder", JSON.stringify(order));
                }
            });

            const savedOrder = JSON.parse(localStorage.getItem("groupOrder") || "[]");
            if (savedOrder.length) {
                savedOrder.forEach(id => {
                    const group = wrapper.find(`[data-group-id="${id}"]`);
                    wrapper.append(group);
                });
            }
        });
    </script>

}