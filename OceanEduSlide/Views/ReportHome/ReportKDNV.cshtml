
@{
    ViewBag.Title = "Báo cáo KDNV";
    string maNhanViens = ViewBag.MaNhanViens ?? ",";

    // Chuyển sang HashSet chuỗi (không đổi sang số)
    var maNhanVienList = maNhanViens
        .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
        .ToHashSet();
    // Phân nhóm user có/không dữ liệu theo mã NV
    //var usersHasData = Model.HistoryUsers
    //    .Where(u => maNhanVienList.Contains(u.User?.MaNhanVien))
    //    .ToList();

    //var usersNoData = Model.HistoryUsers
    //    .Where(u => !maNhanVienList.Contains(u.User?.MaNhanVien))
    //    .ToList();

    // Gom dữ liệu báo cáo theo UserId + CategoryId
    var reportDataDict = Model.ReportDatas
        .GroupBy(d => new { d.HistoryUserId, CategoryId = d.ReportCategory.ReportCategoryId ?? 0 })
        .ToDictionary(
            g => g.Key,
            g => g.OrderBy(d => d.Sort).ToList()
        );
}

@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@using PagedList.Mvc
@model ListReportNVHomeViewModel

<style>
    td, th {
        height: 45px !important;
    }

    .h-90 {
        height: 90px !important;
    }

    #OfficeId-error, #Month-error, #ZoneId-error {
        display: none !important;
    }

    #groupWrapper {
        display: flex !important;
        gap: 0;
        overflow: auto;
        border-right: 1px solid #ccc;
    }

    .columnGroup {
        flex-grow: 1;
        margin-right: -1px;
    }

        .columnGroup table {
            width: 100%;
            border-collapse: collapse;
            border-spacing: 0;
            font-family: "Segoe UI", sans-serif;
            border: none;
        }

        .columnGroup th, .columnGroup td {
            border: 1px solid #ccc;
            padding: 6px;
            text-align: center;
        }

        .columnGroup thead th {
            background-color: #f0f4ff;
            font-weight: bold;
        }

        .columnGroup:hover {
            box-shadow: inset 0 0 4px rgba(0,0,0,0.1);
        }

    .select2-container {
        margin: 0 8px;
    }
</style>

<div class="container py-3">
    <form action="@Url.Action("ReportKDNV")" method="get" class="d-flex form-filter mb-5">
        <select name="Year" class="form-select me-2 w-25" required>
            <option value="">Chọn năm</option>
            @for (int i = 2024; i <= DateTime.Now.Year; i++)
            {
                <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
            }
        </select>
        <select name="Month" class="form-select me-3 w-25" required>
            <option value="">Chọn tháng</option>
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
            }
        </select>
        @if (Model.Zones?.Count() > 1)
        {
            <select name="ZoneId" class="form-select me-2 w-25">
                <option value="">Chọn vùng</option>
                @foreach (var z in Model.Zones)
                {
                    <option value="@z.Id" @(Model.ZoneId == z.Id ? "selected" : "")>@z.Name</option>
                }
            </select>
        }

        @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.CV || !string.IsNullOrEmpty(Model.User.OfficeIds))
        {

            <select name="OfficeId" class="form-select w-25">
                <option>Chọn chi nhánh</option>
                @foreach (var office in Model.Offices)
                {
                    <option value="@office.Id" @(Model.OfficeId == office.Id ? "selected" : "")>@office.ShortName</option>
                }
            </select>
        }
        <select name="UserId" class="form-select w-25 select2">
            <option>Chọn nhân sự</option>
            @foreach (var user in Model.ListHistoryUser)
            {
                <option value="@user.Id" @(Model.UserId == user.Id ? "selected" : "")>@user.User.Fullname - @user.User.MaNhanVien - @user.CDCM</option>
            }
        </select>

        @if ((Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.EC || Model.User.TypeUser == TypeUser.SAB || Model.User.TypeUser == TypeUser.ALT) && string.IsNullOrEmpty(Model.User.OfficeIds))
        {
            <input type="hidden" name="OfficeId" value="@Model.OfficeId" />
        }
        <select name="UserType" class="form-select w-25 ms-2">
            <option value="">Tất cả chức danh</option>
            <option value="3" @(Model.UserType == 3 ? "selected" : "")>BM</option>
            <option value="4" @(Model.UserType == 4 ? "selected" : "")>EC</option>
            <option value="5" @(Model.UserType == 5 ? "selected" : "")>ATL</option>
            <option value="11" @(Model.UserType == 11 ? "selected" : "")>AEC</option>
            <option value="6" @(Model.UserType == 6 ? "selected" : "")>SAB</option>
            <option value="7" @(Model.UserType == 7 ? "selected" : "")>CM</option>
            <option value="9" @(Model.UserType == 9 ? "selected" : "")>TTL</option>
        </select>
        <input type="hidden" name="categoryid" value="@Model.categoryId" />
        <input type="hidden" name="sort" value="@Model.sort" />
    </form>

    <h2>BÁO CÁO KDNV tháng @Model.Month - @Model.Year</h2>
    <a class="btn quick-link" href="@Url.Action("ExportKDNV", new {Month = Model.Month,Year = Model.Year,ZoneId = Model.ZoneId,OfficeId = Model.OfficeId,UserType=Model.UserType})"><i class="fa-regular fa-table me-1"></i>Xuất Excel</a>

    <div class="box_content d-flex">
        <div class="columnGroup" data-group-id="group-0">
            <table>
                <tbody>
                    <tr>
                        <th class="h-90 col-w65" rowspan="2">Tháng</th>
                        <th rowspan="2" class="col-w65 h-90">Vùng</th>
                        <th rowspan="2" class="col-w100 h-90">Chi nhánh</th>
                        <th rowspan="2" class="h-90 col-w65">Mã NV</th>
                        <th rowspan="2" class="col-w150 h-150">Họ tên nhân sự</th>
                        <th rowspan="2" class="col-w65 h-65">CDCM</th>
                        <th rowspan="2" class="col-w90 h-90">Trạng thái</th>
                        <th rowspan="2" class="col-w65 h-90">Ngày <br /> vào làm</th>
                        <th rowspan="2" class="col-w90 h-90">Ngày nghỉ/ <br /> điều chuyển</th>
                    </tr>
                    <tr></tr>

                    @foreach (var u in Model.HistoryUsers)
                    {
                        <tr class="tr-1">
                            <td>@Model.Month</td>
                            @*<td class="text-start">@(u.Office?.Zone.Name)</td>*@
                            <td class="text-start">
                                @if (u.ZoneId != null)
                                {
                                    @u.Zone.Name
                                }
                                else if (u.Office?.ZoneId != null)
                                {
                                    @u.Office.Zone.Name
                                }
                            </td>
                            <td class="text-start">@(u.Office?.ShortName)</td>
                            <td class="text-start">@(u.User?.MaNhanVien)</td>
                            <td class="text-start">@(u.User?.Fullname)</td>
                            <td class="text-start">@u.CDCM</td>
                            <td class="text-start">@Html.DisplayFor(m => u.Status)</td>
                            <td class="text-start">@Html.DisplayFor(m => u.DayStart)</td>
                            <td class="text-start">@Html.DisplayFor(m => u.DayEnd)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="groupWrapper">
            @foreach (var group in Model.ReportCategories.Where(c => c.ReportCategoryId == null).GroupBy(c => c.Group))
            {
                var groupId = group.Key;
                int total = group.Count();
                int i = 1;
                <div class="columnGroup columnGroupNV d-flex columnGroup-@groupId"
                     data-group-id="group-@groupId" style="margin-right:-1px;">
                    @foreach (var cat in group)
                    {
                        var tableClass = (total > 1 && i < total) ? "no-right-border" : "";
                        <table class="@tableClass">
                            <thead>
                                <tr>
                                    <th class="col-w100" colspan="@cat.Count">@cat.Name</th>
                                </tr>
                                <tr>
                                    @foreach (var child in Model.ReportCategories.Where(a => a.ReportCategoryId == cat.Id))
                                    {
                                        <th data-categoryid="@child.Id" class="col-w65 th-filter">
                                            @child.Name
                                            <div class="btn-filter">
                                                <div class="icon-default @(Model.categoryId == child.Id?"active":"")">
                                                    <i class="fa-solid fa-sort-down"></i>
                                                </div>
                                                <div class="icon-order orderdesc @(Model.categoryId == child.Id && Model.sort == 0?"active":"")">
                                                    <i class="fa-solid fa-sort-down"></i>
                                                    <i class="fa-solid fa-arrow-up-long"></i>
                                                </div>
                                                <div class="icon-order order @(Model.categoryId == child.Id && Model.sort == 1?"active":"")">
                                                    <i class="fa-solid fa-sort-down"></i>
                                                    <i class="fa-solid fa-arrow-down-long"></i>
                                                </div>
                                                <ul class="ul-reset">
                                                    <li data-sort="1">Cao <i class="fa-solid fa-right"></i> thấp</li>
                                                    <li data-sort="0">Thấp <i class="fa-solid fa-right"></i> cao</li>
                                                </ul>
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.HistoryUsers)
                                {
                                    <tr class="tr-1">
                                        @{
                                            var key = new { HistoryUserId = (int?)u.Id, CategoryId = cat.Id };
                                            var list = reportDataDict.ContainsKey(key) ? reportDataDict[key] : new List<ReportData>();
                                        }
                                        @foreach (var d in list.Take(cat.Count ?? 1))
                                        {
                                            <td>@d.Data</td>
                                        }
                                        @for (int k = list.Count; k < (cat.Count ?? 1); k++)
                                        {
                                            <td></td>
                                        }
                                    </tr>
                                }
                                @*@foreach (var _ in usersNoData)
                                    {
                                        <tr class="tr-2">
                                            @for (int j = 0; j < (cat.Count ?? 1); j++)
                                            {
                                                <td></td>
                                            }
                                        </tr>
                                    }*@
                            </tbody>
                        </table>
                        i++;
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.HistoryUsers.PageCount > 1)
    {
        <div class="text-center">
            @if (Model.OfficeId != null)
            {
                @Html.PagedListPager(Model.HistoryUsers, page => Url.Action("ReportKDNV", new { page, zoneId = Model.ZoneId, OfficeId = Model.OfficeId, UserType = Model.UserType, month = Model.Month, year = Model.Year, categoryid = Model.categoryId, sort = Model.sort, listMonth = Model.ListMonth }))
            }
            else
            {
                @Html.PagedListPager(Model.HistoryUsers, page => Url.Action("ReportKDNV", new { page, zoneId = Model.ZoneId, month = Model.Month, UserType = Model.UserType, year = Model.Year, categoryid = Model.categoryId, sort = Model.sort, listMonth = Model.ListMonth }))
            }
        </div>
    }
    <input type="hidden" name="page" value="@ViewBag.Page" />
</div>

@section scripts {
    <script>
        $(function () {
            const wrapper = $("#groupWrapper");
            wrapper.sortable({
                axis: "x",
                items: ".columnGroupNV",
                update: function () {
                    const order = wrapper.children().map(function () {
                        return $(this).attr("data-group-id");
                    }).get();
                    localStorage.setItem("groupOrderNV", JSON.stringify(order));
                }
            });
            const saved = JSON.parse(localStorage.getItem("groupOrderNV") || "[]");
            if (saved.length) {
                saved.forEach(id =>
                    wrapper.append(wrapper.find(`[data-group-id="${id}"]`))
                );
            }
        });
        $('.select2').select2({ allowClear: true });
        const $monthSelect = $('.select2-month');

        $monthSelect.select2({
            placeholder: "Chọn tháng",
            width: '100%'
        });

        // Clear bằng dấu ×
        $('.clear-month').on('click', function () {
            $monthSelect.val(null).trigger('change');
        });

        // Xử lý Quý / Cả năm
        $monthSelect.on('select2:select', function (e) {
            const val = e.params.data.id;
            let months = [];
            switch (val) {
                case 'all': months = Array.from({ length: 12 }, (_, i) => (i + 1).toString()); break;
                case 'q1': months = ['1', '2', '3']; break;
                case 'q2': months = ['4', '5', '6']; break;
                case 'q3': months = ['7', '8', '9']; break;
                case 'q4': months = ['10', '11', '12']; break;
                default: return;
            }
            $monthSelect.val(months).trigger('change');

            // Bỏ chọn option đặc biệt
            setTimeout(() => {
                $monthSelect.find('option[value="' + val + '"]').prop('selected', false);
            }, 0);
        });



        $(".btn-filter li").on("click", function (data) {
            //$(this).siblings("ul").removeClass("active");
            ////var categoryid = @Model.categoryId;
            var sort = @Model.sort.ToString();
            @*var zoneId = @Model.ZoneId;
          var officeId = @Model.OfficeId;
          var userType = @Model.UserType;
          var userId = @Model.UserId;*@
          var year = @Model.Year.ToString();
            //window.location.href = `/ReportHome/ReportKDNV?Year=${year}&ZoneId=${zoneId}&categoryid=${categoryid}&sort=${sort}userIdd=${userId}&OfficeId=${officeId}&UserType=${userType}`;
    var zoneId   = @(Model.ZoneId.HasValue ? Model.ZoneId.Value.ToString() : "undefined");
    var officeId = @(Model.OfficeId.HasValue ? Model.OfficeId.Value.ToString() : "undefined");
    var userType = @(Model.UserType.HasValue ? Model.UserType.Value.ToString() : "undefined");
    var userId   = @(Model.UserId.HasValue ? Model.UserId.Value.ToString() : "undefined");

    // Giả sử categoryid là biến JS khác
    // var categoryid = ...;

    // Build URL động
    var url = '/ReportHome/ReportKDNV?';

    if(sort !== undefined) url += `sort=${sort}&`;
    if(zoneId !== undefined) url += `ZoneId=${zoneId}&`;
    if(officeId !== undefined) url += `OfficeId=${officeId}&`;
    if(userType !== undefined) url += `UserType=${userType}&`;
    if(userId !== undefined) url += `userIdd=${userId}&`;
    if(year !== undefined) url += `Year=${year}&`;
    // if(categoryid !== undefined) url += `categoryid=${categoryid}&`;

    // Loại bỏ ký tự & thừa
    url = url.replace(/&$/, '');

    // Chuyển hướng
    window.location.href = url;
        });
    </script>
}
