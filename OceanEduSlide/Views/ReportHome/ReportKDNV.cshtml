
@{
    ViewBag.Title = "Báo cáo KDNV";
    string maNhanViens = ViewBag.MaNhanViens ?? ",";

    // Chuyển sang HashSet chuỗi (không đổi sang số)
    var maNhanVienList = maNhanViens
        .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
        .ToHashSet();
    // Phân nhóm user có/không dữ liệu theo mã NV
    var usersHasData = Model.HistoryUsers
        .Where(u => maNhanVienList.Contains(u.User?.MaNhanVien))
        .ToList();

    var usersNoData = Model.HistoryUsers
        .Where(u => !maNhanVienList.Contains(u.User?.MaNhanVien))
        .ToList();

    // Gom dữ liệu báo cáo theo UserId + CategoryId
    var reportDataDict = Model.ReportDatas
        .GroupBy(d => new { d.HistoryUserId, CategoryId = d.ReportCategory.ReportCategoryId ?? 0 })
        .ToDictionary(
            g => g.Key,
            g => g.OrderBy(d => d.Sort).ToList()
        );
}

@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@using PagedList.Mvc
@model ListReportNVHomeViewModel

<style>
    td, th {
        height: 45px !important;
    }

    .h-90 {
        height: 90px !important;
    }

    #OfficeId-error, #Month-error, #ZoneId-error {
        display: none !important;
    }

    #groupWrapper {
        display: flex !important;
        gap: 0;
        overflow: auto;
        border-right: 1px solid #ccc;
    }

    .columnGroup {
        flex-grow: 1;
        margin-right: -1px;
    }

        .columnGroup table {
            width: 100%;
            border-collapse: collapse;
            border-spacing: 0;
            font-family: "Segoe UI", sans-serif;
            border: none;
        }

        .columnGroup th, .columnGroup td {
            border: 1px solid #ccc;
            padding: 6px;
            text-align: center;
        }

        .columnGroup thead th {
            background-color: #f0f4ff;
            font-weight: bold;
        }

        .columnGroup:hover {
            box-shadow: inset 0 0 4px rgba(0,0,0,0.1);
        }
</style>

<div class="container py-3">
    <form action="@Url.Action("ReportKDNV")" method="get" class="d-flex form-filter mb-5">
        <select name="Year" class="form-select me-3 w-25" required>
            <option value="">Chọn năm</option>
            @for (int i = 2024; i <= DateTime.Now.Year; i++)
            {
                <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
            }
        </select>
        <select name="Month" class="form-select me-3 w-25" required>
            <option value="">Chọn tháng</option>
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
            }
        </select>

        @*@if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.CV || (Model.User.TypeUser == TypeUser.ASM))*@
        @if (Model.Zones?.Count() > 1)
        {
            <select name="ZoneId" class="form-select me-3 w-25">
                <option value="">Chọn vùng</option>
                @foreach (var z in Model.Zones)
                {
                    <option value="@z.Id" @(Model.ZoneId == z.Id ? "selected" : "")>@z.Name</option>
                }
            </select>
        }

        @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.CV || !string.IsNullOrEmpty(Model.User.OfficeIds))
        {
            <select name="OfficeId" class="form-select w-25">
                <option>Chọn chi nhánh</option>
                @foreach (var office in Model.Offices)
                {
                    <option value="@office.Id" @(Model.OfficeId == office.Id ? "selected" : "")>@office.Name</option>
                }
            </select>
        }
        @if ((Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.EC || Model.User.TypeUser == TypeUser.SAB || Model.User.TypeUser == TypeUser.ALT) && string.IsNullOrEmpty(Model.User.OfficeIds))
        {
            <input type="hidden" name="OfficeId" value="@Model.OfficeId" />
        }
        <select name="UserType" class="form-select w-25 ms-3">
            <option value="">Tất cả chức danh</option>
            <option value="3" @(Model.UserType == 3 ? "selected" : "")>BM</option>
            <option value="4" @(Model.UserType == 4 ? "selected" : "")>EC</option>
            <option value="5" @(Model.UserType == 5 ? "selected" : "")>ATL</option>
            @if (Model.User.TypeUser == TypeUser.ASM)
            {
                @*<option value="11" @(Model.UserType == 11 ? "selected" : "")>AEC</option>*@
            }
            <option value="6" @(Model.UserType == 6 ? "selected" : "")>SAB</option>
            <option value="7" @(Model.UserType == 7 ? "selected" : "")>CM</option>
            <option value="9" @(Model.UserType == 9 ? "selected" : "")>TTL</option>
        </select>
    </form>

    <h2>BÁO CÁO KDNV tháng @Model.Month - @Model.Year</h2>
    <a class="btn quick-link" href="@Url.Action("Report", "Report", new { type = 2 })">Cập nhật báo cáo KDNV</a>

    <div class="box_content d-flex">
        <div class="columnGroup" data-group-id="group-0">
            <table>
                <tbody>
                    <tr>
                        <th class="h-90 col-w65" rowspan="2">Tháng</th>
                        <th rowspan="2" class="col-w65 h-90">Vùng</th>
                        <th rowspan="2" class="col-w100 h-90">Chi nhánh</th>
                        <th rowspan="2" class="h-90 col-w65">Mã NV</th>
                        <th rowspan="2" class="col-w150 h-150">Họ tên nhân sự</th>
                        <th rowspan="2" class="col-w65 h-65">Vị trí</th>
                        <th rowspan="2" class="col-w90 h-90">Trạng thái</th>
                        <th rowspan="2" class="col-w65 h-90">Ngày <br /> vào làm</th>
                        <th rowspan="2" class="col-w90 h-90">Ngày nghỉ/ <br /> điều chuyển</th>
                    </tr>
                    <tr></tr>

                    @foreach (var u in usersHasData)
                    {
                        <tr class="tr-1">
                            <td>@Model.Month</td>
                            @*<td class="text-start">@(u.Office?.Zone.Name)</td>*@
                            <td class="text-start">@(u.Zone?.Name)</td>
                            <td class="text-start">@(u.Office?.ShortName)</td>
                            <td class="text-start">@(u.User?.MaNhanVien)</td>
                            <td class="text-start">@(u.User?.Fullname)</td>
                            <td class="text-start">@Html.DisplayFor(m => u.TypeUser)</td>
                            <td class="text-start">@Html.DisplayFor(m => u.Status)</td>
                            <td class="text-start">@Html.DisplayFor(m => u.DayStart)</td>
                            <td class="text-start">@Html.DisplayFor(m => u.DayEnd)</td>
                        </tr>
                    }
                    @foreach (var u in usersNoData)
                    {
                        <tr class="tr-2">
                            <td>@Model.Month</td>
                            @*<td class="text-start">@(u.Office?.Zone.Name)</td>*@
                            <td class="text-start">@(u.Zone?.Name)</td>
                            <td class="text-start">@(u.Office?.ShortName)</td>
                            <td class="text-start">@(u.User?.MaNhanVien)</td>
                            <td class="text-start">@(u.User?.Fullname)</td>
                            <td class="text-start">@Html.DisplayFor(m => u.TypeUser)</td>
                            <td class="text-start">@Html.DisplayFor(m => u.Status)</td>
                            <td class="text-start">@Html.DisplayFor(m => u.DayStart)</td>
                            <td class="text-start">@Html.DisplayFor(m => u.DayEnd)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="groupWrapper">
            @foreach (var group in Model.ReportCategories.Where(c => c.ReportCategoryId == null).GroupBy(c => c.Group))
            {
                var groupId = group.Key;
                int total = group.Count();
                int i = 1;
                <div class="columnGroup columnGroupNV d-flex columnGroup-@groupId"
                     data-group-id="group-@groupId" style="margin-right:-1px;">
                    @foreach (var cat in group)
                    {
                        var tableClass = (total > 1 && i < total) ? "no-right-border" : "";
                        <table class="@tableClass">
                            <thead>
                                <tr>
                                    <th class="col-w100" colspan="@cat.Count">@cat.Name</th>
                                </tr>
                                <tr>
                                    @foreach (var child in Model.ReportCategories.Where(a => a.ReportCategoryId == cat.Id))
                                    {
                                        <th class="col-w65">@child.Name</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in usersHasData)
                                {
                                    <tr class="tr-1">
                                        @{
                                            var key = new { HistoryUserId = (int?)u.Id, CategoryId = cat.Id };
                                            var list = reportDataDict.ContainsKey(key) ? reportDataDict[key] : new List<ReportData>();
                                        }
                                        @foreach (var d in list.Take(cat.Count ?? 1))
                                        {
                                            <td>@d.Data</td>
                                        }
                                        @for (int k = list.Count; k < (cat.Count ?? 1); k++)
                                        {
                                            <td></td>
                                        }
                                    </tr>
                                }
                                @foreach (var _ in usersNoData)
                                {
                                    <tr class="tr-2">
                                        @for (int j = 0; j < (cat.Count ?? 1); j++)
                                        {
                                            <td></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                        i++;
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.HistoryUsers.PageCount > 1)
    {
        <div class="text-center">
            @if (Model.OfficeId != null)
            {
                @Html.PagedListPager(Model.HistoryUsers, page => Url.Action("ReportKDNV", new { page, zoneId = Model.ZoneId, OfficeId = Model.OfficeId, UserType = Model.UserType, month = Model.Month, year = Model.Year }))
            }
            else
            {
                @Html.PagedListPager(Model.HistoryUsers, page => Url.Action("ReportKDNV", new { page, zoneId = Model.ZoneId, month = Model.Month, UserType = Model.UserType, year = Model.Year }))
            }
        </div>
    }
</div>

@section scripts {
    <script>
        $(function () {
            const wrapper = $("#groupWrapper");
            wrapper.sortable({
                axis: "x",
                items: ".columnGroupNV",
                update: function () {
                    const order = wrapper.children().map(function () {
                        return $(this).attr("data-group-id");
                    }).get();
                    localStorage.setItem("groupOrderNV", JSON.stringify(order));
                }
            });
            const saved = JSON.parse(localStorage.getItem("groupOrderNV") || "[]");
            if (saved.length) {
                saved.forEach(id =>
                    wrapper.append(wrapper.find(`[data-group-id="${id}"]`))
                );
            }
        });
    </script>
}
