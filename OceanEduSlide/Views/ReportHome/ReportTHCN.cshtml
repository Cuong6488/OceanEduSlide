
@{
    ViewBag.Title = "Báo cáo Tổng hợp Vùng - Chi nhánh";
    int countItem = 0;
}

@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@model BCTHCNViewModel

<style>
    #OfficeId-error, #Month-error, #ZoneId-error {
        display: none !important;
    }

    .form-filter .select2 {
        width: 100% !important;
    }

    .box_content td {
        height: unset;
    }
</style>

<div class="container py-3">
    <form action="@Url.Action("ReportTHCN")" method="get" class="d-flex form-filter mb-5">
        <div class="row w-100">
            <div class="col-lg-3">
                <select name="Year" class="form-select" required>
                    <option value="">Chọn năm</option>
                    @for (int i = 2024; i <= DateTime.Now.Year; i++)
                    {
                        <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
                    }
                </select>
            </div>
            @if (Model.Zones?.Count() >= 1)
            {
                <div class="col-lg-3">
                    <select name="ZoneId" class="form-select">
                        <option value="">Chọn vùng</option>
                        @foreach (var z in Model.Zones)
                        {
                            <option value="@z.Id" @(Model.ZoneId == z.Id ? "selected" : "")>@z.Name</option>
                        }
                    </select>
                </div>
            }

            @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.CV || !string.IsNullOrEmpty(Model.User.OfficeIds))
            {

                <div class="col-lg-3">
                    <select name="OfficeId" class="form-select">
                        <option>Chọn chi nhánh</option>
                        @foreach (var office in Model.Offices)
                        {
                            <option value="@office.Id" @(Model.OfficeId == office.Id ? "selected" : "")>@office.ShortName</option>
                        }
                    </select>
                </div>
            }

            @if ((Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.EC || Model.User.TypeUser == TypeUser.SAB || Model.User.TypeUser == TypeUser.ALT) && string.IsNullOrEmpty(Model.User.OfficeIds))
            {
                <input type="hidden" name="OfficeId" value="@Model.OfficeId" />
            }
        </div>
    </form>

    <h2>BÁO CÁO Tổng hợp năm @Model.Year</h2>
    @if (Model.ZoneId == null && Model.OfficeId == null && Model.User.TypeUser != TypeUser.HO)
    {
        <p class="alert alert-success mt-3 w-25">Vui lòng chọn vùng/ chi nhánh</p>
    }
    else
    {
        <div class="box_content mt-0">
            <table class="table table-bordered table-thcn">
                <tr class="border-solid-top border-solid-right border-solid-bot border-solid-left">
                    <th colspan="2" class="bg-info text-white text-center border-solid-right"><strong>Chỉ số</strong></th>
                    @foreach (var item in Model.Months)
                    {
                        <th class="bg-pink @(item == Model.Months.Last()?"border-solid-right":"")">Tháng @item</th>
                    }
                    @if (Model.Months.Any(a => a == 1 || a == 2 || a == 3))
                    {
                        <th class="bg-pink-purple">Quý I</th>
                    }
                    @if (Model.Months.Any(a => a == 4 || a == 5 || a == 6))
                    {
                        <th class="bg-pink-purple">Quý II</th>
                    }
                    @if (Model.Months.Any(a => a == 7 || a == 8 || a == 9))
                    {
                        <th class="bg-pink-purple">Quý III</th>
                    }
                    @if (Model.Months.Any(a => a == 10 || a == 11 || a == 12))
                    {
                        <th class="bg-pink-purple">Quý IV</th>
                    }
                    <th class="bg-orange  border-solid-left">
                        @if (Model.Months.Count == 12)
                        {
                            @: Năm
                        }
                        else
                        {
                            @: Tổng
                        }
                    </th>
                </tr>

                <tr>
                    <td rowspan="2" class="text-primary align-middle text-center"><strong>Nhân sự</strong></td>
                    <td class="border-solid-right"><strong>Số Sale</strong></td>
                    @{
                        countItem = 0;
                    }

                    @foreach (var item in Model.SoSale)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N0");
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr class="border-solid-bot">
                    <td class="border-solid-right"><strong>Định biên</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.DinhBien)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N0");
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>

                <tr>
                    <td rowspan="6" class="text-primary align-middle text-center"><strong>Doanh số</strong></td>
                    <td class="border-solid-right"><strong>Chỉ tiêu</strong></td>
                    @{
                        countItem = 0;
                    }

                    @foreach (var item in Model.ChiTieuDS)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N0");
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr>
                    <td class="border-solid-right"><strong>Thực đạt</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.ThucDatDS)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N0");
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr>
                    <td class="border-solid-right"><strong>% HT Doanh số</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.HTDS)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") + "%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr>
                    <td class="border-solid-right"><strong>Tỉ trọng Sale</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.TiTrongSale)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") + "%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr>
                    <td class="border-solid-right"><strong>Tỉ trọng Đào tạo</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.TiTrongDaoTao)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") + "%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr class="border-solid-bot">
                    <td class="border-solid-right"><strong>Tỉ trọng Kế toán</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.TiTrongKeToan)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") + "%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>

                <tr>
                    <td rowspan="3" class="text-primary align-middle text-center"><strong>Học viên</strong></td>
                    <td class="border-solid-right"><strong>Tổng số học viên</strong></td>
                    @{
                        countItem = 0;
                    }

                    @foreach (var item in Model.TongSoHocVien)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N0");
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr>
                    <td class="border-solid-right"><strong>Ghi danh lại</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.HVGhiDanhLai)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") + "%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr class="border-solid-bot">
                    <td class="border-solid-right"><strong>Ghi danh mới</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.HVGhiDanhMoi)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") + "%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>

                <tr>
                    <td rowspan="2" class="text-primary align-middle text-center"><strong>Chỉ số</strong></td>
                    <td class="border-solid-right"><strong>Cuộc gọi</strong></td>
                    @{
                        countItem = 0;
                    }

                    @foreach (var item in Model.HTCuocGoi)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") +"%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr class="border-solid-bot">
                    <td class="border-solid-right"><strong>Học viên</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.HTHocVien)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") + "%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>

                <tr>
                    <td rowspan="4" class="text-primary align-middle text-center"><strong>Năng lực Sale</strong></td>
                    <td class="border-solid-right"><strong>≥ 100%</strong></td>
                    @{
                        countItem = 0;
                    }

                    @foreach (var item in Model.SaleOver100)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N0");
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr>
                    <td class="border-solid-right"><strong>30% - 50%</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.Sale30To50)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N0");
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr>
                    <td class="border-solid-right"><strong>20% - 30%</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.Sale20To30)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N0");
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr class="border-solid-bot">
                    <td class="border-solid-right"><strong>Dưới 20%</strong></td>
                    @{
                        countItem = 0;
                    }
                    @foreach (var item in Model.SaleUnder20)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N0");
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>

                <tr>
                    <td rowspan="4" class="text-primary align-middle text-center"><strong>Nguồn doanh thu</strong></td>
                    <td class="border-solid-right"><strong>Doanh thu Nền</strong></td>
                    @{
                        countItem = 0;
                    }

                    @foreach (var item in Model.TiLeDoanhThuNen)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") +"%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr>
                    <td class="border-solid-right"><strong>Doanh thu Học bổng</strong></td>
                    @{
                        countItem = 0;
                    }

                    @foreach (var item in Model.TiLeDoanhThuHocBong)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") +"%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr>
                    <td class="border-solid-right"><strong>Doanh thu Vàng</strong></td>
                    @{
                        countItem = 0;
                    }

                    @foreach (var item in Model.TiLeDoanhThuVang)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") +"%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
                <tr>
                    <td class="border-solid-right"><strong>Doanh thu Sự kiện</strong></td>
                    @{
                        countItem = 0;
                    }

                    @foreach (var item in Model.TiLeDoanhThuSuKien)
                    {
                        countItem++;
                        var valuetext = item == 0 ? "-" : item.ToString("N2") +"%";
                        <td class="@(countItem == Model.Months.Count()?"border-solid-right":"") @(countItem == Model.SoSale.Count()?"border-solid-left":"")">@valuetext</td>
                    }
                </tr>
            </table>
        </div>
    }

</div>

@section scripts {
    <script>
        $('.select2').select2({ allowClear: true });
    </script>
}
