@model OceanEduSlide.ViewModels.ListRevenueUserViewModel
@using PagedList.Mvc
@using Helpers
@{
    ViewBag.Title = "Danh sách chỉ tiêu nhân sự";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";


}
@*@Html.Action("Header", new { name = "Kinh doanh/ Phân bổ doanh số" })*@
<h2 class="m-0 mb-3">Danh sách chỉ tiêu nhân sự</h2>
@if (ViewBag.Result == "success")
{
    <div id="AlertBox" class="alert alert-success"><strong>Thêm mới chỉ tiêu nhân sự thành công</strong></div>
}
@if (ViewBag.Result == "update")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật chỉ tiêu nhân sự thành công</strong></div>
}
<a class="btn quick-link" href="@Url.Action("TargetOffice")"><i class="fal fa-plus-circle me-1"></i>Cập nhật chỉ tiêu nhân sự</a>
<div class="box_content">
    <form action="@Url.Action("ListRevenueOffice")" method="get">
        <div class="row">
            <div class="col-4">
                <label class="mb-2">Chi nhánh</label>
                @Html.DropDownListFor(model => model.OfficeId, Model.SelectOffices, "Tất cả chi nhánh", new { @class = "form_control" })
            </div>
        </div>
        <div class="form-group mb-2">
            <button type="submit" class="btn-search">Tìm kiếm</button>
        </div>
    </form>
    <p>Có tổng số <strong>@Model.Revenues.TotalItemCount</strong> chỉ tiêu doanh số</p>
    <form id="revenueOfficeList">
        <table class="list_table tablecenter table-striped">
            <tbody>
                <tr>
                    <th style="width: 130px">Nhân sự</th>
                    <th style="width: 130px">Thời gian</th>
                    <th>Chỉ tiêu doanh số</th>
                    <th>Hoạt động</th>
                    @*<th style="width: 140px;"></th>*@
                </tr>
                @foreach (var revenueOffice in Model.Revenues)
                {
                    <tr data-id="@revenueOffice.Id">
                        <td>
                            @revenueOffice.User.Fullname
                        </td>
                        <td>
                            tháng @revenueOffice.Month - @revenueOffice.Year
                        </td>
                        <td>
                            @Html.DisplayFor(model => revenueOffice.Target)<br />
                        </td>
                        @*<td>
                            @Html.ActionLink("Sửa", "UpdateRevenueOffice", new { proId = revenueOffice.Id })
                            - <a href="javascript:;" onclick="deleteRevenueOffice('@revenueOffice.Id')" class="red-warring">Xóa</a>
                        </td>*@
                    </tr>
                }
                @if (Model.Revenues.PageCount > 1)
                {
                    <tr>
                        <td colspan="7">@Html.PagedListPager(Model.Revenues, page => Url.Action("ListRevenueUser", new { page, officeId = Model.OfficeId }))</td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
</div>

@section scripts
{
    <script type="text/javascript">
        function deleteRevenueOffice(id) {
            if (confirm("Bạn có chắc chắn xóa chỉ tiêu doanh số này không?")) {
                $.post("/TuyenSinh/DeleteRevenueOffice", { revId: id }, function (data) {
                    if (data) {
                        $.toast({
                            text: 'Xóa chỉ tiêu doanh số thành công',
                            position: 'bottom-right',
                            icon: 'success',
                        })
                        $("tr[data-id='" + id + "']").fadeOut();
                    }
                    else {
                        $.toast({
                            text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                            icon: 'error',
                        })
                    }
                });
            }
        }

        function updateInfo(id) {
            var elm = $('tr[data-id="' + id + '"]');
            var sort = elm.find("#revenueOffice_Sort").val();
            var home = elm.find("input#Home").prop("checked");
            var active = elm.find("input#RevenueOfficeStatus").prop("checked");
            var bestsale = elm.find("input#BestSale").prop("checked");
            var freeship = elm.find("input#FreeShip").prop("checked");
            $.post("/RevenueOfficeVcms/QuickUpdate", { proId: id, quantity, sort, active, home, bestsale, freeship },
                function (data) {
                    if (data) {
                        $.toast({
                            text: 'Cập nhật thành công',
                            position: 'bottom-right',
                            icon: 'success',
                        })
                    } else {
                        $.toast({
                            text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                            position: 'bottom-right',
                            icon: 'error',
                        })
                        window.location.reload();
                    };
                });
        }
        $("[data-item=root]").on("change", function (data) {
            const id = $(this).val();
            var items = [];
            items.push("<option value>Hãy chọn danh mục</option>");

            if (id !== "") {
                $.getJSON("/RevenueOfficeVcms/GetRevenueOfficeCategory", { parentId: id }, function (data) {
                    $.each(data,
                        function (key, val) {
                            items.push("<option value='" + val.Id + "'>" + val.Name + "</option>");
                        });
                    $("[data-item=child]").html(items.join(""));
                });
            } else {
                $("[data-item=child]").html(items.join(""));
            } 1
        });</script>
}