
@{
    ViewBag.Title = "Cập nhật các trường hợp đặc biệt";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">@ViewBag.Title</h2>
@*<a class="btn quick-link" href="@Url.Action("ListUser")"><i class="far fa-list me-1"></i> Danh sách xếp hạng</a>*@
@if (ViewBag.Result == "add")
{
    <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
}
<a class="btn quick-link" href="@Url.Action("ListPhieuThu")"><i class="far fa-list me-1"></i> Danh sách phiếu thu</a>
<a class="btn quick-link" data-fancybox data-type="iframe" data-src="@Url.Action("ListFile", new {type = 9})" href="javascript:;">
    <i class="far fa-list me-1"></i> Lịch sử cập nhật
</a>
<div class="box_content">
    @using (Html.BeginForm("PhieuThuTHDB", "Revenue", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.ValidationSummary(true)

        <table class="form_table">
            <tr>
                <td class="form_name w-25">Năm tính doanh thu</td>
                <td class="form_text">
                    <select name="Year" required class="w100">
                        <option value="">Chọn năm</option>
                        @for (int i = 2025; i <= DateTime.Now.Year; i++)
                        {
                            <option value="@i" @(i == DateTime.Now.Year ? "selected" : "")>@i</option>
                        }
                    </select>
                </td>
            </tr>
            <tr>
                <td class="form_name w-25">Tháng tính doanh thu</td>
                <td class="form_text">
                    <select name="Month" required class="w100">
                        <option value="">Chọn tháng</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </td>
            </tr>
            <tr>
                <td class="form_name">Đính kèm File</td>
                <td class="form_text"><input type="file" name="PhieuThuFile" value="" /></td>
            </tr>
            <tr>
                <td class="form_name"></td>
                <td class="form_text">
                    <input type="submit" class="btn quick-link" value="Xác nhận" />
                </td>
            </tr>
        </table>
    }
</div>