
@{
    ViewBag.Title = "Cập nhật DS Hoàn thành thực tế";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="mt-0">@ViewBag.Title</h2>
@*<a class="btn quick-link" href="@Url.Action("ListUser")"><i class="far fa-list me-1"></i> Danh sách xếp hạng</a>*@
@*<a class="btn quick-link" href="@Url.Action("ListRevenueUser")"><i class="far fa-list me-1"></i> Danh sách chỉ tiêu nhân sự</a>*@

<div class="box_content mt-0">
    @using (Html.BeginForm("RevenueUserWeek_Real", "Revenue", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.ValidationSummary(true)

        <table class="form_table">
            <tr>
                <td class="form_name">Đính kèm File</td>
                <td class="form_text"><input type="file" name="WeekRealFile" value="" /></td>
            </tr>
            <tr>
                <td class="form_name"></td>
                <td class="form_text">
                    <input type="submit" class="btn quick-link" value="Xác nhận" />
                </td>
            </tr>
        </table>
    }
</div>