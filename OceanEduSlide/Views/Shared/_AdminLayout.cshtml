@using OceanEduSlide.Models
@{ var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"]; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    @*<meta name="viewport" content="width=device-width" />*@
    <title>@ViewBag.Title</title>
    <meta name="robots" content="noindex" />
    <link rel="shortcut icon" href="~/favicon.ico">
    @Styles.Render("~/Content/admincss", "~/Content/themes/base/css")
    <link href="~/Content/select2.min.css" rel="stylesheet" />
    <link href="~/Scripts/multi-upload/jquery.fileupload.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
</head>
<body>
    <div id="responsive">
        <div class="app-header">
            <div class="app-header__logo">
                @if (config.Image != null)
                {
                    <a href="@Url.Action("Index","Home")" target="_blank"><img class="logo-admin" src="@Path.Combine("/images/configs/", config.Image)" alt="logo" /></a>
                }
                else
                {
                    <a href="@Url.Action("Index","Home")" target="_blank">
                        <img class="logo-admin" src="~/Content/images/logo.png" />
                    </a>
                }
                <a id="btn-show" onclick="myFunction()"><i class="fal fa-bars"></i><i class="fal fa-times"></i></a>
            </div>
            <div class="app-header__content">
                <div class="media me-lg-5 me-3 drop d-flex">
                    <img class="me-3 avatar" src="~/Content/admin/icon_profile.png" />
                    <div class="media-body">
                        <h5 class="mb-0">@User.Identity.Name</h5>
                        Quản trị viên
                    </div>
                    <div class="content-drop">
                        <a href="@Url.Action("LogOut","Vcms")"><i class="fal fa-sign-out-alt pr-1"></i> Đăng xuất</a>
                        <a href="@Url.Action("ChangePassword","Vcms")"><i class="fal fa-low-vision me-1"></i>Đổi mật khẩu</a>
                        <a href="@Url.Action("ConfigSite","Vcms")"><i class="fal fa-info-circle"></i> Thông tin chung</a>
                    </div>
                </div>
                <a id="help" class="drop" onclick="fbFunction()">
                    <i class="fas fa-user-headset"></i>
                    <div class="content-drop">Gửi yêu cầu cho chúng tôi</div>
                </a>
            </div>
        </div>
        <div id="left_menu_profile">
            <div class="left_menu_profile">
                <ul class="drop-bar">
                    <li data-id="0">
                        <a class="root expand" href="@Url.Action("Index","Vcms")">
                            Tổng quan website
                            <i class="far fa-tachometer icon"></i>
                        </a>
                    </li>
                    <li data-id="1">
                        <a class="root"><i class="fal fa-user-crown icon"></i><span>Admin</span><i class="fas fa-caret-down"></i></a>
                        <div class="sub hidden">
                            <div>@Html.ActionLink("Đổi mật khẩu", "ChangePassword", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Quản lý admin", "CreateAdmin", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Thông tin chung", "ConfigSite", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Lịch sử import file", "ListFileAll", "Revenue", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Đăng xuất", "Logout", "Vcms", null, new { @class = "text_link" })</div>
                        </div>
                    </li>
                    <li data-id="2">
                        <a class="root"><i class="fal fa-user-crown icon"></i><span>Tài khoản người dùng</span><i class="fas fa-caret-down"></i></a>
                        <div class="sub hidden">
                            <div>@Html.ActionLink("Thêm mới user", "CreateUser", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Danh sách user", "ListUser", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Thêm mới user - Excel", "InsertUserExcel", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Danh sách nhân sự theo tháng", "ListHistoryUser", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Đồng bộ nhân sự HRM", "SyncUserAsync", "Revenue", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Đồng bộ nhân sự Tháng trước", "SyncUserLastMonthAsync", "Revenue", null, new { @class = "text_link" })</div>
                            @*<div>@Html.ActionLink("Thêm mới chỉ tiêu", "CreateTarget", "Vcms", null, new { @class = "text_link" })</div>*@
                        </div>
                    </li>
                    <li data-id="3">
                        <a class="root"><i class="fal fa-user-crown icon"></i><span>Quyết định ưu đãi</span><i class="fas fa-caret-down"></i></a>
                        <div class="sub hidden">
                            <div>@Html.ActionLink("Danh sách QĐ ưu đãi", "ListDiscount", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Thêm mới QĐ ưu đãi", "CreateDiscount", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Thêm mới QĐ - Excel", "InsertDiscountExcel", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Cập nhật nhóm QĐ ưu đãi", "InsertGroupDiscountExcel", "Vcms", null, new { @class = "text_link" })</div>
                        </div>
                    </li>
                    <li data-id="4">
                        <a class="root"><i class="fal fa-file-edit icon"></i><span>Quản lý Đề xuất</span><i class="fas fa-caret-down"></i></a>
                        <div class="sub hidden">
                            <div>@Html.ActionLink("Thêm mới tổng hợp lỗi", "CreateTypeFault", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Thêm mới loại đề xuất", "CreateProposalType", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Sync vùng đề xuất", "SyncZoneProposal", "Vcms", null, new { @class = "text_link" })</div>
                        </div>
                    </li>
                    <li data-id="6">
                        <a class="root"><i class="fas fa-city icon"></i><span>Chi nhánh - Vùng</span><i class="fas fa-caret-down"></i></a>
                        <div class="sub hidden">
                            @*<div>@Html.ActionLink("Quản lý địa danh", "City", "Vcms", null, new { @class = "text_link" })</div>*@
                            <div>@Html.ActionLink("Danh sách chi nhánh", "ListOffice", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Thêm mới chi nhánh", "Office", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Thêm mới CN - Excel", "InsertOfficeExcel", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Danh sách chi nhánh theo tháng", "ListHistoryOffice", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Thêm mới - Cập nhật Vùng - Excel", "InsertZoneExcel", "Vcms", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Quản lý Vùng", "CreateZone", "Vcms", null, new { @class = "text_link" })</div>
                        </div>
                    </li>
                    <li data-id="7">
                        <a class="root"><i class="fa-solid fa-money-bill icon"></i><span>Quản lý Doanh thu</span><i class="fas fa-caret-down"></i></a>
                        <div class="sub hidden">
                            @*<div>@Html.ActionLink("Cập nhật xếp hạng chi nhánh", "RankOffice", "Revenue", null, new { @class = "text_link" })</div>*@
                            <div>@Html.ActionLink("Danh sách phiếu thu nguồn", "ListPhieuThuNguon", "Revenue", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Chỉ tiêu CN - NV", "TargetOffice", "Revenue", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Chỉ tiêu các NV đặc biệt - CN kèm theo", "TargetOffice2", "Revenue", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Phiếu thu đặc biệt", "PhieuThuTHDB", "Revenue", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Chỉ tiêu NVĐT theo tháng", "CreateTargetGroup", "Revenue", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Số ngày công các tháng trong năm ", "CreateWorkingDay", "Revenue", null, new { @class = "text_link" })</div>
                        </div>
                    </li>
                    <li data-id="8">
                        <a class="root"><i class="fa-solid fa-list icon"></i><span>Quản lý Danh mục</span><i class="fas fa-caret-down"></i></a>
                        <div class="sub hidden">
                            <div>@Html.ActionLink("Quy định chung", "Category", "Vcms", new { type = 1 }, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("QĐ PTS - Cả năm", "Category", "Vcms", new { type = 2 }, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("QĐ PTS - Hàng tháng", "Category", "Vcms", new { type = 3 }, new { @class = "text_link" })</div>
                        </div>
                    </li>
                    <li data-id="9">
                        <a class="root"><i class="fal fa-file-edit icon"></i><span>Quản lý Báo cáo</span><i class="fas fa-caret-down"></i></a>
                        <div class="sub hidden">
                            @*<div>@Html.ActionLink("Báo cáo KD CN - NV", "Report", "Report", null, new { @class = "text_link" })</div>*@
                            <div>@Html.ActionLink("Báo cáo - Lấy All dữ liệu theo Template", "ReportAllField", "Report", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Khóa số liệu", "CreateLockImport", "Report", null, new { @class = "text_link" })</div>
                        </div>
                    </li>
                    <li data-id="10">
                        <a class="root"><i class="fal fa-file-edit icon"></i><span>Đồng bộ cuộc gọi</span><i class="fas fa-caret-down"></i></a>
                        <div class="sub hidden">
                            @*<div>@Html.ActionLink("Đồng bộ CG hôm nay", "SyncToDay", "Vcms", null, new { @class = "text_link" })</div>*@
                            <div>@Html.ActionLink("Chuyển CG giữa các NS tháng", "SyncDuplicate", "Vcms", null, new { @class = "text_link" })</div>
                        </div>
                    </li>
                    <li data-id="11">
                        <a class="root"><i class="fal fa-file-edit icon"></i><span>Quản lý Quảng cáo</span><i class="fas fa-caret-down"></i></a>
                        <div class="sub hidden">
                            <div>@Html.ActionLink("Thêm mới quảng cáo", "Banner", "Banner", null, new { @class = "text_link" })</div>
                            <div>@Html.ActionLink("Danh sách quảng cáo", "ListBanner", "Banner", null, new { @class = "text_link" })</div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
        <div id="content_center_right">
            <div class="content_center_right">
                @RenderBody()
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery", "~/bundles/jqueryval", "~/bundles/jqueryui", "~/bundles/bootstrap")
    <script src="~/Scripts/multi-upload/jquery.iframe-transport.js"></script>
    <script src="~/Scripts/multi-upload/jquery.fileupload.js"></script>
    <script src="~/Scripts/ckeditor/ckeditor.js"></script>
    <script src="~/Scripts/ckeditor/adapters/jquery.js"></script>
    <script src="~/Scripts/jquery.toast.js"></script>
    <script src="~/Scripts/jquery.cookie.js"></script>
    <script src="~/Scripts/jquery.fancybox.min.js"></script>
    <script src="~/Scripts/webauthn-helper.js"></script>
    <script src="~/Scripts/select2.min.js"></script>
    <script src="~/Scripts/scriptAdmin.js"></script>
    @RenderSection("scripts", false)
</body>
</html>
