@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@using PagedList.Mvc
@model DebtViewModel
@{
    ViewBag.Title = "Danh sách công nợ";
}

<style>
    #OfficeId-error, #Month-error, #OfficeId-error {
        display: none !important;
    }
</style>
@*@Html.Action("Header", "TuyenSinh", new { name = "Danh sách công nợ" })*@
<div class="container py-3">
    @if (ViewBag.Result == "add")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Thêm mới thành công</strong></div>
    }
    else if (ViewBag.Result == "update")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
    }
    <form action="@Url.Action("ListDebt")" method="get" class="d-flex form-filter mb-5">
        <div class="row g-2 w-100">
            <div class="col-lg-2 col-md-3 col-6">
                <select name="Year" class="form-select" required">
                    <option value="">Chọn năm</option>
                    @for (int i = 2024; i <= DateTime.Now.Year; i++)
                    {
                        <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <select name="Month" class="form-select month-select" required>
                    <option value="">Chọn tháng</option>
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
                    }
                </select>
            </div>
            @if (Model.Zones?.Count() > 1)
            {
                <div class="col-lg-2 col-md-3 col-6">
                    <select name="ZoneId" class="form-select">
                        <option value="">Chọn vùng</option>
                        @foreach (var item in Model.Zones)
                        {
                            <option value="@item.Id" @(Model.ZoneId == item.Id ? "selected" : "")>@item.Name</option>
                        }
                    </select>
                </div>
            }
            @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.CV || !string.IsNullOrEmpty(Model.User.OfficeIds))
            {
                <div class="col-lg-2 col-md-3 col-6">
                    <select name="OfficeId" class="form-select">
                        <option>Chọn chi nhánh</option>
                        @foreach (var item in Model.Offices)
                        {
                            <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.ShortName</option>
                        }
                    </select>
                </div>
            }
            @if ((Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.EC || Model.User.TypeUser == TypeUser.SAB || Model.User.TypeUser == TypeUser.ALT) && string.IsNullOrEmpty(Model.User.OfficeIds))
            {
                <input type="hidden" value="@Model.OfficeId" name="OfficeId" />
            }
            <div class="col-lg-2 col-md-3 col-6">
                <select name="UserType" class="form-select">
                    <option value="">Tất cả chức danh</option>
                    <option value="3" @(Model.UserType == 3 ? "selected" : "")>BM</option>
                    <option value="4" @(Model.UserType == 4 ? "selected" : "")>EC</option>
                    <option value="5" @(Model.UserType == 5 ? "selected" : "")>ATL</option>
                    <option value="6" @(Model.UserType == 6 ? "selected" : "")>SAB</option>
                    <option value="7" @(Model.UserType == 7 ? "selected" : "")>CM</option>
                    <option value="9" @(Model.UserType == 9 ? "selected" : "")>TTL</option>
                </select>
            </div>
        </div>
    </form>
    <h2>DANH SÁCH CÔNG NỢ tháng @Model.Month - @Model.Year</h2>
    <a class="btn quick-link" href="@Url.Action("ExportDebt", new {Month = Model.Month,Year = Model.Year,OfficeId = Model.OfficeId,Active = 1,UserType = Model.UserType})"><i class="fa-regular fa-table me-1"></i>Xuất Excel</a>
    <div class="box_content">
        @*<a href=""><i class="fa-solid fa-arrows-rotate"></i></a>*@
        <table class="list_table table-striped">
            <tbody>
                <tr class="text-center">
                    <th rowspan="2">STT</th>
                    <th rowspan="2" class="col-w90">
                        Mã đơn hàng
                    </th>
                    <th rowspan="2" class="col-w90">
                        Ngày phát sinh cọc
                    </th>
                    <th rowspan="2" class="col-w150">
                        Chi nhánh
                    </th>
                    <th rowspan="2" class="col-w150">
                        Nhân sự
                    </th>
                    <th rowspan="2" class="col-w65">
                        Mã học viên
                    </th>
                    <th rowspan="2">
                        Lộ trình
                    </th>
                    <th rowspan="2" class="col-w150">
                        Các khoản tiền
                    </th>
                    <th rowspan="2" class="col-w65">
                        Công nợ <br />
                        phải thu
                    </th>
                    <th rowspan="2" class="col-w90">
                        Tình trạng <br /> khách hàng
                    </th>
                    <th colspan="3">Khó khăn của cọc</th>
                    <th rowspan="2"></th>
                    @*<th rowspan="2" class="col-w90">
                            Họ tên <br /> học viên
                        </th>*@
                    @*<th rowspan="2" class="col-w90">
                            Chương trình học
                        </th>
                        <th rowspan="2" class="col-w90">
                            Tên QĐ ưu đãi
                        </th>*@

                    @*<th rowspan="2" class="col-w90">
                            Hình thức thanh toán
                        </th>
                        <th rowspan="2" class="col-w90">
                            Kênh trả góp
                        </th>*@

                    @*@if (Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.BM)
                        {*@
                    @*}*@

                </tr>
                <tr class="text-center">
                    <th class="col-w90">Nội dung <br /> khó khăn</th>
                    <th class="col-w90">Tình trạng <br /> liên hệ khách</th>
                    <th class="col-w90">Hướng xử lý</th>
                </tr>
                @{
                    int stt = 1 + (Model.Debts.PageNumber - 1) * 15;
                }
                @foreach (var item in Model.Debts)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@item.MaDonHang</td>
                        <td>
                            @Html.DisplayFor(a => item.NgayLenDon)
                            @if (item.GrossDate != null)
                            {
                                <br /> <br />
                                @: Ngày phát sinh gộp phí: <br />
                                @Html.DisplayFor(a => item.GrossDate)
                            }
                        </td>
                        <td>@item.Office.ShortName</td>
                        <td>
                            <strong>Nhân sự phát sinh cọc:</strong> <br />
                            @item.UserOrigin.Fullname <br /> @item.UserOrigin.MaNhanVien <br /> <br />
                            <strong>Nhân sự phụ trách:</strong> <br />
                            @item.User.Fullname <br /> @item.User.MaNhanVien
                        </td>
                        <td>
                            @item.StudentCode
                            @if (item.StudentName != null)
                            {
                                <br />
                                @: @item.StudentName
                            }
                        </td>
                        <td>@item.Pathway</td>
                        <td>
                            <p class="mb-1">
                                <strong>Tổng tiền: </strong>  @Html.DisplayFor(a => item.TotalMoney)
                            </p>
                            <p class="mb-1">
                                <strong>Cọc: </strong> @Html.DisplayFor(a => item.DebtMoney)
                            </p>
                            <p class="mb-1">
                                <strong>Bổ sung phí: </strong> @Html.DisplayFor(a => item.DebtMoney2)
                            </p>
                            <p class="mb-1">
                                <strong>Còn thiếu: </strong> @Html.DisplayFor(a => item.RemainMoney)
                            </p>
                            <p class="mb-1">
                                <strong>Giảm lộ trình: </strong> @Html.DisplayFor(a => item.DownMoney)
                            </p>

                        </td>
                        <td>
                            @{
                                var dayNow = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
                                var dayLastMonth = dayNow.AddDays(-1);

                            }

                            @if (item.Month == dayLastMonth.Month && item.Year == dayLastMonth.Year)
                            {
                                <input type="checkbox" disabled checked value="" />
                            }
                            else
                            {
                                @Html.DisplayFor(a => item.PhaiThu)
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(a => item.TypeDebt)
                            @if (item.TypeDebt == TypeDebt.Type3)
                            {
                                if (item.DownPathways.Any())
                                {
                                    <div class="btnhistory-input">
                                        <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadHistoryDownPathway",  new{debtId = item.Id})"
                                           data-fancybox data-type="ajax" data-touch="false"><i class="fa-regular fa-files"></i></a>
                                    </div>
                                }

                                if (Model.User.TypeUser == TypeUser.BM)
                                {

                                    <div class="btnedit-input-debt">
                                        <a title="Cập nhật giảm lộ trình" href="@Url.Action("UpdateDownPathway", new {debtId = item.Id})"><i class="fa-regular fa-pen-to-square"></i></a>
                                    </div>

                                }
                            }
                            @if (item.FileStatus != null)
                            {
                                <br />
                                @item.FileStatus
                            }

                        </td>
                        <td>@item.HardContent</td>
                        <td>@item.ContactStatus</td>
                        <td>@item.HandleWay</td>
                        @if (Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.BM || Model.User.Id == item.UserId)
                        {
                            <td class="col-w65">
                                <a href="@Url.Action("UpdateDebt", new {id = item.Id})">Sửa</a>
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                    </tr>
                    stt++;
                }

            </tbody>

        </table>
    </div>

    @if (Model.Debts.PageCount > 1)
    {
        <div class="text-center">
            @if (Model.OfficeId != null)
            {
                @Html.PagedListPager(Model.Debts, page => Url.Action("ListDebt", new { page, zoneId = Model.ZoneId, OfficeId = Model.OfficeId, UserType = Model.UserType, month = Model.Month, year = Model.Year }))
            }
            else
            {
                @Html.PagedListPager(Model.Debts, page => Url.Action("ListDebt", new { page, zoneId = Model.ZoneId, UserType = Model.UserType, month = Model.Month, year = Model.Year }))
            }
        </div>
    }
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>

