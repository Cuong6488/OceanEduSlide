@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@model DebtViewModel
@{
    ViewBag.Title = "Danh sách công nợ";
}

<style>
    #OfficeId-error, #Month-error, #OfficeId-error {
        display: none !important;
    }
</style>
@*@Html.Action("Header", "TuyenSinh", new { name = "Danh sách công nợ" })*@
<div class="container py-3">
    @if (ViewBag.Result == "add")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
    }
    <form action="@Url.Action("ListDebt")" method="get" class="d-flex form-filter mb-5">
        <select name="Year" class="form-select me-3" required">
            <option value="">Chọn năm</option>
            @for (int i = 2024; i <= DateTime.Now.Year; i++)
            {
                <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
            }
        </select>
        <select name="Month" class="form-select me-3" required>
            <option value="">Chọn tháng</option>
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
            }
        </select>
        @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.CV)
        {
            <select name="ZoneId" class="form-select me-3" required>
                <option value="">Chọn vùng</option>
                @foreach (var item in Model.Zones)
                {
                    <option value="@item.Id" @(Model.ZoneId == item.Id ? "selected" : "")>@item.Name</option>
                }
            </select>
        }
        @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.CV)
        {
            <select name="OfficeId" class="form-select">
                <option value="">Chọn chi nhánh</option>
                @foreach (var item in Model.Offices)
                {
                    <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.Name</option>
                }
            </select>
        }
        @if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.EC || Model.User.TypeUser == TypeUser.SAB || Model.User.TypeUser == TypeUser.ALT)
        {
            <select name="" class="form-select" disabled>
                <option value="">Chọn chi nhánh</option>
                @foreach (var item in Model.Offices)
                {
                    <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.Name</option>
                }
            </select>
            <input type="hidden" value="@Model.OfficeId" name="OfficeId" />

        }
    </form>
    @if (Model.OfficeId != null)
    {
        <h2>DANH SÁCH CÔNG NỢ tháng @Model.Month - @Model.Year</h2>
        <div class="box_content mt-0">
            @*<a href=""><i class="fa-solid fa-arrows-rotate"></i></a>*@
            <table class="list_table tablecenter table-striped text-center">
                <tbody>
                    <tr>
                        <th rowspan="2">STT</th>
                        <th rowspan="2" class="col-w90">
                            Ngày phát sinh cọc
                        </th>
                        <th rowspan="2" class="col-w90">
                            Họ tên <br /> học viên
                        </th>
                        <th rowspan="2" class="col-w65">
                            Mã học viên
                        </th>
                        <th rowspan="2" class="col-w90">
                            Chương trình học
                        </th>
                        <th rowspan="2" class="col-w90">
                            Tên QĐ ưu đãi
                        </th>
                        <th rowspan="2">
                            Lộ trình
                        </th>
                        <th rowspan="2" class="col-w90">
                            Thành tiền
                        </th>
                        <th rowspan="2" class="col-w90">
                            Tiền cọc <br /> giữ chỗ
                        </th>
                        <th rowspan="2" class="col-w90">
                            Tiền cọc <br /> bổ sung <br /> làm hồ sơ
                        </th>
                        <th rowspan="2" class="col-w90">
                            Loại cọc
                        </th>
                        <th rowspan="2" class="col-w90">
                            Tiền giảm <br /> lộ trình
                        </th>
                        <th rowspan="2" class="col-w90">
                            Tiền còn lại phải thanh toán
                        </th>
                        <th rowspan="2" class="col-w90">
                            Hình thức thanh toán
                        </th>
                        <th rowspan="2" class="col-w90">
                            Kênh trả góp
                        </th>
                        <th rowspan="2" class="col-w65">
                            Tình trạng hồ sơ
                        </th>
                        <th rowspan="2" class="col-w90">
                            Ngày phát sinh gộp phí
                        </th>
                        <th rowspan="2" class="col-w90">
                            NS phụ trách
                        </th>
                        <th colspan="3">Khó khăn của cọc</th>
                        @if (Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.BM)
                        {
                            <th rowspan="2"></th>
                        }

                    </tr>
                    <tr>
                        <th class="col-w90">Nội dung <br /> khó khăn</th>
                        <th class="col-w90">Tình trạng <br /> liên hệ khách</th>
                        <th class="col-w90">Hướng xử lý</th>
                    </tr>
                    @if (Model.Debts != null)
                    {
                        int stt = 1;
                        foreach (var item in Model.Debts)
                        {
                            <tr>
                                <td>@stt</td>
                                <td>@Html.DisplayFor(a => item.DepositDate)</td>
                                <td>@item.StudentName</td>
                                <td>@item.StudentCode</td>
                                <td>@item.Cth</td>
                                <td>@item.DiscountName</td>
                                <td>@item.Pathway.ToString("N1")</td>
                                <td>@Html.DisplayFor(a => item.TotalMoney)</td>
                                <td>@Html.DisplayFor(a => item.DebtMoney)</td>
                                <td>@Html.DisplayFor(a => item.DebtMoney2)</td>
                                <td>
                                    @Html.DisplayFor(a => item.TypeDebt)
                                    @if (item.TypeDebt == TypeDebt.Type3)
                                    {
                                        if (item.DownPathways.Any())
                                        {
                                            <div class="btnhistory-input">
                                                <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadHistoryDownPathway",  new{debtId = item.Id})"
                                                   data-fancybox data-type="ajax" data-touch="false"><i class="fa-regular fa-files"></i></a>
                                            </div>
                                        }

                                        if (Model.User.TypeUser == TypeUser.BM)
                                        {

                                            <div class="btnedit-input-debt">
                                                <a title="Cập nhật giảm lộ trình" href="@Url.Action("UpdateDownPathway", new {debtId = item.Id})"><i class="fa-regular fa-pen-to-square"></i></a>
                                            </div>

                                        }
                                    }

                                </td>
                                <td>@Html.DisplayFor(a => item.DownMoney)</td>
                                <td>@Html.DisplayFor(a => item.RemainMoney)</td>
                                <td>@Html.DisplayFor(a => item.TypePay)</td>
                                <td>@Html.DisplayFor(a => item.ChannelPay)</td>
                                <td>@Html.DisplayFor(a => item.FileStatus)</td>
                                <td>@Html.DisplayFor(a => item.GrossDate)</td>
                                <td>@(item.User.Fullname??item.User.Username)</td>
                                <td>@item.HardContent</td>
                                <td>@item.ContactStatus</td>
                                <td>@item.HandleWay</td>
                                @if (Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.BM)
                                {
                                    <td><a href="@Url.Action("UpdateDebt", new {id = item.Id})">Sửa</a></td>
                                }

                            </tr>
                            stt++;
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>

}