@model OceanEduSlide.ViewModels.InsertDebtViewModel
@{
    ViewBag.Title = "Cập nhật công nợ";
}
@*@Html.Action("Header", "TuyenSinh", new { name = "Sự kiện" })*@
<div class="container py-3">
    <h2 class="mb-3">Cập nhật công nợ</h2>
    <a class="btn quick-link" href="@Url.Action("ListDebt", new {month = Model.Debt.Month,year = Model.Debt.Year,officeId = Model.Debt.User.OfficeId})"><i class="far fa-list me-1"></i> Danh sách công nợ</a>
    <div class="box_content">
        @using (Html.BeginForm("UpdateDebt", "Event", FormMethod.Post))
        {
            @Html.ValidationSummary(true)
        <table class="form_table">
            @Html.HiddenFor(a => a.Debt.DebtId)
            @Html.HiddenFor(a => a.Debt.UserId)
            <tr>
                <td class="form_name w-25">Nhân sự phụ trách</td>
                <td class="form_text"> @Html.DisplayFor(model => model.Debt.User.Fullname)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.User.MaNhanVien)</td>
                <td class="form_text"> @Html.DisplayFor(model => model.Debt.User.MaNhanVien)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.DepositDate)</td>
                <td class="form_text">
                    @Html.TextBoxFor(model => model.Debt.DepositDate, new { @class = "date-picker w100" })
                    @Html.ValidationMessageFor(model => model.Debt.DepositDate)
                </td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.GrossDate)</td>
                <td class="form_text">
                    @Html.TextBoxFor(model => model.Debt.GrossDate, new { @class = "date-picker w100" })
                    @Html.ValidationMessageFor(model => model.Debt.GrossDate)
                </td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.StudentName)</td>
                <td class="form_text"> @Html.TextBoxFor(model => model.Debt.StudentName)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.StudentCode)</td>
                <td class="form_text"> @Html.TextBoxFor(model => model.Debt.StudentCode)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.Cth)</td>
                <td class="form_text">
                    <select name="Debt.Cth" class="form_control">
                        <option value="" disabled selected>Chọn chương trình học</option>
                        <option @(Model.Debt.Cth == "Anh văn nhi đồng" ? "selected" : "") value="Anh văn nhi đồng">Anh văn nhi đồng</option>
                        <option @(Model.Debt.Cth == "Anh văn thiếu nhi" ? "selected" : "") value="Anh văn thiếu nhi">Anh văn thiếu nhi</option>
                        <option @(Model.Debt.Cth == "T.A học thuật Trung học" ? "selected" : "") value="T.A học thuật Trung học">T.A học thuật Trung học</option>
                        <option @(Model.Debt.Cth == "Luyện thi IELTS" ? "selected" : "") value="Luyện thi IELTS">Luyện thi IELTS</option>
                        <option @(Model.Debt.Cth == "T.A giao tiếp quốc tế TOEIC" ? "selected" : "") value="T.A giao tiếp quốc tế TOEIC">T.A giao tiếp quốc tế TOEIC</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.DiscountName)</td>
                <td class="form_text"> @Html.TextBoxFor(model => model.Debt.DiscountName)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.Pathway)</td>
                <td class="form_text"> @Html.TextBoxFor(model => model.Debt.Pathway, new { @class = "w100" })</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.TotalMoney)</td>
                <td class="form_text"> @Html.EditorFor(model => model.TotalMoney)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.DebtMoney)</td>
                <td class="form_text">@Html.EditorFor(model => model.DebtMoney)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.DebtMoney2)</td>
                <td class="form_text">@Html.EditorFor(model => model.DebtMoney2)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.DownMoney)</td>
                <td class="form_text">@Html.EditorFor(model => model.DownMoney)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.TypeDebt)</td>
                <td class="form_text">
                    @Html.EnumDropDownListFor(model => model.Debt.TypeDebt, "Chọn loại cọc", new { @class = "form_control" })
                    @Html.ValidationMessageFor(model => model.Debt.TypeDebt)
                </td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.TypePay)</td>
                <td class="form_text">
                    @Html.EnumDropDownListFor(model => model.Debt.TypePay, "Chọn hình thức thanh toán", new { @class = "form_control" })
                    @Html.ValidationMessageFor(model => model.Debt.TypePay)
                </td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Debt.ChannelPay)</td>
                <td class="form_text">
                    @Html.EnumDropDownListFor(model => model.Debt.ChannelPay, "Chọn kênh trả góp", new { @class = "form_control" })
                    @Html.ValidationMessageFor(model => model.Debt.ChannelPay)
                </td>
            </tr>
            <tr>
                <td class="form_name">@Html.LabelFor(model => model.Debt.HardContent)</td>
                <td class="form_text">
                    @Html.EditorFor(model => model.Debt.HardContent)
                </td>
            </tr>
            <tr>
                <td class="form_name">@Html.LabelFor(model => model.Debt.ContactStatus)</td>
                <td class="form_text">
                    @Html.EditorFor(model => model.Debt.ContactStatus)
                </td>
            </tr>
            <tr>
                <td class="form_name">@Html.LabelFor(model => model.Debt.HandleWay)</td>
                <td class="form_text">
                    @Html.EditorFor(model => model.Debt.HandleWay)
                </td>
            </tr>
            <tr>
                <td class="form_name"></td>
                <td class="form_text">
                    <input type="submit" class="btn quick-link" value="Cập nhật" />
                </td>
            </tr>

        </table>
        }
    </div>
</div>
@section scripts
{
    @*<script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>*@
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
    <script>
        var today = new Date();
        $(".date-picker").datepicker({
            dateFormat: "dd/mm/yy",
            yearRange: "1900:2100",
            maxDate: today,
        });
        $(".input-number").maskMoney({
            precision: 0,
            thousands: ',',
            affixesStay: false
        });
    </script>

}