@model OceanEduSlide.ViewModels.LoadHistoryRevenueUser_DayViewModel
<div class="box_content">
    <h2>Lịch sử cập nhật chỉ tiêu DS @Html.DisplayFor(a => a.DayofWeek) - @Html.DisplayFor(a => a.WeekNumber) - tháng @Model.Month - @Model.Year của nhân sự @(Model.User.Fullname ?? Model.User.Username)</h2>
    <table class="list_table tablecenter table-striped">
        <tbody>
            <tr>
                <th style="text-align:center">Thời gian cập nhật</th>
                <th style="text-align: center">Chỉ tiêu doanh số dự kiến hoàn thành</th>
            </tr>
            @foreach (var item in Model.Revenues)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(a => item.CreateDate)
                    </td>
                    <td class=" col-w200" style="padding:10px 15px !important">
                        @*Chỉ tiêu doanh số dự kiến hoàn thành:*@ <strong>@Html.DisplayFor(a => item.TargetBM)</strong> @*<br />*@
                        @*SL KH check in dự kiến: <strong>@Html.DisplayFor(a => item.CI)</strong><br />
                        @if (item.User.Confirm3 > 0)
                        {
                            @:Sl KH confiem lần thứ 3: <strong>@Html.DisplayFor(a => item.Confirm3)</strong> <br />
                        }

                        SL KH confirm lần thứ 2: <strong>@Html.DisplayFor(a => item.Confirm2)</strong> <br />
                        SL KH confirm lần thứ nhất: <strong>@Html.DisplayFor(a => item.Confirm1)</strong> <br />
                        SL data cần khai thác: : <strong>@Html.DisplayFor(a => item.DataQuantity)</strong>*@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>