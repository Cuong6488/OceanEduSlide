                                                if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
                                                {
                                                    <a class="text-danger" href="@Url.Action("AddEvent",new{month = Model.Month,year = Model.Year,officeId = Model.OfficeId,week = Model.Week,dayofWeek = i,typeEvent = j})">Cập nhật</a>
                                                }
                                            }
                                        </td>
                                    }

                                }
                            </tr>
                        }
