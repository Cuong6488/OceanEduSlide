@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@model EventViewModel
    @{ 
        ViewBag.Title = "Sự kiện";
    }

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css">
<style>
    #OfficeId-error, #Month-error, #OfficeId-error, #Week-error {
        display: none !important;
    }
</style>
@Html.Action("Header", "TuyenSinh", new { name = "Sự kiện" })
<div class="container py-3">
    @if (ViewBag.Result == "add")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
    }
    <form action="@Url.Action("Index")" method="get" class="d-flex form-filter mb-5">
        <select name="Year" class="form-select me-3" required">
            <option value="">Chọn năm</option>
            @for (int i = 2025; i <= ViewBag.Year + 1; i++)
            {
                <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
            }
        </select>
        <select name="Month" class="form-select me-3" required>
            <option value="">Chọn tháng</option>
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
            }
        </select>
        <select name="Week" class="form-select me-3" required>
            <option value="">Chọn tuần</option>
            @for (int i = 1; i <= ViewBag.WorkingWeeks; i++)
            {
                <option value="@i" @(Model.Week == i ? "selected" : "")>Tuần @i</option>
            }
        </select>
        @if (Model.User.TypeUser == TypeUser.HO)
        {
            <select name="OfficeId" class="form-select" required>
                <option value="">Chọn chi nhánh</option>
                @foreach (var item in Model.Offices)
                {
                    <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.Name</option>
                }
            </select>
        }
        @if (Model.User.TypeUser == TypeUser.BM)
        {
            <select name="" class="form-select" disabled>
                <option value="">Chọn chi nhánh</option>
                @foreach (var item in Model.Offices)
                {
                    <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.Name</option>
                }
            </select>
            <input type="hidden" value="@Model.OfficeId" name="OfficeId" />
        }
    </form>
    @if (Model.OfficeId != null)
    {
        <h2>KẾ HOẠCH TUẦN @Model.Week - Tháng @Model.Month - @Model.Year DỰ KIẾN</h2>
        <div class="box_content mt-0 mb-5">

            <a href=""><i class="fa-solid fa-arrows-rotate"></i></a>
            <table class="list_table tablecenter table-striped text-center">
                <tbody>
                    <tr>
                        <th style="min-width:150px;">Loại hoạt động</th>
                        @if (ViewBag.WorkingWeeks != Model.Week)
                        {
                            for (int i = 9 - ViewBag.DayOfWeeks; i <= 8; i++)
                            {
                                <th>@(i == 8? "Chủ nhật": "Thứ " + i)</th>
                            }
                        }
                        else
                        {
                            for (int i = 2; i <= 1 + ViewBag.DayOfWeeks; i++)
                            {
                                <th>@(i == 8? "Chủ nhật": "Thứ " + i)</th>
                            }

                        }
                    </tr>
                    @if (Model.Events != null)
                    {
                        for (int j = 1; j <= 4; j++)
                        {
                            <tr data-event="@j">
                                <td class="text-start px-2">
                                    @switch (j)
                                    {
                                        case 1:
                                            @: Hoạt động của đào tạo
                                            break;
                                        case 2:
                                            @: Sự kiện của Đào tạo
                                            break;
                                        case 3:
                                            @: Hoạt động của sale
                                            break;
                                        case 4:
                                            @: Sự kiện của sale
                                            break;
                                        default:
                                            break;
                                    }

                                </td>
                                @if (ViewBag.WorkingWeeks != Model.Week)
                                {
                                    for (int i = 9 - ViewBag.DayOfWeeks; i <= 8; i++)
                                    {
                                        var ev = Model.Events.FirstOrDefault(a => (int)a.DayofWeek == i && (int)a.TypeEvent == j);
                                        <td class="text-start col-w200" style="padding:10px 15px !important">
                                            @if (ev != null)
                                            {
                                                @: @Html.LabelFor(a => ev.Name): @ev.Name <br />
                                                @: @Html.LabelFor(a => ev.TypeJoin): @Html.DisplayFor(a => ev.TypeJoin) <br />
                                                @: @Html.LabelFor(a => ev.Ages): @ev.Ages <br />
                                                @: @Html.LabelFor(a => ev.Range): @ev.Range <br />
                                                @: Thời gian tổ chức: @ev.TimeFrom - @ev.TimeTo <br />
                                                if (ev.LinkUrl != null)
                                                {
                                                    <a class="mt-1 d-inline-block" href="@ev.LinkUrl" target="_blank">@(ev.LinkName??"Link")</a>
                                                }
                                                if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
                                                {
                                                    <a class="mt-2 d-inline-block" href="@Url.Action("UpdateEvent", new{evId = ev.Id})">Cập nhật</a>
                                                }

                                            }
                                            else
                                            {
                                                if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
                                                {
                                                    <a href="@Url.Action("AddEvent",new{month = Model.Month,year = Model.Year,officeId = Model.OfficeId,week = Model.Week,dayofWeek = i,typeEvent = j})">Cập nhật</a>
                                                }
                                            }
                                        </td>
                                    }
                                }
                                else
                                {
                                    for (int i = 2; i <= 1 + ViewBag.DayOfWeeks; i++)
                                    {
                                        var ev = Model.Events.FirstOrDefault(a => (int)a.DayofWeek == i && (int)a.TypeEvent == j);
                                        <td>
                                            @if (ev != null)
                                            {
                                                @: @Html.LabelFor(a => ev.Name): @ev.Name <br />
                                                @: @Html.LabelFor(a => ev.TypeJoin): @Html.DisplayFor(a => ev.TypeJoin) <br />
                                                @: @Html.LabelFor(a => ev.Ages): @ev.Ages <br />
                                                @: @Html.LabelFor(a => ev.Range): @ev.Range <br />
                                                @: Thời gian tổ chức: @ev.TimeFrom - @ev.TimeTo <br />
                                                if (ev.LinkUrl != null)
                                                {
                                                    <a class="mt-1 d-inline-block" href="@ev.LinkUrl" target="_blank">@(ev.LinkName??"Link")</a>
                                                }
                                                if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
                                                {
                                                    <a class="mt-2 d-inline-block" href="@Url.Action("UpdateEvent", new{evId = ev.Id})">Cập nhật</a>
                                                }

                                            }
                                            else
                                            {
                                                if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
                                                {
                                                    <a href="@Url.Action("AddEvent",new{month = Model.Month,year = Model.Year,officeId = Model.OfficeId,week = Model.Week,dayofWeek = i,typeEvent = j})">Cập nhật</a>
                                                }
                                            }
                                        </td>
                                    }

                                }
                            </tr>
                        }
                        <tr>
                            <td class="text-start px-2">Doanh số tuyển sinh</td>
                            @if (ViewBag.WorkingWeeks != Model.Week)
                            {
                                for (int i = 9 - ViewBag.DayOfWeeks; i <= 8; i++)
                                {
                                    <td class="text-start" style="padding:10px 15px !important">
                                        @((Model.SumRevenue(i)??0).ToString("N0"))đ
                                    </td>
                                }
                            }
                            else
                            {
                                for (int i = 2; i <= 1 + ViewBag.DayOfWeeks; i++)
                                {
                                    <td class="text-start" style="padding:10px 15px !important">
                                        @Model.SumRevenue(i)
                                    </td>
                                }

                            }
                        </tr>
                        if (Model.UserItems != null)
                        {
                            foreach (var item in Model.UserItems)
                            {
                                <tr>
                                    <td class="text-start px-2">
                                        @(item.User.Fullname ?? item.User.Username) @(item.User.MaNhanVien != null? " - "+  @item.User.MaNhanVien:"")
                                    </td>
                                    @if (ViewBag.WorkingWeeks != Model.Week)
                                    {
                                        for (int i = 9 - ViewBag.DayOfWeeks; i <= 8; i++)
                                        {
                                            var revenueUser_Day = item.Revenues.FirstOrDefault(a => (int)a.DayofWeek == i);
                                            if (revenueUser_Day != null)
                                            {
                                                <td class="text-start col-w200" style="padding:10px 15px !important">
                                                    <div class="btnhistory-input">
                                                        <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadHistoryRevenueUser_Day",  new{month = Model.Month,year = Model.Year,userId = item.User.Id,weekNumber = Model.Week,dayofWeek = i})"
                                                           data-fancybox data-type="ajax" data-touch="false"><i class="fa-regular fa-files"></i></a>
                                                    </div>
                                                    Chỉ tiêu doanh số dự kiến hoàn thành: <strong>@Html.DisplayFor(a => revenueUser_Day.TargetBM)</strong> <br />
                                                    SL KH check in dự kiến: <strong>@Html.DisplayFor(a => revenueUser_Day.CI)</strong><br />
                                                    @if (revenueUser_Day.User.Confirm3 > 0)
                                                    {
                                                        @:Sl KH confiem lần thứ 3: <strong>@Html.DisplayFor(a => revenueUser_Day.Confirm3)</strong> <br />
                                                    }

                                                    SL KH confirm lần thứ 2: <strong>@Html.DisplayFor(a => revenueUser_Day.Confirm2)</strong> <br />
                                                    SL KH confirm lần thứ nhất: <strong>@Html.DisplayFor(a => revenueUser_Day.Confirm1)</strong> <br />
                                                    SL data cần khai thác: : <strong>@Html.DisplayFor(a => revenueUser_Day.DataQuantity)</strong>
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="col-w65">
                                                </td>
                                            }

                                        }
                                    }
                                    else
                                    {
                                        for (int i = 2; i <= 1 + ViewBag.DayOfWeeks; i++)
                                        {
                                            var revenueUser_Day = item.Revenues.FirstOrDefault(a => (int)a.DayofWeek == i);
                                            if (revenueUser_Day != null)
                                            {
                                                <td class="text-start" style="padding:10px 15px !important">
                                                    <div class="btnhistory-input">
                                                        <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadHistoryRevenueUser_Day",  new{month = Model.Month,year = Model.Year,userId = item.User.Id,weekNumber = Model.Week,dayofWeek = i})"
                                                           data-fancybox data-type="ajax" data-touch="false"><i class="fa-regular fa-files"></i></a>
                                                    </div>
                                                    Chỉ tiêu doanh số dự kiến hoàn thành: @revenueUser_Day.TargetBM <br />
                                                    SL KH check in dự kiến: @revenueUser_Day.CI <br />
                                                    @if (revenueUser_Day.User.Confirm3 > 0)
                                                    {
                                                        @:Sl KH confiem lần thứ 3: @revenueUser_Day.Confirm3 <br />
                                                    }

                                                    SL KH confirm lần thứ 2: @revenueUser_Day.Confirm2 <br />
                                                    SL KH confirm lần thứ nhất: @revenueUser_Day.Confirm1 <br />
                                                    SL data cần khai thác: : @revenueUser_Day.DataQuantity
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="col-w65">
                                                </td>
                                            }
                                        }

                                    }

                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
