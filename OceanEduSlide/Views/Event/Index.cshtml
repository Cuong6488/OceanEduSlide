                                                        <a title="Chỉnh sửa" href="javascript:;"><i class="fa-regular fa-pen-to-square"></i></a>
                                                    </div>


                                                }
                                                <input type="text" class="m-0 input-number input-noborder input-RevenueUser_Day hidden" value=" @(revenueUser_Day.TargetBM?.ToString("N0"))" />
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="day-target col-w90">
                                                <input class="input-DayOfWeek" type="hidden" name="DayOfWeek" value="@i" />
                                                @if (Model.User.TypeUser == TypeUser.BM && ViewBag.CurrentWeek <= Model.Week && Model.Month >= DateTime.Now.Month && Model.Year >= DateTime.Now.Year)
                                                {
                                                    <div class="revenue-value hidden">

                                                    </div>
                                                    <div class="btnedit-input hidden">
                                                        <i class="fa-regular fa-pen-to-square"></i>
                                                    </div>
                                                    <input type="text" class="m-0 input-number input-noborder input-RevenueUser_Day" />
                                                }
                                            </td>
                                        }
                                        if (revenueUser_Day2 != null)
                                        {
                                            <td class="day-target-number">
                                                <input class="input-DayOfWeek" type="hidden" name="DayOfWeek" value="@i" />
                                                @*<div class="btnhistory-input">
                                                        <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadHistoryRevenueUser_Day2",  new{month = Model.Month,year = Model.Year,userId = item.User.Id,weekNumber = Model.Week,dayofWeek = i})"
                                                           data-fancybox data-type="ajax" data-touch="false"><i class="fa-regular fa-files"></i></a>
                                                    </div>*@
                                                <div class="revenue-value">
                                                    @(revenueUser_Day2.DT?.ToString("N0"))
                                                </div>
                                                @if (Model.User.TypeUser == TypeUser.BM && ViewBag.CurrentWeek <= Model.Week && Model.Month >= DateTime.Now.Month && Model.Year >= DateTime.Now.Year)
                                                {
                                                    {
                                                        <div class="btnedit-input btn-edit-day">
                                                            <a title="Chỉnh sửa" href="javascript:;"><i class="fa-regular fa-pen-to-square"></i></a>
                                                        </div>
                                                    }

                                                }
                                                <input type="number" min="0" class="m-0 input-noborder input-RevenueUser_Day_DT hidden" value="@(revenueUser_Day2.DT?.ToString("N0"))" />
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="day-target-number">
                                                <input class="input-DayOfWeek" type="hidden" name="DayOfWeek" value="@i" />
                                                @if (Model.User.TypeUser == TypeUser.BM && ViewBag.CurrentWeek <= Model.Week && Model.Month >= DateTime.Now.Month && Model.Year >= DateTime.Now.Year)
