                                                    </div>
                                                    <input type="number" min="0" class="m-0 input-noborder input-RevenueUser_Day_DT" />
                                                }
                                            </td>
                                        }

                                    }
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <h2>BẢNG THEO DÕI TỶ LỆ CHUYỂN ĐỔI CỦA NHÂN SỰ</h2>
        <div class="box_content mt-0">
            <table class="list_table tablecenter table-striped">
                <tbody>
                    <tr>
                        <th rowspan="2" class="col-w90">Họ tên nhân sự</th>
                        <th rowspan="2" style="width: 70px">Chức vụ</th>
                        <th rowspan="2" class="col-w90">Mã nhân viên</th>
                        <th colspan="6" class="text-center">Tỉ lệ chuyển đổi</th>
                        @if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
                        {
                            <th rowspan="2"></th>
                        }
                    </tr>
                    <tr>
                        <th>Tỉ lệ SL data confirm lần 1 (%)</th>
                        <th>Tỉ lệ SL data confirm lần 2 (%)</th>
                        <th>Tỉ lệ SL data confirm lần 3 (%)</th>
                        <th>Tỉ lệ SL KH chuyển đổi CI (%)</th>
                        <th>Tỉ lệ SL KH chuyển đổi ra cọc/DT (%)</th>
                        <th>Doanh thu trung bình mỗi khách hàng (đ)</th>
                    </tr>
                    @if (Model.Users != null)
                    {
                        foreach (var item in Model.Users)
                        {
                            <tr data-id="@item.Id">
                                <td>
                                    @(item.Fullname??item.Username)
                                </td>
                                <td>
                                    @Html.DisplayFor(a => item.TypeUser)
                                </td>
                                <td>
                                    @item.MaNhanVien
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.Confirm1)<br />
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.Confirm2)<br />
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.Confirm3)<br />
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.CI)<br />
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.DT)<br />
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.RevenueAverage)<br />
                                </td>
                                @if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
                                {
                                    <td>
                                        <a href="@Url.Action("UpdatePercent", new {userId = item.Id})">Sửa</a>
                                    </td>
                                }
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>


    }
