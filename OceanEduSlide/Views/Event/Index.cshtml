                                                            <a title="Chỉnh sửa" href="javascript:;"><i class="fa-regular fa-pen-to-square"></i></a>
                                                        </div>
                                                    }

                                                }
                                                <input type="text" class="m-0 input-number input-noborder input-RevenueUser_Day hidden" value=" @(revenueUser_Day.TargetBM.ToString("N0"))" />
                                            </td>
                                            <td class="day-target-number">
                                                <input class="input-DayOfWeek" type="hidden" name="DayOfWeek" value="@i" />
                                                <div class="btnhistory-input">
                                                    <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadHistoryRevenueUser_Day",  new{month = Model.Month,year = Model.Year,userId = item.User.Id,weekNumber = Model.Week,dayofWeek = i})"
                                                       data-fancybox data-type="ajax" data-touch="false"><i class="fa-regular fa-files"></i></a>
                                                </div>
                                                <div class="revenue-value">
                                                    @(revenueUser_Day.DT.ToString("N0"))
                                                </div>
                                                @if (Model.User.TypeUser == TypeUser.BM && ViewBag.CurrentWeek <= Model.Week && Model.Month >= DateTime.Now.Month && Model.Year >= DateTime.Now.Year)
                                                {
                                                    {
                                                        <div class="btnedit-input btn-edit-day">
                                                            <a title="Chỉnh sửa" href="javascript:;"><i class="fa-regular fa-pen-to-square"></i></a>
                                                        </div>
                                                    }

                                                }
                                                <input type="number" min="0" class="m-0 input-noborder input-RevenueUser_Day_DT hidden" value="@(revenueUser_Day.DT.ToString("N0"))" />
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="day-target day-@i">
                                                <input class="input-DayOfWeek" type="hidden" name="DayOfWeek" value="@i" />
                                                @if (Model.User.TypeUser == TypeUser.BM && ViewBag.CurrentWeek <= Model.Week && Model.Month >= DateTime.Now.Month && Model.Year >= DateTime.Now.Year)
                                                {
                                                    <div class="revenue-value hidden">

                                                    </div>
                                                    <div class="btnedit-input hidden">
                                                        <i class="fa-regular fa-pen-to-square"></i>
                                                    </div>
                                                    <input type="text" class="m-0 input-number input-noborder input-RevenueUser_Day" />
                                                }
                                            </td>
                                            <td class="day-target-number">
                                                <input class="input-DayOfWeek" type="hidden" name="DayOfWeek" value="@i" />
                                                @if (Model.User.TypeUser == TypeUser.BM && ViewBag.CurrentWeek <= Model.Week && Model.Month >= DateTime.Now.Month && Model.Year >= DateTime.Now.Year)
                                                {
                                                    <div class="revenue-value hidden">

                                                    </div>
                                                    <div class="btnedit-input hidden">
                                                        <i class="fa-regular fa-pen-to-square"></i>
                                                    </div>
                                                    <input type="number" min="0" class="m-0 input-noborder input-RevenueUser_Day_DT" />
                                                }
                                            </td>
                                        }
                                    }

                                }

                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <h2>BẢNG THEO DÕI TỶ LỆ CHUYỂN ĐỔI CỦA NHÂN SỰ CHI NHÁNH</h2>
        <div class="box_content mt-0">
            <table class="list_table tablecenter table-striped">
                <tbody>
                    <tr>
                        <th rowspan="2" class="col-w90">Họ tên nhân sự</th>
                        <th rowspan="2" style="width: 70px">Chức vụ</th>
                        <th rowspan="2" class="col-w90">Mã nhân viên</th>
                        <th colspan="6" class="text-center">Tỉ lệ chuyển đổi</th>
                        @if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
                        {
                            <th rowspan="2"></th>
                        }
                    </tr>
                    <tr>
                        <th>Tỉ lệ SL data confirm lần 1 (%)</th>
                        <th>Tỉ lệ SL data confirm lần 2 (%)</th>
                        <th>Tỉ lệ SL data confirm lần 3 (%)</th>
                        <th>Tỉ lệ SL KH chuyển đổi CI (%)</th>
                        <th>Tỉ lệ SL KH chuyển đổi ra cọc/DT (%)</th>
                        <th>Doanh thu trung bình mỗi khách hàng (đ)</th>
                    </tr>
                    @if (Model.Users != null)
                    {
                        foreach (var item in Model.Users)
                        {
                            <tr data-id="@item.Id">
                                <td>
                                    @(item.Fullname??item.Username)
                                </td>
                                <td>
                                    @Html.DisplayFor(a => item.TypeUser)
                                </td>
                                <td>
                                    @item.MaNhanVien
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.Confirm1)<br />
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.Confirm2)<br />
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.Confirm3)<br />
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.CI)<br />
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.DT)<br />
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.RevenueAverage)<br />
                                </td>
                                @if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
                                {
                                    <td>
                                        <a href="@Url.Action("UpdatePercent", new {userId = item.Id})">Sửa</a>
                                    </td>
                                }
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>


    }
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
    <script>
        flatpickr("#timepicker", {
            enableTime: true,
            noCalendar: true,
            dateFormat: "H:i",
            time_24hr: true
        });

    </script>
}