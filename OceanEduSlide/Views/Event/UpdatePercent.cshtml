@using OceanEduSlide.ViewModels
@model UpdatePercentViewModel
@{
    ViewBag.Title = "Cập nhật tỉ lệ chuyển đổi";
}
@Html.Action("Header", "TuyenSinh", new { name = "Sự kiện" })
<div class="container py-3">
    <h2 class="">Cập nhật tỉ lệ chuyển đổi</h2>
    <a class="btn quick-link" href="#list-percent"><i class="far fa-list me-1"></i> Danh sách tỉ lệ chuyển đổi</a>
    <div class="box_content px-5 mb-5">
        @using (Html.BeginForm())
        {
            @Html.ValidationSummary(true)
            <table class="form_table">
                <tbody>
                    <tr>
                        <td class="form-name w-25">Nhân sự</td>
                        <td class="form_text">
                            <strong>@Model.Fullname</strong>
                        </td>
                    </tr>
                    @Html.HiddenFor(a => a.UserId)
                    <tr>
                        <td class="form-name">@Html.LabelFor(model => model.CF1)</td>
                        <td class="form_text">
                            @Html.TextBoxFor(model => model.CF1, new { @class = "form_control form-name", @type = "number" })
                            @Html.ValidationMessageFor(model => model.CF1)
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name">@Html.LabelFor(model => model.CF2)</td>
                        <td class="form_text">
                            @Html.TextBoxFor(model => model.CF2, new { @class = "form_control form-name", @type = "number" })
                            @Html.ValidationMessageFor(model => model.CF2)
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name">@Html.LabelFor(model => model.CF3)</td>
                        <td class="form_text">
                            @Html.TextBoxFor(model => model.CF3, new { @class = "form_control form-name", @type = "number" })
                            @Html.ValidationMessageFor(model => model.CF3)
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name">@Html.LabelFor(model => model.CI)</td>
                        <td class="form_text">
                            @Html.TextBoxFor(model => model.CI, new { @class = "form_control form-name", @type = "number" })
                            @Html.ValidationMessageFor(model => model.CI)
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name">@Html.LabelFor(model => model.DT)</td>
                        <td class="form_text">
                            @Html.TextBoxFor(model => model.DT, new { @class = "form_control form-name", @type = "number" })
                            @Html.ValidationMessageFor(model => model.DT)
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name"></td>
                        <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Cập nhật"></td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
</div>
