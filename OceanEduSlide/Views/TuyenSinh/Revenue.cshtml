@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@model RevenueViewModel
@{
    ViewBag.Title = "Phân bổ doanh số";
}
<style>
    #OfficeId-error, #Month-error, #OfficeId-error, #ZoneId-error {
        display: none !important;
    }
</style>

<input type="hidden" name="CurrentWeek" value="@ViewBag.CurrentWeek" />
@*@Html.Action("Header", new { name = "Kinh doanh/ Phân bổ doanh số" })*@
<div class="container py-3">
    @if (ViewBag.Result == "add")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
    }
    <div class="form-filter mb-3">
        <form action="@Url.Action("Revenue")" method="get" class="d-flex">
            <select name="Year" class="form-select me-3 w-25" required">
                <option value="">Chọn năm</option>
                @for (int i = 2025; i <= ViewBag.Year + 1; i++)
                {
                    <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
                }
            </select>
            <select name="Month" class="form-select me-3 w-25 month-select" required>
                <option value="">Chọn tháng</option>
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
                }
            </select>
            @*@if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.CV || (Model.User.TypeUser == TypeUser.ASM && !string.IsNullOrEmpty(Model.User.ZoneIds) && Model.User.ZoneIds.Length > 2))*@
            @if (Model.Zones?.Count() > 1)
            {
                <select name="ZoneId" class="form-select me-3 w-25">
                    <option value="">Chọn vùng</option>
                    @foreach (var item in Model.Zones)
                    {
                        <option value="@item.Id" @(Model.ZoneId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
            }
            @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.CV || (Model.User.TypeUser == TypeUser.BM && !string.IsNullOrEmpty(Model.User.OfficeIds)))

            {
                <select name="OfficeId" class="form-select w-25 me-3">
                    <option>Chọn chi nhánh</option>
                    @foreach (var item in Model.Offices)
                    {
                        <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
            }
            @if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.EC || Model.User.TypeUser == TypeUser.SAB || Model.User.TypeUser == TypeUser.ALT)
            {
                <input type="hidden" value="@Model.OfficeId" name="OfficeId" />

            }
            <select name="UserType" class="form-select w-25 ms-3">
                <option value="">Tất cả chức danh</option>
                <option value="3" @(Model.UserType == 3 ? "selected" : "")>BM</option>
                <option value="4" @(Model.UserType == 4 ? "selected" : "")>EC</option>
                <option value="5" @(Model.UserType == 5 ? "selected" : "")>ATL</option>
                <option value="6" @(Model.UserType == 6 ? "selected" : "")>SAB</option>
                <option value="7" @(Model.UserType == 7 ? "selected" : "")>CM</option>
                <option value="9" @(Model.UserType == 9 ? "selected" : "")>TTL</option>

            </select>
        </form>
    </div>
    @*@if (Model.User.TypeUser == TypeUser.HO)
        {
            <a class="py-3 d-inline-block add-revenue-office" href="@Url.Action("RevenueOffice")">
                Thêm chỉ tiêu doanh số
            </a>
        }*@
    @if (Model.RevenueOffice != null)
    {

        <h2>Chỉ tiêu - kế hoạch phân bổ doanh số</h2>
        <div class="box_content mt-0 mb-5">
            <table class="list_table tablecenter table-striped listrevenue-user">
                <tbody>
                    <tr class="text-center">
                        <th colspan="3">Chỉ tiêu doanh số công ty</th>
                        <th colspan="4">Kế hoạch phân bổ doanh số</th>
                    </tr>
                    <tr class="text-center">
                        <th class="col-w90">Chỉ tiêu doanh số tuyển sinh</th>
                        <th class="col-w90">Chỉ tiêu doanh số học vụ</th>
                        <th class="col-w90">Chỉ tiêu doanh số kế toán</th>
                        <th class="col-w90">Cam kết hoàn thành doanh số</th>
                        <th class="col-w90">Phân bổ DS theo ghi danh mới</th>
                        <th class="col-w90">Phân bổ DS theo tái phí</th>
                        <th class="col-w90">Phân bổ DS theo SAB</th>
                    </tr>
                    <tr class="text-center fw-bold">
                        <td>
                            @Model.RevenueOffice.Target_TS.ToString("N0")đ
                        </td>
                        <td>
                            @Model.RevenueOffice.Target_HV.ToString("N0")đ
                        </td>
                        <td>
                            @Model.RevenueOffice.Target_SAB.ToString("N0")đ
                        </td>
                        @{
                            var revenueOffice_BM = Model.RevenueOffice_BMs.FirstOrDefault();
                        }
                        @if (revenueOffice_BM != null)
                        {
                            decimal TS_percent = Math.Round((decimal)revenueOffice_BM.TargetBM_TS / Model.RevenueOffice.Target_TS * 1000) / 10;
                            decimal New_percent = Math.Round((decimal)revenueOffice_BM.TargetBM_New / Model.RevenueOffice.Target_TS * 1000) / 10;
                            decimal SAB_percent = 100;
                            if (Model.RevenueOffice.Target_SAB > 0)
                            {
                                SAB_percent = Math.Round((decimal)revenueOffice_BM.TargetBM_SAB / Model.RevenueOffice.Target_SAB * 1000) / 10;
                            }
                            decimal HV_percent = 100;
                            if (Model.RevenueOffice.Target_HV > 0)
                            {
                                HV_percent = Math.Round((decimal)revenueOffice_BM.TargetBM_HV / Model.RevenueOffice.Target_HV * 1000) / 10;
                            }
                            <td>
                                @revenueOffice_BM.TargetBM_TS.ToString("N0")đ (@TS_percent%)
                            </td>
                            <td>
                                @revenueOffice_BM.TargetBM_New.ToString("N0")đ (@New_percent%)
                            </td>
                            <td>
                                @revenueOffice_BM.TargetBM_HV.ToString("N0")đ (@HV_percent%)
                            </td>
                            <td>
                                @revenueOffice_BM.TargetBM_SAB.ToString("N0")đ (@SAB_percent%)
                            </td>
                        }
                        else
                        {
                            for (int i = 1; i <= 4; i++)
                            {
                                <td>Chưa cập nhật</td>
                            }
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-success mb-3">
            Chưa có chỉ tiêu doanh số
        </div>
    }
    <h2>Kế hoạch phân bổ doanh số theo tuần</h2>
    <div class="box_content mt-0">
        <a href=""><i class="fa-solid fa-arrows-rotate"></i></a>
        <table class="list_table tablecenter table-striped listrevenue-user">
            <tbody>
                <tr class="text-center">
                    <th rowspan="2" class="col-w150 sticky-left">Họ tên nhân sự</th>
                    <th rowspan="2" style="max-width: 40px;">CDCM</th>
                    <th rowspan="2" class="col-w90">Ngày <br /> vào làm</th>
                    <th rowspan="2" class="col-w90">Ngày nghỉ/ <br /> điều chuyển</th>
                    <th rowspan="2" style="min-width: 90px !important">Chỉ tiêu <br /> doanh số</th>
                    <th rowspan="2" style="min-width: 100px !important">Cam kết HT <br /> doanh số <br /> (gồm dự thu cũ)</th>
                    <th rowspan="2" style="min-width: 55px !important">% HT <br /> cam kết/ <br />tháng</th>
                    @*<th rowspan="2" style="min-width: 90px !important">Chỉ tiêu DS <br /> cam kết + HT <br />thực tế</th>*@
                    <th rowspan="2">Dự thu <br /> tháng trước</th>
                    <th rowspan="2">Số tiền <br /> thực chạy</th>
                    <th rowspan="2" style="min-width: 110px !important">Số tiền <br /> thừa/ thiếu <br /> so với thực chạy</th>
                    @for (var i = 1; i <= ViewBag.WorkingWeeks; i++)
                    {
                        <th colspan="4">Tuần @i</th>
                    }

                </tr>
                <tr class="text-center">
                    @*<th style="min-width: 90px !important">Chỉ tiêu DS <br /> dự kiến <br /> hoàn thành</th>
                        <th style="min-width: 55px !important">% HT <br /> dự kiến/ <br />tháng</th>*@
                    @for (var i = 1; i <= ViewBag.WorkingWeeks; i++)
                    {
                        <th style="min-width: 90px !important">Chỉ tiêu DS <br /> dự kiến <br /> hoàn thành</th>
                        <th style="min-width: 55px !important">% HT <br /> dự kiến/ <br />tháng</th>
                        <th style="min-width: 90px !important">DS hoàn thành <br />thực tế</th>
                        <th style="min-width: 55px !important">% HT <br /> thực tế/ <br />tháng</th>
                    }
                </tr>
                @if (Model.UserItems != null)
                {
                    foreach (var revenueOffice in Model.UserItems)
                    {
                        <tr data-id="@revenueOffice.HistoryUser.Id">
                            <td class="text-start sticky-left">
                                @revenueOffice.HistoryUser.User.Fullname <br /> @revenueOffice.HistoryUser.User.MaNhanVien (@Html.DisplayFor(a => revenueOffice.HistoryUser.Status))
                            </td>
                            <td>
                                @revenueOffice.HistoryUser.CDCM
                            </td>
                            <td>
                                @Html.DisplayFor(a => revenueOffice.HistoryUser.DayStart)
                            </td>
                            <td>
                                @Html.DisplayFor(a => revenueOffice.HistoryUser.DayEnd)
                            </td>
                            @if (revenueOffice.RevenueUser_Month != null)
                            {
                                <td class="targetuser_month_HO">
                                    @revenueOffice.RevenueUser_Month.Target.ToString("N0")
                                </td>
                                var revenueUser_Month_BM = revenueOffice.RevenueUser_Month_BMs.FirstOrDefault();
                                <td>
                                    @if (revenueUser_Month_BM != null)
                                    {

                                        <div class="btnhistory-input">
                                            <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadHistoryRevenueUser_Month",  new{month = Model.Month,year = Model.Year,historyUserId = revenueOffice.HistoryUser.Id})"
                                               data-fancybox data-type="ajax" data-touch="false"><i class="fa-regular fa-files"></i></a>
                                        </div>
                                        <div class="revenue-value revenue-value-month_BM">
                                            @revenueUser_Month_BM.TargetBM.ToString("N0")
                                        </div>
                                        if (Model.User.TypeUser == TypeUser.BM && Model.Month >= DateTime.Now.Month)
                                        {
                                            <div class="btnedit-input btn-edit-month">
                                                <a title="Chỉnh sửa" href="javascript:;"><i class="fa-regular fa-pen-to-square"></i></a>
                                            </div>
                                            <input type="text" class="m-0 input-number input-noborder input-RevenueUser_Month_BMs hidden" value=" @(revenueUser_Month_BM.TargetBM.ToString("N0"))" />
                                        }
                                    }
                                    else
                                    {
                                        if (Model.User.TypeUser == TypeUser.BM && Model.Month >= DateTime.Now.Month)
                                        {
                                            <div class="revenue-value hidden revenue-value-month_BM">

                                            </div>
                                            <div class="btnedit-input btn-edit-month hidden">
                                                <a title="Chỉnh sửa" href="javascript:;"><i class="fa-regular fa-pen-to-square"></i></a>
                                            </div>
                                            <input type="text" class="m-0 input-number input-noborder input-RevenueUser_Month_BMs " />
                                        }
                                    }
                                </td>
                                <td class="percent_user_month">
                                </td>
                                <td class="col-w90 debt-lastmonth">@revenueOffice.Debt.ToString("N0")</td>
                                <td class="col-w90 real-target-month"></td>
                                <td class="difference-target"></td>
                                for (var i = 1; i <= ViewBag.WorkingWeeks; i++)
                                {
                                    var revenueUser_Week = revenueOffice.RevenueUser_Weeks.FirstOrDefault(a => (int)a.WeekNumber == i);
                                    <td class="week-target week-@i">
                                        <input class="input-weekNumber" type="hidden" name="weekNumber" value="@i" />
                                        @if (revenueUser_Week != null)
                                        {
                                            <div class="btnhistory-input">
                                                <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadHistoryRevenueUser_Week",  new{month = Model.Month,year = Model.Year,userId = revenueOffice.HistoryUser.User.Id,weekNumber = (int)revenueUser_Week.WeekNumber})"
                                                   data-fancybox data-type="ajax" data-touch="false"><i class="fa-regular fa-files"></i></a>
                                            </div>
                                            <div class="revenue-value revenue-value-week_BM">
                                                @(revenueUser_Week.TargetBM.ToString("N0"))
                                            </div>
                                            if (Model.User.TypeUser == TypeUser.BM && ViewBag.CurrentWeek <= i && Model.Month >= DateTime.Now.Month)
                                            {
                                                <div class="btnedit-input btn-edit-week">
                                                    <a title="Chỉnh sửa" href="javascript:;"><i class="fa-regular fa-pen-to-square"></i></a>
                                                </div>

                                            }
                                            <input type="text" class="m-0 input-number input-noborder input-RevenueUser_Week hidden" value=" @(revenueUser_Week.TargetBM.ToString("N0"))" />

                                        }
                                        else
                                        {
                                            if (Model.User.TypeUser == TypeUser.BM && ViewBag.CurrentWeek <= i && Model.Month >= DateTime.Now.Month && Model.Year >= DateTime.Now.Year)
                                            {
                                                <div class="revenue-value hidden revenue-value-week_BM">

                                                </div>
                                                <div class="btnedit-input hidden">
                                                    <i class="fa-regular fa-pen-to-square"></i>
                                                </div>
                                                <input type="text" class="m-0 input-number input-noborder input-RevenueUser_Week" />
                                            }
                                            else if (ViewBag.CurrentWeek > i)
                                            {
                                                <input type="hidden" class="m-0 input-number input-noborder input-RevenueUser_Week" value="0" />
                                                <div class="revenue-value revenue-value-week_BM">
                                                    0
                                                </div>

                                            }

                                        }
                                    </td>
                                    <td class="week-percent">
                                    </td>

                                    var revenueUser_Week_Real = revenueOffice.RevenueUser_Week_Reals.FirstOrDefault(a => (int)a.WeekNumber == i);
                                    <td class="week-real week-real-@i">
                                        @if (revenueUser_Week_Real != null)
                                        {
                                            @: @revenueUser_Week_Real.TargetBM.ToString("N0")
                                        }
                                    </td>
                                    <td class="week-real-percent">
                                    </td>
                                }
                            }
                            else
                            {
                                <td>
                                    Chưa cập nhật
                                </td>
                                <td>
                                </td>
                                <td>
                                </td>
                                <td>
                                </td>
                                <td>
                                </td>
                                <td>
                                </td>
                                for (var i = 1; i <= ViewBag.WorkingWeeks; i++)
                                {
                                    <td>
                                    </td>
                                    <td>
                                    </td>
                                    <td>
                                    </td>
                                    <td>
                                    </td>
                                }
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.User.TypeUser == TypeUser.BM && Model.RevenueOffice != null && (Model.Month != null && Model.Year != null && Model.OfficeId != null))
    {
        <div class="d-flex justify-content-end mt-3">
            <a class="btn quick-link" href="@Url.Action("RevenueOffice_BM", new {OfficeId = Model.OfficeId, month = Model.Month,year = Model.Year})">Cập nhật kế hoạch phân bổ doanh số</a>
        </div>
    }
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
}