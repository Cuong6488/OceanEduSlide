@using OceanEduSlide.ViewModels
@model RevenueOffice_BMViewModel
@{
    ViewBag.Title = "Cập nhật kế hoạch phân bổ doanh số";
}
@Html.Action("Header", new { name = "Kinh doanh/ Phân bổ doanh số" })
<div class="container py-3">
    @if (ViewBag.Result == "add")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Thêm mới thành công</strong></div>}
    @if (ViewBag.Result == "update")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>}
    <h2 class="">Cập nhật kế hoạch phân bổ doanh số tháng @Model.RevenueOffice.Month - @Model.RevenueOffice.Year chi nhánh @Model.OfficeName</h2>
    <a class="btn quick-link" href="@Url.Action("Revenue")"><i class="far fa-list me-1"></i> Kế hoạch phân bổ doanh số tháng @Model.RevenueOffice.Month</a>
    <div class="box_content px-5 mb-5">
        @using (Html.BeginForm())
        {
            @Html.ValidationSummary(true)
            <table class="form_table">
                <tbody>
                    @Html.HiddenFor(model => model.RevenueOffice.OfficeId)
                    @Html.HiddenFor(model => model.RevenueOffice.Month)
                    @Html.HiddenFor(model => model.RevenueOffice.Year)

                    <tr>
                        <td class="form-name w-25">@Html.LabelFor(model => model.TargetBM_TS)</td>
                        <td class="form_text">
                            @Html.EditorFor(model => model.TargetBM_TS)
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name w-25">@Html.LabelFor(model => model.TargetBM_HV)</td>
                        <td class="form_text">
                            @Html.EditorFor(model => model.TargetBM_HV)
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name w-25">@Html.LabelFor(model => model.TargetBM_SAB)</td>
                        <td class="form_text">
                            @Html.EditorFor(model => model.TargetBM_SAB)
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name w-25">@Html.LabelFor(model => model.TargetBM_New)</td>
                        <td class="form_text">
                            @Html.EditorFor(model => model.TargetBM_New)
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name">@Html.LabelFor(model => model.RevenueOffice.Active)</td>
                        <td class="form_text">
                            @Html.CheckBoxFor(model => model.RevenueOffice.Active, new { @checked = "checked" })
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name"></td>
                        <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Cập nhật"></td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
    <script>

        $("form").on("submit", function (e) {
            e.preventDefault();
            if ($(this).valid()) {
                var targetBM_TS = parseInt($("#TargetBM_TS").val().replace(/\,/g, ""));
                var targetBM_HV = parseInt($("#TargetBM_HV").val().replace(/\,/g, ""));
                var targetBM_SAB = parseInt($("#TargetBM_SAB").val().replace(/\,/g, ""));
                var targetBM_New = parseInt($("#TargetBM_New").val().replace(/\,/g, ""));
                if (targetBM_TS === (targetBM_HV + targetBM_SAB + targetBM_New)) {
                    $(this).off("submit").submit()

                }
                else {
                    alert("Cam kết hoàn thành doanh số phải bằng tổng các phân bổ doanh số");
                }

            }
        });
    </script>
}
