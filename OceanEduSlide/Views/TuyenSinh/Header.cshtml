@using OceanEduSlide.Models
@model User
<div class="header d-flex">
    <div class="logo">
        <a href="/">
            <img src="~/Content/images/logo-index.png" alt="Ocean Edu" />
        </a>
    </div>
    <div class="navbar-container">
        <ul class="navbar ul-reset d-flex">

            <li>
                <a href="@Url.Action("Revenue","TuyenSinh")">PHÂN BỔ DOANH SỐ</a>
            </li>
            <li>
                <a href="@Url.Action("Index","Event")">SỰ KIỆN</a>
            </li>
            <li>
                <a href="@Url.Action("ListDebt","Event")">CÔNG NỢ</a>
            </li>
            <li>
                @if (Model.TypeUser == TypeUser.BM || Model.TypeUser == TypeUser.ASM)
                {
                    <a href="@Url.Action("Propose","Proposal")">ĐỀ XUẤT</a>
                }
                else if (Model.TypeUser == TypeUser.CV || Model.TypeUser == TypeUser.HO)
                {
                    <a href="@Url.Action("ListProposal","Proposal")">ĐỀ XUẤT</a>
                }
            </li>
            <li>
                <a class="change-password" href="javascript:;"><i class="fa-solid fa-key"></i></a>
            </li>
            <li>
                <a href="@Url.Action("Logout","Home")"><i class="fa-solid fa-right-from-bracket"></i></a>
            </li>
        </ul>
    </div>
</div>