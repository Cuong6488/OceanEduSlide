@model CategoryViewModel
@using OceanEduSlide.Models
@using OceanEduSlide.ViewModels
@{ 
    var lastMonth = DateTime.Now.Month - 1 == 0 ? 12 : DateTime.Now.Month - 1;
    var lastYear = lastMonth == 12 ? DateTime.Now.Year - 1 : DateTime.Now.Year;
}

<h2>Quyết định PTS theo tháng</h2>
<form id="form-category3" class="d-flex mt-3 mb-3" action="/" method="get">
    <select name="MucLuc" class="form-select me-3 w-25 mucluc">
        <option value="">Mục lục</option>
        @foreach (var item in Model.Indexs)
        {
            <option value="@item" @(item == Model.MucLuc?"selected":"")>@item</option>
        }
    </select>
    <select name="Month" class="form-select w-25 month-category">
        <option value="">Tất cả tháng</option>
        <option value="@lastMonth" @(Model.Month == lastMonth? "selected":"")>Tháng @lastMonth - @lastYear</option>
        <option value="@DateTime.Now.Month"@(Model.Month == DateTime.Now.Month && Model.Month != null? "selected":"")>Tháng @DateTime.Now.Month - @DateTime.Now.Year</option>
    </select>
</form>
<table class="list_table table-striped box_content mt-0">
    <tbody>
        <tr>
            <th>Mục lục</th>
            <th>Tháng</th>
            <th>Nhóm/ Vùng</th>
            <th>Nội dung</th>
            <th>Số QĐ</th>
            <th>Link QĐ</th>
            <th>Bảng tính/ Ghi chú</th>
        </tr>
        @foreach (var item in Model.Categories)
        {
            var QDLink = item.QDLink + "/preview";
            <tr>
                <td>@item.Index</td>
                <td>@item.Month</td>
                <td>@item.Zone</td>
                <td>@item.Content</td>
                <td>@item.QDNumber</td>
                <td>
                    <a data-fancybox
                       data-type="iframe"
                       data-src="@item.QDLink.Replace("/view", "/preview")"
                       href="javascript:;"
                       style="word-break:break-word">
                        Link
                    </a>
                </td>
                <td><a style="word-break:break-word" target="_blank" href="@item.Note">Link</a> </td>
            </tr>
        }
    </tbody>
</table>
<script>
    $("#form-category3").on("change", function (e) {

        var mucluc = $(this).find(".mucluc").val();
        var month = $(this).find(".month-category").val();
        $.get("/TuyenSinh/GetCatgory", { mucluc: mucluc, month: month }, function (data) {
            $("#category3").html(data);
        });
    });
</script>