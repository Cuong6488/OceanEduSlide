@model OceanEduSlide.ViewModels.ApproveViewModel
@{
    ViewBag.Title = "Phản hồi đề xuất";
}
<div class="container py-3">
    <h2 class="mb-3">@ViewBag.Title</h2>
    <a class="btn quick-link" href="@Url.Action("ListProposal")"><i class="far fa-list me-1"></i>Danh sách đề xuất</a>
    <div class="box_content">
        @using (Html.BeginForm("UpdateProposal", "Proposal", FormMethod.Post))
        {
            @Html.ValidationSummary(true)
        <table class="form_table">
            @Html.HiddenFor(a => a.Proposal.Id)
            @Html.HiddenFor(a => a.Notice)
            @Html.HiddenFor(a => a.ZoneId)
            @Html.HiddenFor(a => a.OfficeId)
            @Html.HiddenFor(a => a.MaDeXuat)
            @Html.HiddenFor(a => a.Type)
            @Html.HiddenFor(a => a.Fault)
            @Html.HiddenFor(a => a.EndDay)
            @Html.HiddenFor(a => a.StartDay)
            @Html.HiddenFor(a => a.CVName)
            <tr>
                <td class="form_name w-25">Mã đề xuất</td>
                <td class="form_text"> @Html.DisplayFor(model => model.Proposal.MaDeXuat)</td>
            </tr>
            <tr>
                <td class="form_name w-25">Nhân sự đề xuất</td>
                <td class="form_text"> @Html.DisplayFor(model => model.Proposal.User.Fullname)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Proposal.Office.Name)</td>
                <td class="form_text"> @Html.DisplayFor(model => model.Proposal.Office.Name)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Proposal.ProposalTypeId)</td>
                <td class="form_text">
                    @(Model.Proposal.ProposalType?.Content)
                </td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Proposal.CreateDate)</td>
                <td class="form_text"> @Html.DisplayFor(model => model.Proposal.CreateDate)</td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Proposal.Body)</td>
                <td class="form_text body-format "><div class="p-2 border">@Html.Raw(Model.Proposal.Body)</div></td>
            </tr>
            @if (Model.Proposal.Url != null)
            {
                <tr>
                    <td class="form_name w-25">@Html.LabelFor(model => model.Proposal.Url)</td>
                    <td class="form_text"> @Html.DisplayFor(model => model.Proposal.Url)</td>
                </tr>
            }
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Proposal.CVFeedBack)</td>
                <td class="form_text">
                    @Html.EditorFor(model => model.Proposal.CVFeedBack)
                </td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Proposal.TypeApprove)</td>
                <td class="form_text">
                    @Html.EnumDropDownListFor(model => model.Proposal.TypeApprove, "Chọn kết luận", new { @class = "form-select" })
                </td>
            </tr>
            <tr>
                <td class="form_name w-25">@Html.LabelFor(model => model.Proposal.TypeFaultId)</td>
                <td class="form_text">
                    @Html.DropDownListFor(model => model.Proposal.TypeFaultId, Model.SelectFault, "Chọn tổng hợp lỗi", new { @class = "form-select" })
                </td>
            </tr>
            <tr>
                <td class="form_name">@Html.LabelFor(model => model.Proposal.Note)</td>
                <td class="form_text">@Html.EditorFor(model => model.Proposal.Note)</td>
            </tr>
            <tr>
                <td class="form_name">@Html.LabelFor(model => model.Proposal.BMEdit)</td>
                <td class="form_text">@Html.EditorFor(model => model.Proposal.BMEdit)</td>
            </tr>
            @*<tr>
            <td class="form_name w-25faultnumbertext ">@Html.LabelFor(model => model.Proposal.FaultNumber)</td>
            <td class="form_text">
                @Html.EditorFor(model => model.Proposal.FaultNumber)
            </td>
        </tr>*@
            <tr>
                <td class="form_name"></td>
                <td class="form_text">
                    <input type="submit" class="btn quick-link" value="Cập nhật" />
                </td>
            </tr>
        </table>
        }
    </div>
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
    <script>
        $(function () {
            $(".input-number").maskMoney({
                precision: 0,
                thousands: ','
            });
        });
    </script>
}