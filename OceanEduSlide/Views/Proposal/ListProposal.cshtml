@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@using PagedList.Mvc
@model ProposalViewModel
@{
    ViewBag.Title = "Danh sách đề xuất";
}

<style>
    #OfficeId-error, #Month-error, #OfficeId-error {
        display: none !important;
    }

    .dexuat-body td {
        text-align: left !important;
        padding: 2px 7px !important;
    }
</style>
@*@Html.Action("Header", "TuyenSinh", new { name = "Danh sách công nợ" })*@
<div class="container py-3">
    @if (ViewBag.Result == "add")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
    }
    <div class="d-flex thead-sticky" style="background: #f1f4f6">
        <form action="@Url.Action("ListProposal")" method="get" class="d-flex form-filter mb-5" style="flex:1">
            <input class="form-control me-3 w-25" type="text" name="MaDeXuat" value="@Model.MaDeXuat" placeholder="Mã đề xuất" />
            @if (Model.Zones?.Count() > 1)
            {
                <select name="ZoneId" class="form-select me-3 w-25">
                    <option value="">Chọn vùng</option>
                    @foreach (var item in Model.Zones)
                    {
                        <option value="@item.Id" @(Model.ZoneId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
            }
            @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.CV || (Model.User.TypeUser == TypeUser.BM && !string.IsNullOrEmpty(Model.User.OfficeIds)))
            {
                <select name="OfficeId" class="form-select w-25 me-3">
                    <option>Chọn chi nhánh</option>
                    @foreach (var item in Model.Offices)
                    {
                        <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.ShortName</option>
                    }
                </select>
            }
            <select name="Type" class="form-select ms-3 me-3 w-25">
                <option value="">Loại đề xuất</option>
                @foreach (var item in Model.ProposalTypes)
                {
                    <option value="@item" @(item == Model.Type ? "selected" : "")>@item</option>
                }
            </select>
            <div class="w-25 d-flex align-items-center">
                <p class="m-0 me-2" style="width:20px"><strong>Từ:</strong></p>
                <input class="form-control me-3" style="flex:1" type="text" id="StartDay" name="StartDay" value="@Model.StartDay" autocomplete="off" />
            </div>
            <div class="w-25 d-flex align-items-center">
                <p class="m-0 me-2" style="width:20px"><strong>Đến:</strong></p>
                <input class="form-control me-3" style="flex:1" type="text" id="EndDay" name="EndDay" value="@Model.EndDay" autocomplete="off" />
            </div>
            <select name="Notice" class="form-select w-25">
                <option value="">Tình trạng</option>
                <option value="1" @(Model.Notice == 1 ? "selected" : "")>Chưa phản hồi</option>
                <option value="4" @(Model.Notice == 4 ? "selected" : "")>Đang xử lý</option>
                <option value="6" @(Model.Notice == 6 ? "selected" : "")>Phê duyệt</option>
                <option value="5" @(Model.Notice == 5 ? "selected" : "")>Không phê duyệt</option>
            </select>
            <select name="Fault" class="form-select ms-3 me-3 w-25">
                <option value="">Tổng hợp lỗi</option>
                @foreach (var item in Model.Faults)
                {
                    <option value="@item" @(item == Model.Fault ? "selected" : "")>@item</option>
                }
            </select>
        </form>
        @if (Model.User.TypeUser == TypeUser.CV)
        {
            <a class="notice" title="@(ViewBag.NoticeCount > 0 ? "Bạn có " + ViewBag.NoticeCount + " đề xuất mới cần phê duyệt" : "" )" href="@Url.Action("ListProposal", new { notice = 1 })">
                <i class="fa-solid fa-bell"></i>
                @if (ViewBag.NoticeCount > 0)
                {
                    <span>@ViewBag.NoticeCount</span>
                }

            </a>
        }
        else if (Model.User.TypeUser == TypeUser.HO)
        {
            <a class="notice" title="@(ViewBag.NoticeCount > 0 ? "Bạn có " + ViewBag.NoticeCount + " đề xuất mới cần phê duyệt" : "" )" href="@Url.Action("ListProposal", new { notice = 4 })">
                <i class="fa-solid fa-bell"></i>
                @if (ViewBag.NoticeCount > 0)
                {
                    <span>@ViewBag.NoticeCount</span>
                }

            </a>
        }
        else if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
        {
            <a class="notice" title="@(ViewBag.NoticeCount > 0 ? "Bạn có " + ViewBag.NoticeCount + " đề xuất mới được phê duyệt" : "" )" href="@Url.Action("ListProposal", new { notice = 3 })">
                <i class="fa-solid fa-bell"></i>
                @if (ViewBag.NoticeCount > 0)
                {
                    <span>@ViewBag.NoticeCount</span>
                }

            </a>
        }

    </div>
    @*@if (Model.ZoneId != null)
        {*@
    <h2>DANH SÁCH ĐỀ XUẤT</h2>
    @if (Model.User.TypeUser == TypeUser.BM)
    {
        <a class="btn quick-link" href="@Url.Action("Propose")"><i class="fal fa-plus-circle me-1"></i>Thêm mới đề xuất</a>
    }
    <a class="btn quick-link" href="@Url.Action("ExportProposal", new {Month = Model.Month,Year = Model.Year,startDay = Model.StartDay,endDay = Model.EndDay,Notice = Model.Notice,MaDeXuat = Model.MaDeXuat,Type = Model.Type, Fault = Model.Fault,ZoneId = Model.ZoneId,OfficeId = Model.OfficeId})"><i class="fa-regular fa-table me-1"></i>Xuất Excel</a>
    <div class="box_content no-scroll">
        <table class="list_table tablecenter table-striped text-center">
            <thead class="thead-sticky" style="top:81px">
                <tr>
                    <th>STT</th>
                    <th class="col-w65">
                        Mã đề xuất
                    </th>
                    @*<th class="col-w65">
                            Vùng
                        </th>*@
                    <th class="col-w90">
                        CV PTS <br /> phụ trách
                    </th>
                    <th class="col-w90">
                        Chi nhánh <br /> - Vùng
                    </th>
                    <th class="col-w90">
                        Loại đề xuất
                    </th>
                    <th class="col-w100">
                        Nhân sự
                    </th>
                    <th class="col-w65">
                        Ngày <br /> đề xuất
                    </th>
                    @*<th class="col-w100">
                            Tình trạng
                        </th>*@
                    @*<th class="col-w90">
                            Phân loại <br /> đề xuất
                        </th>*@
                    <th class="content-td">
                        Nội dung và lý do đề xuất
                    </th>
                    <th class="col-w90">
                        Hồ sơ, tài liệu <br /> minh chứng <br /> kèm theo
                    </th>
                    <th class="col-w150">
                        Phản hồi <br /> của phòng tuyển sinh <br /> - Kết luận - Tổng hợp lỗi
                    </th>
                    <th class="col-w65">
                        CN sửa <br /> hồ sơ
                    </th>
                    @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM)
                    {
                        <th></th>
                    }
                </tr>
            </thead>

            @{int stt = 0; }
            <tbody class="dexuat-body">
                @foreach (var item in Model.ProposalItems)
                {
                    stt++;
                    <tr data-id="@item.Proposal.Id">
                        <td>
                            @stt
                        </td>
                        <td style="word-break:break-word">@item.Proposal.MaDeXuat</td>
                        @*<td>@item.Proposal.Zone.Name</td>*@
                        <td>
                            @{
                                var listCVPhuTrach = "";
                                foreach (var cv in item.ListCVPhuTrach)
                                {
                                    listCVPhuTrach += cv + ", ";
                                }
                                listCVPhuTrach = listCVPhuTrach.Trim().Trim(',');
                            }
                            @*@item.Proposal.CVName*@
                            @listCVPhuTrach
                        </td>
                        <td>@item.Proposal.Office.ShortName - @item.Proposal.Zone.Name</td>
                        <td>@(item.Proposal.ProposalType?.Content)</td>
                        <td>
                            <strong>Đề xuất:</strong> <br />
                            @(item.Proposal.User.Fullname) <br />

                            @if (item.Proposal.User2 != null)
                            {
                                @: <br />
                                <strong>Theo dõi:</strong> <br />
                                @(item.Proposal.User2?.Fullname)
                            }
                        </td>
                        <td>@Html.DisplayFor(a => item.Proposal.CreateDate)</td>
                        @*<td>
                                @(item.Proposal.CVSeen == true?"Đã phản hồi":"Chưa phản hồi")
                            </td>*@
                        @*<td>@Html.DisplayFor(a => item.Proposal.TypeProposal)</td>*@

                        <td class="body-format body-dexuat">@Html.Raw(item.Proposal.Body)</td>
                        <td style="word-break:break-word">
                            @if (!string.IsNullOrEmpty(item.Proposal.Url))
                            {
                                <a target="_blank" href="@item.Proposal.Url">Link</a>
                            }
                            @if (item.Proposal.BMEdit && item.Proposal.CVSeen && (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM))
                            {
                                @: <br /> <br /> <a href="@Url.Action("EditProposal", new {pId = item.Proposal.Id})">Sửa</a>
                            }
                        </td>
                        <td>
                            <div class="body-format">
                                @Html.Raw(item.Proposal.CVFeedBack)
                            </div>
                            <br />
                            @if (item.Proposal.TypeApprove != null)
                            {
                                var classColor = "";
                                switch (item.Proposal.TypeApprove)
                                {
                                    case TypeApprove.Type1:
                                        classColor = "pheduyet";
                                        break;
                                    case TypeApprove.Type2:
                                        classColor = "kpheduyet";
                                        break;
                                    case TypeApprove.Type3:
                                        classColor = "dangxl";
                                        break;
                                    default:
                                        break;
                                }
                                @: <strong>Kết luận: <span class="@classColor">@Html.DisplayFor(a => item.Proposal.TypeApprove)</span></strong>
                            }
                            @if (item.Proposal.TypeFault?.Content != null)
                            {
                                @: <br /> <br /> <strong>Tổng hợp lỗi:</strong> @(item.Proposal.TypeFault?.Content)
                                if (item.Proposal.Note != null)
                                {
                                    @: <br /> Note: @item.Proposal.Note
                                }
                            }
                            @if (item.Proposal.CVFbName != null)
                            {
                                <br /> <br />
                                @: <strong>Người phản hồi:</strong> <br />
                                @item.Proposal.CVFbName
                            }
                        </td>
                        @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.HO)
                        {
                            <td class="text-center">@Html.EditorFor(a => item.Proposal.BMEdit)</td>
                        }
                        else
                        {
                            <td class="text-center">@Html.DisplayFor(a => item.Proposal.BMEdit)</td>
                        }
                        @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM)
                        {
                            <td>
                                @if ((Model.User.TypeUser == TypeUser.CV && Model.User.ZoneIds.Contains("," + item.Proposal.Zone.ShortCode + ",")) || Model.User.TypeUser == TypeUser.HO)
                                {
                                    <a href="@Url.Action("UpdateProposal", new {pId = item.Proposal.Id,Page = Model.Page, ZoneId = Model.ZoneId, OfficeId = Model.OfficeId, StartDay = Model.StartDay, EndDay = Model.EndDay, Notice = Model.Notice, MaDeXuat = Model.MaDeXuat, Type = Model.Type, Fault = Model.Fault})">Phản hồi</a>
                                }
                                else
                                {
                                    if (item.Proposal.CVSeen == false)
                                    {
                                        <a href="@Url.Action("EditProposal", new {pId = item.Proposal.Id})">Sửa</a> <br /> <br />
                                        <a href="javascript:;" onclick="deleteProposal('@item.Proposal.Id')" style="color: red;">Xóa</a>
                                    }

                                    else if (Model.Notice == 3)
                                    {
                                        <a class="btn-read" href="javascript:;">Đánh dấu đã xem</a>
                                    }
                                }
                            </td>
                        }
                    </tr>

                }

            </tbody>
        </table>
        @*@if (Model.Proposals.PageCount > 1)
            {


                <div class="text-center">
                    @if (Model.OfficeId != null)
                    {
                        @Html.PagedListPager(Model.Proposals, page => Url.Action("ListProposal", new { page, zoneId = Model.ZoneId, month = Model.Month, year = Model.Year, officeId = Model.OfficeId, Notice = Model.Notice, MaDeXuat = Model.MaDeXuat, Type = Model.Type }))

                    }
                    else
                    {
                        @Html.PagedListPager(Model.Proposals, page => Url.Action("ListProposal", new { page, zoneId = Model.ZoneId, month = Model.Month, year = Model.Year, Notice = Model.Notice, MaDeXuat = Model.MaDeXuat, Type = Model.Type }))

                    }
                </div>
            }*@
    </div>
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
    <script>

        $(".btn-read").on("click", function () {
            var id = $(this).closest("tr").data("id");
            var thisElement = $(this);
            $.post("/Proposal/UpdateSeen", { id: id }, function (data) {
                if (data.status) {
                    $.toast({
                        heading: 'Cập nhật thành công',
                        icon: 'success'
                    })
                    thisElement.css("display", "none");
                } else {
                    $.toast({
                        heading: 'Cập nhật thất bại',
                        icon: 'error'
                    })
                }
            });
        });
        function deleteProposal(id) {
            if (confirm("Bạn có chắc chắn xóa đề xuất này không?")) {
                $.post("/Proposal/DeleteProposal",
                    { proposalId: id },
                    function (data) {
                        if (data === "True") {
                            $.toast({
                                text: 'Xóa đề xuất thành công',
                                position: 'bottom-right',
                                icon: 'success',
                            })
                            $("tr[data-id='" + id + "']").fadeOut();
                        } else {
                            $.toast({
                                text: 'Quá trình thực hiện không thành công. Hãy thử lại',
                                icon: 'error',
                            })
                        }
                    });
            }
        }
        $("input[name='item.Proposal.BMEdit']").on('change', function () {
            const isChecked = $(this).is(':checked');
            var toast = isChecked ? "Bạn chắc chắn muốn cho CN sửa/ bổ sung hồ sơ?" : "Bạn chắc chắn khóa quyền sửa hồ sơ của CN?";
            var id = $(this).closest("tr").data("id");
            if (confirm(toast)) {
                $.post("/Proposal/UpdateBMEdit", { id: id, isChecked: isChecked }, function (data) {
                    if (data.status) {
                        $.toast({
                            heading: 'Cập nhật thành công',
                            icon: 'success'
                        })
                    } else {
                        $.toast({
                            heading: 'Cập nhật thất bại',
                            icon: 'error'
                        })
                    }
                });
            }
            else {
                $(this).prop('checked', !isChecked);
            }
        });
        var today = new Date();
        $("#StartDay").datepicker({
            dateFormat: 'dd/mm/yy',
            maxDate: today,
        }).attr('readonly', 'readonly');
        $("#EndDay").datepicker({
            dateFormat: 'dd/mm/yy',
            maxDate: today,
        }).attr('readonly', 'readonly');
        autoReload(10);

    </script>
}