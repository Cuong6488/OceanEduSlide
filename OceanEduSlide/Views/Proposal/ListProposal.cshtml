@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@model ProposalViewModel
@{
    ViewBag.Title = "Danh sách đề xuất";
}

<style>
    #OfficeId-error, #Month-error, #OfficeId-error {
        display: none !important;
    }
</style>
@*@Html.Action("Header", "TuyenSinh", new { name = "Danh sách công nợ" })*@
<div class="container py-3">
    @if (ViewBag.Result == "add")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
    }
    <div class="d-flex">
        <form action="@Url.Action("ListProposal")" method="get" class="d-flex form-filter mb-5" style="flex:1">
            <select name="Year" class="form-select me-3">
                <option value="">Chọn năm</option>
                @for (int i = 2024; i <= DateTime.Now.Year; i++)
                {
                    <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
                }
            </select>
            <select name="Month" class="form-select me-3">
                <option value="">Chọn tháng</option>
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
                }
            </select>
            @if (Model.User.TypeUser == TypeUser.ASM)
            {
                <select name="OfficeId" class="form-select me-3">
                    <option value="">Chọn chi nhánh</option>
                    @foreach (var item in Model.Offices)
                    {
                        <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
            }
            else if (Model.User.TypeUser == TypeUser.BM)
            {
                <select name="" class="form-select me-3" disabled>
                    <option value="">Chọn chi nhánh</option>
                    @foreach (var item in Model.Offices)
                    {
                        <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
                @*<select name="Notice" class="form-select me-3">
                    <option value="">Tất cả</option>
                    <option value="2" @(Model.Notice == 2 ? "selected" : "")>BM chưa duyệt</option>
                </select>*@
                <input type="hidden" value="@Model.OfficeId" name="OfficeId" />
            }
            else if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.HO)
            {
                <select name="ZoneId" class="form-select me-3" @*data-item="zone"*@>
                    <option value="">Chọn vùng</option>
                    @foreach (var item in Model.Zones)
                    {
                        <option value="@item.Id" @(Model.ZoneId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
                <select name="OfficeId" class="form-select me-3" @*data-item="office"*@>
                    <option value="">Chọn chi nhánh</option>
                    @foreach (var item in Model.Offices)
                    {
                        <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
                <select name="Notice" class="form-select me-3">
                    <option value="">Tất cả</option>
                    <option value="1" @(Model.Notice == 1 ? "selected" : "")>Chưa phê duyệt</option>
                </select>
            }
        </form>
        @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.HO)
        {
            <a class="notice" title="@(ViewBag.NoticeCount > 0 ? "Bạn có " + ViewBag.NoticeCount + " đề xuất mới cần phê duyệt" : "" )" href="@Url.Action("ListProposal", new { notice = 1 })">
                <i class="fa-solid fa-bell"></i>
                @if (ViewBag.NoticeCount > 0)
                {
                    <span>@ViewBag.NoticeCount</span>
                }

            </a>
        }
        else if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
        {
            <a class="notice" title="@(ViewBag.NoticeCount > 0 ? "Bạn có " + ViewBag.NoticeCount + " đề xuất mới được phê duyệt" : "" )" href="@Url.Action("ListProposal", new { notice = 3 })">
                <i class="fa-solid fa-bell"></i>
                @if (ViewBag.NoticeCount > 0)
                {
                    <span>@ViewBag.NoticeCount</span>
                }

            </a>
        }

    </div>
    @*@if (Model.ZoneId != null)
        {*@
    <h2>DANH SÁCH ĐỀ XUẤT</h2>
    <div class="box_content mt-0">
        @*<a href=""><i class="fa-solid fa-arrows-rotate"></i></a>*@
        <table class="list_table tablecenter table-striped text-center">
            <tbody>
                <tr>
                    <th>STT</th>
                    <th class="col-w65">
                        Vùng
                    </th>
                    <th class="col-w90">
                        CV PTS <br /> phụ trách
                    </th>
                    <th class="col-w90">
                        Chi nhánh
                    </th>
                    <th class="col-w90">
                        Nhân sự <br /> đề xuất
                    </th>
                    <th class="col-w90">
                        Ngày đề xuất
                    </th>
                    @*<th class="col-w90">
                            Phân loại <br /> đề xuất
                        </th>*@
                    <th class="col-w200">
                        Nội dung và lý do đề xuất
                    </th>
                    <th class="col-w90">
                        Hồ sơ, <br /> tài liệu <br />minh chứng <br />kèm theo
                    </th>
                    <th class="col-w200">
                        Phản hồi của phòng tuyển sinh
                    </th>
                    <th class="col-w90">
                        Kết luận
                    </th>
                    <th class="col-w90">
                        Tổng hợp lỗi
                    </th>
                    @*<th class="col-w90">
                        BM Duyệt
                    </th>*@
                    @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM)
                    {
                        <th></th>
                    }
                </tr>
                @{int stt = 1; }
                @foreach (var item in Model.Proposals)
                {
                    <tr data-id="@item.Id">
                        <td>@stt</td>
                        <td>@item.Zone.Name</td>
                        <td>@item.CVName</td>
                        <td>@item.Office.Name</td>
                        <td>@item.User.Fullname</td>
                        <td>@Html.DisplayFor(a => item.CreateDate)</td>
                        @*<td>@Html.DisplayFor(a => item.TypeProposal)</td>*@
                        <td>@Html.Raw(item.Body)</td>
                        <td>@item.Url</td>
                        <td>@item.CVFeedBack</td>
                        <td>@Html.DisplayFor(a => item.TypeApprove)</td>
                        <td>@(item.TypeFault?.Content)</td>
                        @*<td>@Html.DisplayFor(a => item.Active)</td>*@
                        @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM)
                        {
                            <td>
                                @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.HO)
                                {
                                    <a href="@Url.Action("UpdateProposal", new {pId = item.Id})">Phản hồi</a>
                                }
                                else
                                {
                                    if (item.CVSeen == false)
                                    {
                                        <a href="@Url.Action("EditProposal", new {pId = item.Id})">Sửa</a>
                                    }

                                    else if (Model.Notice == 3)
                                    {
                                        <a class="btn-read" href="javascript:;"> Đánh dấu đã xem</a>
                                    }
                                }
                            </td>
                        }

                    </tr>
                    stt++;
                }

            </tbody>
        </table>
    </div>
    @*}*@
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
    <script>

        $(".btn-read").on("click", function () {
            var id = $(this).closest("tr").data("id");
            var thisElement = $(this);
            $.post("/Proposal/UpdateSeen", { id: id }, function (data) {
                if (data.status) {
                    $.toast({
                        heading: 'Cập nhật thành công',
                        icon: 'success'
                    })
                    thisElement.css("display", "none");
                } else {
                    $.toast({
                        heading: 'Cập nhật thất bại',
                        icon: 'error'
                    })
                }
            });

        });
    </script>
}