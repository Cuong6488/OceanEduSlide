@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@using PagedList.Mvc
@model ProposalViewModel
@{
    ViewBag.Title = "Danh sách đề xuất";
}

<style>
    #OfficeId-error, #Month-error, #OfficeId-error {
        display: none !important;
    }

    td {
        text-align: left !important;
        padding: 2px 7px !important;
    }
</style>
@*@Html.Action("Header", "TuyenSinh", new { name = "Danh sách công nợ" })*@
<div class="container py-3">
    @if (ViewBag.Result == "add")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
    }
    <div class="d-flex">
        <form action="@Url.Action("ListProposal")" method="get" class="d-flex form-filter mb-5" style="flex:1">
            <select name="Year" class="form-select me-3 w-25">
                <option value="">Chọn năm</option>
                @for (int i = 2024; i <= DateTime.Now.Year; i++)
                {
                    <option value="@i" @(Model.Year == i ? "selected" : "")>@i</option>
                }
            </select>
            <select name="Month" class="form-select me-3 w-25">
                <option value="">Chọn tháng</option>
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
                }
            </select>
            @if (Model.Zones?.Count() > 1)
            {
                <select name="ZoneId" class="form-select me-3 w-25">
                    <option value="">Chọn vùng</option>
                    @foreach (var item in Model.Zones)
                    {
                        <option value="@item.Id" @(Model.ZoneId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
            }
            @if (Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM || Model.User.TypeUser == TypeUser.CV || (Model.User.TypeUser == TypeUser.BM && !string.IsNullOrEmpty(Model.User.OfficeIds)))
            {
                <select name="OfficeId" class="form-select w-25 me-3">
                    <option>Chọn chi nhánh</option>
                    @foreach (var item in Model.Offices)
                    {
                        <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")> @item.Name </option>
                    }
                </select>
            }
            @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.PKT)
            {
                <select name="Notice" class="form-select ms-3 w-25">
                    <option value="">Tất cả</option>
                    @if (Model.User.TypeUser == TypeUser.CV)
                    {
                        <option value="1" @(Model.Notice == 1 ? "selected" : "")>Chưa phản hồi</option>
                        <option value="2" @(Model.Notice == 2 ? "selected" : "")>Đã phản hồi</option>
                    }
                    else
                    {
                        <option value="4" @(Model.Notice == 4 ? "selected" : "")>Đang xử lý</option>
                        <option value="6" @(Model.Notice == 6 ? "selected" : "")>Phê duyệt</option>
                        <option value="5" @(Model.Notice == 5 ? "selected" : "")> Không phê duyệt</option>
                    }
                </select>
            }

            <select name="Type" class="form-select ms-3 me-3 w-25">
                <option value="">Loại đề xuất</option>
                @foreach (var item in Model.ProposalTypes)
                {
                    <option value="@item" @(item == Model.Type ? "selected" : "")>@item</option>
                }
            </select>
            <input class="form-control me-3 w-25" type="text" name="MaDeXuat" value="@Model.MaDeXuat" placeholder="Mã đề xuất" />
        </form>
        @if (Model.User.TypeUser == TypeUser.CV)
        {
            <a class="notice" title="@(ViewBag.NoticeCount > 0 ? "Bạn có " + ViewBag.NoticeCount + " đề xuất mới cần phê duyệt" : "" )" href="@Url.Action("ListProposal", new { notice = 1 })">
                <i class="fa-solid fa-bell"></i>
                @if (ViewBag.NoticeCount > 0)
                {
                    <span>@ViewBag.NoticeCount</span>
                }

            </a>
        }
        else if (Model.User.TypeUser == TypeUser.HO)
        {
            <a class="notice" title="@(ViewBag.NoticeCount > 0 ? "Bạn có " + ViewBag.NoticeCount + " đề xuất mới cần phê duyệt" : "" )" href="@Url.Action("ListProposal", new { notice = 4 })">
                <i class="fa-solid fa-bell"></i>
                @if (ViewBag.NoticeCount > 0)
                {
                    <span>@ViewBag.NoticeCount</span>
                }

            </a>
        }
        else if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
        {
            <a class="notice" title="@(ViewBag.NoticeCount > 0 ? "Bạn có " + ViewBag.NoticeCount + " đề xuất mới được phê duyệt" : "" )" href="@Url.Action("ListProposal", new { notice = 3 })">
                <i class="fa-solid fa-bell"></i>
                @if (ViewBag.NoticeCount > 0)
                {
                    <span>@ViewBag.NoticeCount</span>
                }

            </a>
        }

    </div>
    @*@if (Model.ZoneId != null)
        {*@
    <h2>DANH SÁCH ĐỀ XUẤT</h2>
    @if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.ASM)
    {
        <a class="btn quick-link" href="@Url.Action("Propose")"><i class="fal fa-plus-circle me-1"></i>Thêm mới đề xuất</a>

    }
    <div class="box_content no-scroll @(Model.User.TypeUser != TypeUser.BM && Model.User.TypeUser != TypeUser.ASM?"mt-0":"")">
        <table class="list_table tablecenter table-striped text-center">
            <thead class="thead-sticky">
                <tr>
                    <th>STT</th>
                    <th class="col-w65">
                        Mã đề xuất
                    </th>
                    @*<th class="col-w65">
                            Vùng
                        </th>*@
                    <th class="col-w90">
                        CV PTS <br /> phụ trách
                    </th>
                    <th class="col-w90">
                        Chi nhánh <br /> - Vùng
                    </th>
                    <th class="col-w90">
                        Loại đề xuất
                    </th>
                    <th class="col-w90">
                        Nhân sự <br /> đề xuất
                    </th>
                    <th class="col-w65">
                        Ngày <br /> đề xuất
                    </th>
                    <th class="col-w100">
                        Tình trạng
                    </th>
                    @*<th class="col-w90">
                            Phân loại <br /> đề xuất
                        </th>*@
                    <th class="content-td">
                        Nội dung và lý do đề xuất
                    </th>
                    <th class="col-w90">
                        Hồ sơ, tài liệu <br /> minh chứng <br /> kèm theo
                    </th>
                    <th class="col-w150">
                        Phản hồi <br /> của phòng tuyển sinh <br /> - Kết luận - Tổng hợp lỗi
                    </th>
                    @*<th class="col-w90">
                            Kết luận
                        </th>
                        <th class="col-w90">
                            Tổng hợp lỗi
                        </th>*@
                    @*<th class="col-w90">
                            BM Duyệt
                        </th>*@
                    @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM)
                    {
                        <th></th>
                    }
                </tr>
            </thead>

            @{int stt = 1 + (Model.Page - 1) * ViewBag.PageSize; }
            <tbody>
                @foreach (var item in Model.Proposals)
                {
                    <tr data-id="@item.Id">
                        <td>@stt</td>
                        <td style="word-break:break-word">@item.MaDeXuat</td>
                        @*<td>@item.Zone.Name</td>*@
                        <td>@item.CVName</td>
                        <td>@item.Office.ShortName - @item.Zone.Name</td>
                        <td>@(item.ProposalType?.Content)</td>
                        <td>@item.User.Fullname</td>
                        <td>@Html.DisplayFor(a => item.CreateDate)</td>
                        <td>
                            @(item.CVSeen == true?"Đã phản hồi":"Chưa phản hồi")
                        </td>
                        @*<td>@Html.DisplayFor(a => item.TypeProposal)</td>*@
                        <td>@Html.Raw(item.Body)</td>
                        <td style="word-break:break-word">@item.Url</td>
                        <td>
                            @item.CVFeedBack <br /> <br />
                            @if (item.TypeApprove != null)
                            {
                                @: <strong>Kết luận:</strong> @Html.DisplayFor(a => item.TypeApprove) <br /> <br />
                            }
                            @if (item.TypeFault?.Content != null)
                            {
                                @: <strong>Tổng hợp lỗi:</strong> @(item.TypeFault?.Content)
                            }
                        </td>
                        @*<td>@Html.DisplayFor(a => item.TypeApprove)</td>
                            <td>@(item.TypeFault?.Content)</td>*@
                        @*<td>@Html.DisplayFor(a => item.Active)</td>*@
                        @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.HO || Model.User.TypeUser == TypeUser.ASM)
                        {
                            <td>
                                @if (Model.User.TypeUser == TypeUser.CV || Model.User.TypeUser == TypeUser.HO)
                                {
                                    <a href="@Url.Action("UpdateProposal", new {pId = item.Id,notice = Model.Notice})">Phản hồi</a>
                                }
                                else
                                {
                                    if (item.CVSeen == false)
                                    {
                                        <a href="@Url.Action("EditProposal", new {pId = item.Id})">Sửa</a>
                                    }

                                    else if (Model.Notice == 3)
                                    {
                                        <a class="btn-read" href="javascript:;"> Đánh dấu đã xem</a>
                                    }
                                }
                            </td>
                        }
                    </tr>
                    stt++;
                }

            </tbody>
        </table>
        @if (Model.Proposals.PageCount > 1)
        {


            <div class="text-center">
                @if (Model.OfficeId != null)
                {
                    @Html.PagedListPager(Model.Proposals, page => Url.Action("ListProposal", new { page, zoneId = Model.ZoneId, month = Model.Month, year = Model.Year, officeId = Model.OfficeId, Notice = Model.Notice, MaDeXuat = Model.MaDeXuat, Type = Model.Type }))

                }
                else
                {
                    @Html.PagedListPager(Model.Proposals, page => Url.Action("ListProposal", new { page, zoneId = Model.ZoneId, month = Model.Month, year = Model.Year, Notice = Model.Notice, MaDeXuat = Model.MaDeXuat, Type = Model.Type }))

                }
            </div>
        }
    </div>
    @*<a href=""><i class="fa-solid fa-arrows-rotate"></i></a>*@

    @*}*@
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
    <script>

        $(".btn-read").on("click", function () {
            var id = $(this).closest("tr").data("id");
            var thisElement = $(this);
            $.post("/Proposal/UpdateSeen", { id: id }, function (data) {
                if (data.status) {
                    $.toast({
                        heading: 'Cập nhật thành công',
                        icon: 'success'
                    })
                    thisElement.css("display", "none");
                } else {
                    $.toast({
                        heading: 'Cập nhật thất bại',
                        icon: 'error'
                    })
                }
            });

        });
    </script>
}