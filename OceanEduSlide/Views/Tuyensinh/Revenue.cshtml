@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@model RevenueViewModel
<style>
    #OfficeId-error, #Month-error, #OfficeId-error {
        display: none !important;
    }
    .list_table tr th, .list_table tr td{
        padding:3px;
    }
    .box_content{
        overflow:auto;
    }
</style>
<div class="logo-title">
    <div class="container">
        <div class="d-flex justify-content-between align-content-center align-items-center px-lg-5 py-3">
            <a href="@Url.Action("Index","TuyenSinh")">
                <img src="~/Content/images/logo-index.png" />
            </a>
            <p class="m-0">Kinh doanh/ Phân bổ doanh số</p>
        </div>
    </div>
</div>
<div class="container py-3">
    @if (ViewBag.Result == "add")
    {
        <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
    }
    <div class="form-filter">
        <form action="@Url.Action("Revenue")" method="get" class="d-flex">
            <select name="Year" class="form-select w-25 me-3" required onchange="formfilter_submit()">
                <option value="">Chọn năm</option>
                @for (int i = 2025; i <= 2030; i++)
                {
                    <option value="@i" @(ViewBag.Year == i ? "selected" : "")>@i</option>
                }
            </select>
            <select name="Month" class="form-select w-25 me-3" required>
                <option value="">Chọn tháng</option>
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" @(Model.Month == i ? "selected" : "")>Tháng @i</option>
                }
            </select>
            <select name="OfficeId" class="form-select w-25" required>
                <option value="">Chọn chi nhánh</option>
                @foreach (var item in Model.Offices)
                {
                    <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.Name</option>
                }
            </select>
            @*@Html.DropDownListFor(model => model.OfficeId, Model.SelectOffices, "Chọn chi nhánh", new { @class = "form-select w-25" })*@
        </form>
    </div>
    @if (Model.User.TypeUser == TypeUser.HO)
    {
        <a class="py-3 d-inline-block add-revenue-office" href="@Url.Action("RevenueOffice")">
            Thêm chỉ tiêu doanh số
        </a>
    }
    <div class="fw-bold mb-1">
        Chỉ tiêu doanh số
    </div>
    @if (Model.RevenueOffice != null)
    {
        <div class="revenue-office d-lg-flex mb-3">
            <div class="mb-2 mb-lg-0 me-4">
                Chỉ tiêu doanh số tuyển sinh: <span>@Model.RevenueOffice.Target_TS.ToString("N0")đ</span>
            </div>
            <div class="mb-2 mb-lg-0 me-4">
                Chỉ tiêu doanh số học vụ: <span>@Model.RevenueOffice.Target_HV.ToString("N0")đ</span>
            </div>
            <div>
                Chỉ tiêu doanh số kế toán: <span>@Model.RevenueOffice.Target_SAB.ToString("N0")đ</span>
            </div>
        </div>
        <div class="fw-bold mb-1">
            Kế hoạch phân bổ doanh số
        </div>
        var revenueOffice_BM = Model.RevenueOffice_BMs.FirstOrDefault();

        if (revenueOffice_BM != null)
        {
            decimal TS_percent = Math.Round((decimal)revenueOffice_BM.TargetBM_TS / Model.RevenueOffice.Target_TS * 1000) / 10;
            decimal New_percent = Math.Round((decimal)revenueOffice_BM.TargetBM_New / revenueOffice_BM.TargetBM_TS * 1000) / 10;
            decimal SAB_percent = Math.Round((decimal)revenueOffice_BM.TargetBM_SAB / Model.RevenueOffice.Target_SAB * 1000) / 10;
            decimal HV_percent = Math.Round((decimal)revenueOffice_BM.TargetBM_HV / Model.RevenueOffice.Target_HV * 1000) / 10;
            <div class="revenue-office d-lg-flex mb-3">
                <div class="mb-2 mb-lg-0 me-4">
                    Cam kết hoàn thành doanh số: <span>@revenueOffice_BM.TargetBM_TS.ToString("N0")đ (@TS_percent%)</span>
                </div>
                <div class="mb-2 mb-lg-0 me-4">
                    Phân bổ DS theo ghi danh mới: <span>@revenueOffice_BM.TargetBM_New.ToString("N0")đ (@New_percent%)</span>
                </div>
                <div class="mb-2 mb-lg-0 me-4">
                    Phân bổ DS theo tái phí: <span>@revenueOffice_BM.TargetBM_HV.ToString("N0")đ (@HV_percent%)</span>
                </div>
                <div class="mb-2 mb-lg-0 me-4">
                    Phân bổ DS theo SAB: <span>@revenueOffice_BM.TargetBM_SAB.ToString("N0")đ (@SAB_percent%)</span>
                </div>

                <div class="btnhistory-input">
                    <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadHistoryRevenueOffice",  new{month = Model.Month,year = Model.Year,officeId = Model.OfficeId})"
                       data-fancybox data-type="ajax" data-touch="false"><i class="fa-regular fa-files"></i></a>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success mb-3">
                Chưa cập nhật kế hoạch phân bổ doanh số
            </div>
        }
    }
    else
    {
        <div class="alert alert-success mb-3">
            Chưa có chỉ tiêu doanh số
        </div>
    }


    <div class="box_content mt-0">
        <table class="list_table tablecenter table-striped listrevenue-user">
            <tbody>
                <tr class="text-center">
                    <th rowspan="2" style="width: 120px">Họ tên nhân sự</th>
                    <th rowspan="2" style="width: 40px">Chức vụ</th>
                    <th rowspan="2" style="width: 90px">Chỉ tiêu doanh số</th>
                    <th colspan="2">Tháng</th>
                    @for (var i = 1; i <= ViewBag.WorkingWeeks; i++)
                    {
                        <th colspan="2">Tuần @i</th>
                    }

                </tr>
                <tr class="text-center">
                    <th style="min-width: 90px !important">Chỉ tiêu DS dự kiến hoàn thành</th>
                    <th style="min-width: 65px !important">% HT dự kiến/ tháng</th>
                    <th style="min-width: 90px !important ">Chỉ tiêu DS dự kiến hoàn thành</th>
                    <th style="min-width: 65px !important">% HT dự kiến/ tháng</th>
                    <th style="min-width: 90px !important ">Chỉ tiêu DS dự kiến hoàn thành</th>
                    <th style="min-width: 65px !important">% HT dự kiến/ tháng</th>
                    <th style="min-width: 90px !important">Chỉ tiêu DS dự kiến hoàn thành</th>
                    <th style="min-width: 65px !important">% HT dự kiến/ tháng</th>
                    <th style="min-width: 90px !important">Chỉ tiêu DS dự kiến hoàn thành</th>
                    <th style="min-width: 65px !important">% HT dự kiến/ tháng</th>
                    <th style="min-width: 90px !important">Chỉ tiêu DS dự kiến hoàn thành</th>
                    <th style="min-width: 65px !important">% HT dự kiến/ tháng</th>
                </tr>
                @if (Model.UserItems != null)
                {

                    foreach (var revenueOffice in Model.UserItems)
                    {
                        <tr data-id="@revenueOffice.User.Id">
                            <td>
                                @revenueOffice.User.Username
                            </td>
                            <td>
                                @revenueOffice.User.TypeUser
                            </td>
                            <td class="targetuser_month_HO">
                                @if (revenueOffice.RevenueUser_Month != null)
                                {
                                    @:@revenueOffice.RevenueUser_Month.Target.ToString("N0")
                                }
                                else
                                {
                                    @:Chưa cập nhật
                                }
                            </td>
                            <td>
                                @if (revenueOffice.RevenueUser_Month_BMs.Any())
                                {

                                    <div class="btnhistory-input">
                                        <a href="" data-src="@Url.Action("LoadHistoryRevenueUser_Month",  new{month = Model.Month,year = Model.Year,userId = revenueOffice.User.Id})"
                                           data-fancybox data-type="ajax" data-touch="false"><i class="fa-regular fa-files"></i></a>
                                    </div>
                                    <div class="revenue-value">
                                        @(revenueOffice.RevenueUser_Month_BMs.First().TargetBM.ToString("N0"))
                                    </div>
                                    <div class="btnedit-input">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </div>
                                    <input type="text" class="m-0 input-number input-noborder input-RevenueUser_Month_BMs hidden" value=" @(revenueOffice.RevenueUser_Month_BMs.First().TargetBM.ToString("N0"))" />
                                }
                                else
                                {
                                    <div class="revenue-value hidden">

                                    </div>
                                    <div class="btnedit-input hidden">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </div>
                                    <input type="text" class="m-0 input-number input-noborder input-RevenueUser_Month_BMs" />
                                }
                            </td>
                            <td class="percent_user_month">
                            </td>
                            <td class="week-target week1">

                            </td>
                            <td class="week-percent">

                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.User.TypeUser == TypeUser.BM || Model.User.TypeUser == TypeUser.HO && Model.RevenueOffice != null && (Model.Month != null && Model.Year != null && Model.OfficeId != null))
    {
        <div class="d-flex justify-content-end mt-3">
            <a class="btn quick-link" href="@Url.Action("RevenueOffice_BM", new {officeId = Model.OfficeId, month = Model.Month,year = Model.Year})">Cập nhật kế hoạch phân bổ doanh số</a>
        </div>
    }
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
}