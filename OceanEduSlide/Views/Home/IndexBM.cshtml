@{
    ViewBag.Title = "Trang chủ";
}
@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@model BMHomeViewModel
<style>

    #OfficeId-error {
        display: none !important;
    }
</style>
@*<div class="banner">
        <img src="~/Content/images/banner-index.png" alt="banner">
    </div>*@
<div class="change-password-form">
    <form action="/" method="post">
        <h2><strong>Đổi mật khẩu</strong></h2>
        <label><strong>Mật khẩu cũ</strong></label>
        <input class="form-control mb-2" type="password" name="oldpassword" value="" required />
        <label><strong>Mật khẩu mới</strong></label>
        <input class="form-control mb-2" type="password" name="newpassword" value="" required />
        <label><strong>Xác nhận mật khẩu</strong></label>
        @*<div class="mb-4">*@
        <input class="form-control mb-4" type="password" name="confirmpassword" value="" required />
        @*<span>
                    Mật khẩu không chính xác
                </span>
            </div>*@
        <button type="submit"><strong>Xác nhận</strong></button>
    </form>
    <div class="close-form">
        <i class="fa-solid fa-rectangle-xmark"></i>
    </div>
</div>
<div class="remind-page">
    <div class="container">
        @if (Model.User.TypeUser == TypeUser.ASM)
        {
            <form action="@Url.Action("Index")" method="get" class="d-flex form-filter mb-3">

                <select name="OfficeId" class="form-select" required>
                    <option value="">Chọn chi nhánh</option>
                    @foreach (var item in Model.Offices)
                    {
                        <option value="@item.Id" @(Model.OfficeId == item.Id ? "selected" : "")>@item.Name</option>
                    }
                </select>
            </form>
        }
        <div class="remind-date mb-3 remind-date-bm">
            Ngày @DateTime.Now.ToString("dd/MM/yyyy")
        </div>
        <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 g-3">
            @if (Model.UserItems != null)
            {
                foreach (var userItem in Model.UserItems)
                {
                    <div class="col">
                        <div class="box-remind">
                            <div class="remind-date">
                                Nhân sự @(userItem.User.Fullname??userItem.User.Username)
                            </div>
                            <div class="remind-works">
                                <div class="mb-3">
                                    <p class="mb-2"><strong>1. Chi tiết công việc ngày</strong></p>
                                    @foreach (var item in userItem.Revenues)
                                    {
                                        <div class="mb-2 p-2" style="background: #dbd9d9 ">
                                            @if (item.Event?.Name != null)
                                            {<div class="d-flex">
                                                    <p class="mb-2 me-3 text-danger">@(item.Event?.Name)</p>
                                                    <a title="Xem chi tiết" href="" data-src="@Url.Action("LoadEvent",  new{evId = item.Event.Id})"
                                                       data-fancybox data-type="ajax" data-touch="false"><i class="fa-solid fa-eye"></i></a>
                                                </div>
                                            }
                                            @if (item.DataQuantity != null)
                                            {
                                                @: SL data cần khai thác: <strong>@Html.DisplayFor(a => item.DataQuantity)</strong> <br />
                                            }
                                            @if (item.Confirm1 != null)
                                            {
                                                @: SL KH confirm lần thứ nhất: <strong>@Html.DisplayFor(a => item.Confirm1)</strong> <br />
                                            }
                                            @if (item.Confirm2 != null)
                                            {
                                                @: SL KH confirm lần thứ 2: <strong>@Html.DisplayFor(a => item.Confirm2)</strong> <br />
                                            }
                                            @if (item.CI != null)
                                            {
                                                @:  SL KH check in dự kiến: <strong>@Html.DisplayFor(a => item.CI)</strong><br />
                                            }
                                            @if (item.DT != null)
                                            {
                                                @:  SL KH chuyển đổi số: <strong>@Html.DisplayFor(a => item.DT)</strong><br />
                                            }
                                            @if (item.TargetBM != null)
                                            {
                                                @: Chỉ tiêu doanh số dự kiến hoàn thành: <strong>@Html.DisplayFor(a => item.TargetBM)</strong> <br />
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="mb-3">
                                    <p class="mb-2"><strong>2. Công nợ phải thu</strong></p>
                                    @if (userItem.Debts.Any())
                                    {
                                        foreach (var item in userItem.Debts)
                                        {
                                            <div class="mb-2 p-2" style="background: #dbd9d9 ">
                                                <div class="d-flex">
                                                    <p class="mb-2 me-3 text-danger">Loại cọc: @Html.DisplayFor(a => item.TypeDebt)</p>
                                                    <a title="Xem chi tiết" href="" data-src="@Url.Action("LoadDebt",  new{debtId = item.Id})"
                                                       data-fancybox data-type="ajax" data-touch="false"><i class="fa-solid fa-eye"></i></a>
                                                </div>
                                                Thành tiền:  @Html.DisplayFor(a => item.TotalMoney)<br />
                                                Tiền cọc giữ chỗ: @Html.DisplayFor(a => item.DebtMoney) <br />
                                                Tiền cọc bổ sung làm hồ sơ: @Html.DisplayFor(a => item.DebtMoney2) <br />
                                                Tiền còn lại phải thanh toán: <strong>@Html.DisplayFor(a => item.RemainMoney)</strong>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert alert-success">
                                            Không có
                                        </div>
                                    }

                                </div>
                                <div class="mb-3">
                                    <p class="mb-2"><strong>3. Doanh số trong tháng</strong></p>
                                    <div class="p-2" style="background: #dbd9d9 ">
                                        <p class="mb-2 text-danger">Tổng chỉ tiêu: <strong>@userItem.TMonth.ToString("N0")đ</strong></p>
                                        Hoàn thành:  <strong>@userItem.RevenueMonthNow.ToString("N0")đ</strong><br />
                                        % Hoàn thành:  <strong>@userItem.TargetMonthPercent.ToString("N0")%</strong><br />
                                        % Dự thu:  <strong>@userItem.RemainPercent.ToString("N0")%</strong><br />
                                        @if (userItem.RevenueMonthNow > userItem.TMonth)
                                        {
                                            @: Tình trạng : Vượt chỉ tiêu
                                        }
                                        else if (userItem.RevenueMonthNow == userItem.TMonth)
                                        {
                                            @: Tình trạng : Đạt chỉ tiêu
                                        }
                                        else
                                        {
                                            @: Tình trạng: Thiếu <strong>@((userItem.TMonth - userItem.RevenueMonthNow).ToString("N0"))đ</strong>
                                        }

                                    </div>
                                </div>
                                <div class="mb-3">
                                    <p class="mb-2"><strong>4. Doanh số trong tuần @ViewBag.CurrentWeek</strong></p>
                                    <div class="p-2" style="background: #dbd9d9 ">
                                        <p class="mb-2 text-danger">Chỉ tiêu tuần: <strong>@userItem.TWeek.ToString("N0")đ</strong></p>
                                        Hoàn thành:  <strong>@userItem.RevenueWeekNow.ToString("N0")đ</strong><br />
                                        % Hoàn thành:  <strong>@userItem.TargetWeekPercent.ToString("N0")%</strong><br />
                                        @if (userItem.RevenueWeekNow > userItem.TWeek)
                                        {
                                            @: Tình trạng : Vượt chỉ tiêu
                                        }
                                        else if (userItem.RevenueWeekNow == userItem.TWeek)
                                        {
                                            @: Tình trạng : Đạt chỉ tiêu
                                        }
                                        else
                                        {
                                            @: Tình trạng: Thiếu <strong>@((userItem.TWeek - userItem.RevenueWeekNow).ToString("N0"))đ</strong>
                                        }

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }


        </div>
    </div>
</div>
