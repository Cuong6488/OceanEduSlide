        @for (int i = 1; i <= 5; i++)
        {
            <a href="javascript:;">
                <picture>
                    <source srcset="~/Content/images/banner-index.png?w=600" media="(max-width: 600px)" />
                    <img src="~/Content/images/banner-index.png?w=1900" alt="banner">
                </picture>
            </a>
