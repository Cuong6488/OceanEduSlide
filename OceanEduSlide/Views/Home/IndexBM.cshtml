@section scripts
{
    @*<script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>*@
    <script>
        var today = new Date();
        $(".date-picker").datepicker({
            dateFormat: "dd/mm/yy",
            yearRange: "1900:2100",
            //maxDate: today,
        });
    </script>

