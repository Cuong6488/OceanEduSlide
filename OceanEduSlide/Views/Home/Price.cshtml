@{
    ViewBag.Title = "Học phí";
}

<div class="price-advice slide" style="min-height:100vh;height:unset">
    <div class="price-advice-box me-4">
        <div class="price-advice-box-title">
            <img class="d-block m-auto w-50" src="~/Content/images/price-title.png" />
            <img src="~/Content/images/price-before.png" />
        </div>

        <div class="price-advice-box-container">
            <div class="input-container input-container-cth">
                <div>
                    Chương trình học
                </div>
                <select class="form-select">
                    <option value="value"></option>
                    <option value="value">text</option>
                </select>
            </div>
            <div class="input-container input-container-level">
                <div>
                    Cấp độ học
                </div>
                <select class="form-select">
                    <option value="value"></option>
                    <option value="value">text</option>
                    <option value="value">text</option>
                </select>
            </div>
            <div class="input-container input-container-pathway">
                <div>
                    Lộ trình
                </div>
                <select class="form-select">
                    <option value="value"></option>
                    <option value="value">text</option>
                </select>
            </div>
            <div class="input-container">
                <div>
                    Thời gian bắt đầu
                </div>
                <input type="text" name="name" value="" class="form-control datepicker" />
            </div>
            <div class="input-container">
                <div>
                    Thời gian kết thúc
                </div>
                <input type="text" name="name" value="" class="form-control" readonly />
            </div>
            <div class="input-container input-container-unitprice">
                <div>
                    Đơn giá
                </div>
                <input type="text" name="name" value="" class="form-control" readonly />
            </div>
            <div class="input-container input-container-totalprice">
                <div>
                    Thành tiền
                </div>
                <input type="text" name="name" value="" class="form-control" readonly />
            </div>
            <div class="input-container input-container-qdsale">
                <div>
                    QĐ ưu đãi
                </div>
                <select class="form-select">
                    <option value="value"></option>
                    <option value="value">text</option>
                    <option value="value">text</option>
                </select>
            </div>
            <div class="input-container input-container-moneyprice">
                <div>
                    Số tiền ưu đãi
                </div>
                <input type="text" name="name" value="" class="form-control" readonly />
            </div>
            <div class="input-container input-container-giftprice">
                <div>
                    Quà tặng
                </div>
                <input type="text" name="name" value="" class="form-control" readonly />
            </div>
            <div class="input-container input-container-finalprice">
                <div>
                    Học phí sau ưu đãi
                </div>
                <input type="text" name="name" value="" class="form-control" readonly />
            </div>
            <div class="input-container input-container-paymethod">
                <div>
                    Hình thức thanh toán
                </div>
                <select class="form-select">
                    <option value="value"></option>
                    <option value="value">text</option>
                    <option value="value">text</option>
                </select>
            </div>
            <div class="input-container input-container-paychanel">
                <div>
                    Kênh trả góp
                </div>
                <select class="form-select">
                    <option value="value"></option>
                    <option value="value">text</option>
                    <option value="value">text</option>
                </select>
            </div>
            <div class="input-container input-container-prepay">
                <div>
                    Thanh toán trả trước
                </div>
                <input type="text" name="name" value="" class="form-control" />
            </div>
            <div class="input-container input-container-postpaid">
                <div>
                    Thanh toán trả sau
                </div>
                <input type="text" name="name" value="" class="form-control" readonly />
            </div>
            <div class="input-container input-container-term">
