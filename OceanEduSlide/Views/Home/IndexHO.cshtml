@model OceanEduSlide.Models.Banner

@{
    ViewBag.Title = "Trang chủ";
}

<div class="banner">
    @if (Model != null)
    {
        <img src="@Path.Combine("/images/banners/",Model.Image)?w=1900" alt="banner">
    }
    else
    {
        <img src="~/Content/images/banner-index.png" alt="banner">
    }
</div>
@section scripts
    {
    <script>
        /*homeJs();*/
        $(".logo a").on("click", function (e) {
            e.preventDefault();
            window.location.href = "/home/indexshare";
        });
    </script>
}