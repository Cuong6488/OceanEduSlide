@using OceanEduSlide.ViewModels
@model ReportViewModel
@{
    ViewBag.Title = "Báo cáo công việc trong ngày";
}
@*@Html.Action("Header", new { name = "Kinh doanh/ Phân bổ doanh số" })*@
<div class="container py-3">
    <h2 class="">Báo cáo công việc ngày @DateTime.Now.ToString("dd/MM/yyyy")</h2>
    <a class="btn quick-link" href="@Url.Action("Index")"><i class="far fa-list me-1"></i>Trang chủ</a>
    <div class="box_content px-5 mb-5">
        @using (Html.BeginForm())
        {
            @Html.ValidationSummary(true)
            <table class="form_table">
                <tbody>
                    @Html.HiddenFor(model => model.Report.Id)
                    @Html.HiddenFor(model => model.Report.UserId)
                    @Html.HiddenFor(model => model.Report.Month)
                    @Html.HiddenFor(model => model.Report.Year)
                    @Html.HiddenFor(model => model.Report.WeekNumber)
                    @Html.HiddenFor(model => model.Report.DayofWeek)

                    <tr>
                        <td class="form-name w-25">@Html.LabelFor(model => model.TargetBM)</td>
                        <td class="form_text">
                            @Html.EditorFor(model => model.TargetBM)
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name w-25">@Html.LabelFor(model => model.DataQuantity)</td>
                        <td class="form_text">
                            @Html.EditorFor(model => model.Report.DataQuantity, new { htmlAttributes = new { @class = "w100px" } })
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name w-25">@Html.LabelFor(model => model.Confirm1)</td>
                        <td class="form_text">
                            @Html.EditorFor(model => model.Report.Confirm1, new { htmlAttributes = new { @class = "w100px" } })
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name w-25">@Html.LabelFor(model => model.Confirm2)</td>
                        <td class="form_text">
                            @Html.EditorFor(model => model.Report.Confirm2, new { htmlAttributes = new { @class = "w100px" } })
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name w-25">@Html.LabelFor(model => model.CI)</td>
                        <td class="form_text">
                            @Html.EditorFor(model => model.Report.CI, new { htmlAttributes = new { @class = "w100px" } })
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name w-25">@Html.LabelFor(model => model.DT)</td>
                        <td class="form_text">
                            @Html.EditorFor(model => model.Report.DT, new { htmlAttributes = new { @class = "w100px" } })
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name">@Html.LabelFor(model => model.Report.Active)</td>
                        <td class="form_text">
                            @Html.CheckBoxFor(model => model.Report.Active, new { @checked = "checked" })
                        </td>
                    </tr>
                    <tr>
                        <td class="form-name"></td>
                        <td class="form_text"><input class="btn quick-link w-auto" type="submit" value="Báo cáo"></td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
</div>
@section scripts{
    <script src="~/Scripts/jquery.maskMoney.min.js"></script>
