@{
    ViewBag.Title = "Trang chủ";
}
@using OceanEduSlide.ViewModels
@using OceanEduSlide.Models
@model UserHomeViewModel
<div class="remind-page">
    <div class="container">
        @if (ViewBag.Result == "add")
        {
            <div id="AlertBox" class="alert alert-success"><strong>Báo cáo thành công</strong></div>
        }
        else if (ViewBag.Result == "update")
        {
            <div id="AlertBox" class="alert alert-success"><strong>Cập nhật thành công</strong></div>
        }
        <div class="d-flex justify-content-center mt-5">
            <div class="box-remind box-remind-user">
                <div class="remind-date">
                    Ngày @DateTime.Now.ToString("dd/MM/yyyy") - Nhân sự @(Model.User.Fullname??Model.User.Username)
                </div>
                <div class="remind-works">
                    <div class="mb-3">
                        <p class="box-remind-title mb-0"><strong>1. Chi tiết công việc ngày</strong></p>
                        @if (Model.Revenues.Any())
                        {
                            foreach (var item in Model.Revenues)
                            {
                                <div class="box-remind-content">
                                    @if (item.Event?.Name != null)
                                    {
                                        <div class="d-flex">
                                            <p class="mb-2 me-3 text-danger">@(item.Event?.Name)</p>
                                            <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadEvent",  new{evId = item.Event.Id})"
                                               data-fancybox data-type="ajax" data-touch="false"><i class="fa-solid fa-eye"></i></a>
                                        </div>
                                    }
                                    @if (item.DataQuantity != null)
                                    {
                                        @: SL data cần khai thác: <strong>@Html.DisplayFor(a => item.DataQuantity)</strong> <br />
                                    }
                                    @if (item.Confirm1 != null)
                                    {
                                        @: SL KH confirm lần thứ nhất: <strong>@Html.DisplayFor(a => item.Confirm1)</strong> <br />
                                    }
                                    @if (item.Confirm2 != null)
                                    {
                                        @: SL KH confirm lần thứ 2: <strong>@Html.DisplayFor(a => item.Confirm2)</strong> <br />
                                    }
                                    @if (item.CI != null)
                                    {
                                        @:  SL KH check in dự kiến: <strong>@Html.DisplayFor(a => item.CI)</strong><br />
                                    }
                                    @if (item.DT != null)
                                    {
                                        @:  SL KH chuyển đổi số: <strong>@Html.DisplayFor(a => item.DT)</strong><br />
                                    }
                                    @if (item.TargetBM != null)
                                    {
                                        @: Chỉ tiêu doanh số dự kiến hoàn thành: <strong>@Html.DisplayFor(a => item.TargetBM)</strong> <br />
                                    }
                                </div>
                            }
                            if (Model.Revenues.Count() > 1)
                            {
                                <div class="box-remind-content">
                                    <strong>Tổng:</strong> <br />
                                    @if (Model.DataQuantity > 0)
                                    {
                                        @: SL data cần khai thác: <strong>@Html.DisplayFor(a => Model.DataQuantity)</strong> <br />
                                    }
                                    @if (Model.Confirm1 > 0)
                                    {
                                        @: SL KH confirm lần thứ nhất: <strong>@Html.DisplayFor(a => Model.Confirm1)</strong> <br />
                                    }
                                    @if (Model.Confirm2 > 0)
                                    {
                                        @: SL KH confirm lần thứ 2: <strong>@Html.DisplayFor(a => Model.Confirm2)</strong> <br />
                                    }
                                    @if (Model.CI > 0)
                                    {
                                        @:  SL KH check in dự kiến: <strong>@Html.DisplayFor(a => Model.CI)</strong><br />
                                    }
                                    @if (Model.DT > 0)
                                    {
                                        @:  SL KH chuyển đổi số: <strong>@Html.DisplayFor(a => Model.DT)</strong><br />
                                    }
                                    @if (Model.TargetBM > 0)
                                    {
                                        @: Chỉ tiêu doanh số dự kiến hoàn thành: <strong>@Html.DisplayFor(a => Model.TargetBM)</strong> <br />
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="box-remind-content">
                                Chưa có
                            </div>
                        }
                    </div>
                    <div class="mb-3">
                        <p class="box-remind-title mb-0"><strong>2. Công nợ phải thu</strong></p>
                        @if (Model.Debts.Any())
                        {
                            foreach (var item in Model.Debts)
                            {
                                <div class="box-remind-content">
                                    <div class="d-flex">
                                        <p class="mb-2 me-3 text-danger">Loại cọc: @Html.DisplayFor(a => item.TypeDebt)</p>
                                        <a title="Xem lịch sử" href="" data-src="@Url.Action("LoadDebt",  new{debtId = item.Id})"
                                           data-fancybox data-type="ajax" data-touch="false"><i class="fa-solid fa-eye"></i></a>
                                    </div>
                                    Thành tiền:  @Html.DisplayFor(a => item.TotalMoney)<br />
                                    Tiền cọc giữ chỗ: @Html.DisplayFor(a => item.DebtMoney) <br />
                                    Tiền cọc bổ sung làm hồ sơ: @Html.DisplayFor(a => item.DebtMoney2) <br />
                                    Tiền còn lại phải thanh toán: <strong>@Html.DisplayFor(a => item.RemainMoney)</strong>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="box-remind-content">
                                Không có
                            </div>
                        }
                    </div>
                    <div class="mb-3">
                        <p class="box-remind-title mb-0"><strong>3. Doanh số trong tháng</strong></p>
                        <div class="box-remind-content">
                            <p class="mb-2 text-danger">Tổng chỉ tiêu: <strong>@(Math.Max(Model.TMonth,0).ToString("N0"))đ</strong></p>
                            Hoàn thành:  <strong>@Model.RevenueMonthNow.ToString("N0")đ</strong><br />
                            % Hoàn thành:  <strong>@Model.TargetMonthPercent.ToString("N0")%</strong><br />
                            % Dự thu:  <strong>@Model.RemainPercent.ToString("N0")%</strong><br />
                            @if (Model.RevenueMonthNow > Model.TMonth)
                            {
                                @: Tình trạng : Vượt chỉ tiêu
                            }
                            else if (Model.RevenueMonthNow == Model.TMonth)
                            {
                                @: Tình trạng : Đạt chỉ tiêu
                            }
                            else
                            {
                                @: Tình trạng: Thiếu <strong>@((Model.TMonth - Model.RevenueMonthNow).ToString("N0"))đ</strong>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <p class="box-remind-title mb-0"><strong>3. Doanh số trong tuần @ViewBag.CurrentWeek</strong></p>
                        <div class="box-remind-content">
                            <p class="mb-2 text-danger">Chỉ tiêu tuần: <strong>@Model.TWeek.ToString("N0")đ</strong></p>
                            Hoàn thành:  <strong>@Model.RevenueWeekNow.ToString("N0")đ</strong><br />
                            % Hoàn thành:  <strong>@Model.TargetWeekPercent.ToString("N0")%</strong><br />
                            @if (Model.RevenueWeekNow > Model.TWeek)
                            {
                                @: Tình trạng : Vượt chỉ tiêu
                            }
                            else if (Model.RevenueWeekNow == Model.TWeek)
                            {
                                @: Tình trạng : Đạt chỉ tiêu
                            }
                            else
                            {
                                @: Tình trạng: Thiếu <strong>@((Model.TWeek - Model.RevenueWeekNow).ToString("N0"))đ</strong>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-center mt-3">
            <a class="btn quick-link" href="@Url.Action("Report")">Báo cáo công việc ngày</a>
        </div>
    </div>
</div>


