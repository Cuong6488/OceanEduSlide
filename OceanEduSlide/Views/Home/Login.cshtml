@model OceanEduSlide.ViewModels.UserLoginModel
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LayoutAccount.cshtml";
}
<div class="first-login">
    <div class="logo-slogan">
        <div>
            <img src="~/Content/images/logo.png" alt="Ocean Edu" data-aos="fade-down" data-aos-delay="0" />
            <div class="slogan" data-aos="fade-up" data-aos-delay="400">
                HỆ THỐNG ANH NGỮ QUỐC TẾ
            </div>
        </div>
    </div>
    <div class="login-box">
        <a class="btn-login" href="javascript:;">
            <img src="~/Content/images/login-btn-bg.png" alt="Login" />
        </a>
    </div>
</div>
<div class="second-login hidden">
    <div class="login-form">
        <div>
            <img class="title-img" src="~/Content/images/login-title.png" />

            @using (Html.BeginForm())
            {
                @Html.ValidationSummary(true)
                @Html.AntiForgeryToken()
                <div class="input-container">
                    <span>Id:</span>
                    @Html.TextBoxFor(model => model.Username, new { @class = "form-control", @placeholder = "Email hoặc số điện thoại" })
                    @Html.ValidationMessageFor(model => model.Username)
                </div>
                <div class="input-container">
                    <span>Pass:</span>
                    @Html.PasswordFor(model => model.Password, new { @class = "form-control", @placeholder = "Mật khẩu" })
                    @Html.ValidationMessageFor(model => model.Password)
                </div>

                
                <div class="d-flex align-items-center justify-content-center mt-xl-5 mt-4">
                    <a class=" p-2 me-4" style="width:20px;height:20px" href="javascript:;"></a>
                    <button class="btn-login mt-0" type="submit">
                        <img src="~/Content/images/login-btn-bg.png" />
                    </button>
                    <a class="faceId-btn p-2 ms-4" style="font-size:30px" href="javascript:;"><i class="fa-solid fa-face-viewfinder"></i></a>
                </div>
               
            }
        </div>
    </div>
    <div class="login-footer">

    </div>
    <div class="logo-anchor">
        <img src="~/Content/images/logo.png" />
    </div>
</div>
@section Scripts {
    <script>
        login();
    </script>
    <script>
        $(".faceId-btn").on("click", function () {
            loginFaceId();
        });
        async function loginFaceId() {
            const email = $("[name=Username]").val();
            if (email !== "") {
                const resp = await fetch('/FaceId/BeginLogin?email=' + email);
                const data = await resp.json();
                const publicKey = preformatGetAssertReq(data);

                console.log(publicKey);
                const assertion = await navigator.credentials.get({ publicKey });
                const response = formatGetAssertResp(assertion);
                const rs = await fetch('/FaceId/CompleteLogin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(response)
                });
                const rsData = await rs.json();
                if (rsData.status === "ok") {
                    //alert("Đăng nhập FaceID thành công!");
                    window.location.href = rsData.redirectUrl;
                }
                else if (rsData.status === "error") {
                    alert(rsData.message);
                }
                else {
                    alert("Đăng nhập FaceID thất bại!");
                }
            }
            else {
                alert("Vui lòng nhập Id");
            }
        }
    </script>
}