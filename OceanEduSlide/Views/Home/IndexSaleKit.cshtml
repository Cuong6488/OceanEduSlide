                    </li>
                    <li>
                        <a href="~/Content/images/librarycefr.png" data-fancybox data-type="image" data-touch="false" data-caption="Bảng lộ trình CEFR">
                            Bảng lộ trình CEFR
                        </a>
                    </li>
                    <li>
                        <a href="https://docs.google.com/spreadsheets/d/1VM977JTQRakH--iYJUgF8uJm6KGBcG54qoT1UYjj94s/edit?copiedFromTrash=&gid=1669476886#gid=1669476886">Bảng lộ trình học Ocean Edu</a>

                    </li>
                    <li>
                        <a href="https://docs.google.com/document/d/1OCrJUjZrqv9KOAlRUgkGVRCFecAARkMacyOYpf8hWl0/edit?copiedFromTrash&tab=t.0">Du học</a>
                    </li>
                    <li>
                        <a href="https://docs.google.com/spreadsheets/d/1Ur9Uf-pCikakngTG0OEnEspTazMF4IX0dqGM0Qz-WlA/edit?copiedFromTrash=&gid=1936300083#gid=1936300083">Xét tuyển trường CLC</a>
                    </li>
                    <li>
                        <a href="@Url.Action("Articles")">Tin tức</a>
                    </li>
