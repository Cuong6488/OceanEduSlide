<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<targets>
		<!-- Định nghĩa nơi log sẽ được ghi ra -->
		<target name="logfile" xsi:type="File" fileName="logs/app-log.txt" layout="${longdate} ${level} ${message} ${exception}" />
		<target name="logconsole" xsi:type="Console" layout="${longdate} ${level} ${message} ${exception}" />
	</targets>

	<rules>
		<!-- Cấu hình mức độ log và target -->
		<logger name="*" minlevel="Info" writeTo="logfile,logconsole" />
	</rules>
</nlog>